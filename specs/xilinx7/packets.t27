// SPDX-License-Identifier: Apache-2.0
; packets.t27 -- the 7-series configuration packet stream, as one spec.
; A `.bit` file after its ASCII header is a sequence of big-endian 32-bit words: a sync word,
; then packets. This spec owns the grammar of those packets, the configuration registers they
; address, the frame address layout, and the running CRC the device checks. Drivers only read
; words and print; every rule a driver applies is a function below.
; ----
; SOURCE (prjxray c9f02d857, cited per section below):
;   lib/xilinx/configuration_packet.cc:101-167      packet header decode
;   lib/include/prjxray/xilinx/configuration_register.h:61-83   Series7 register numbers
;   lib/include/prjxray/xilinx/xc7series/command.h:18-36         CMD register values
;   lib/xilinx/xc7series/frame_address.cc:20-29     FAR layout
;   lib/include/prjxray/xilinx/xc7series/crc.h:15-43            icap_crc
;   tools/bits2rbt/configuration_packets.cc:156-172 CRC restarts after the RCRC command
; ORACLE: the CRC tests below use a value Vivado wrote, not one this spec computed.
; ----
; Meant to replace, in cli/tri/src/fpga.rs, the hand-written packet walker in `patch_cor0`
; (which leaves the CRC stale, see `crc_after`) and the packet walk and COR0 decode that
; `bit_config` gets from scripts/dump_bit_config.py. Not yet the CTL0 / COR1 field names:
; they need a cited source first.
; ----
; Driver: bitwalk.rs beside this file. It only reads files and prints:
;   t27c gen-rust specs/xilinx7/packets.t27 > specs/xilinx7/packets.rs
;   rustc -O --edition 2021 specs/xilinx7/bitwalk.rs -o specs/xilinx7/bitwalk

module xilinx7_packets;

// ============================================================================
// Words that are not packets.
// ============================================================================

pub const SYNC : u32 = 0xAA995566;
pub const DUMMY : u32 = 0xFFFFFFFF;
pub const BUS_WIDTH_SYNC : u32 = 0x000000BB;
pub const BUS_WIDTH_DETECT : u32 = 0x11220044;

// A Type-1 header with opcode NOP, register 0 and no payload. Pads every command.
pub const NOOP : u32 = 0x20000000;

// ============================================================================
// Header: [31:29] type, [28:27] opcode.
// Type 1: [26:13] register, [10:0] word count.
// Type 2: [26:0] word count; the register is the one the previous Type-1 named.
// (configuration_packet.cc:101-167)
// ============================================================================

pub const TYPE_NONE : u32 = 0;
pub const TYPE1 : u32 = 1;
pub const TYPE2 : u32 = 2;

pub const OP_NOP : u32 = 0;
pub const OP_READ : u32 = 1;
pub const OP_WRITE : u32 = 2;

pub fn header_type(w: u32) u32 {
    return w >> 29;
}

pub fn opcode(w: u32) u32 {
    return (w >> 27) & 3;
}

pub fn t1_reg(w: u32) u32 {
    return (w >> 13) & 0x3FFF;
}

pub fn t1_count(w: u32) u32 {
    return w & 0x7FF;
}

pub fn t2_count(w: u32) u32 {
    return w & 0x7FFFFFF;
}

pub fn is_header(w: u32) bool {
    const t = header_type(w);
    return t == TYPE1 or t == TYPE2;
}

// Payload words that follow this header. Any other word between packets is padding.
pub fn count_of(w: u32) u32 {
    const t = header_type(w);
    if (t == TYPE1) {
        return t1_count(w);
    }
    if (t == TYPE2) {
        return t2_count(w);
    }
    return 0;
}

// The register a payload word lands in, after header `w`. Type 2 keeps the previous one.
pub fn reg_after(prev: u32, w: u32) u32 {
    const t1 = header_type(w) == TYPE1;
    if (t1) {
        return t1_reg(w);
    }
    return prev;
}

pub fn op_after(prev: u32, w: u32) u32 {
    if (is_header(w)) {
        return opcode(w);
    }
    return prev;
}

// Payload words still owed. `left` is the count before this word.
pub fn left_after(left: u32, w: u32) u32 {
    if (left > 0) {
        return left - 1;
    }
    return count_of(w);
}

pub fn type1(op: u32, reg: u32, count: u32) u32 {
    return (TYPE1 << 29) | ((op & 3) << 27) | ((reg & 0x3FFF) << 13) | (count & 0x7FF);
}

pub fn type2(op: u32, count: u32) u32 {
    return (TYPE2 << 29) | ((op & 3) << 27) | (count & 0x7FFFFFF);
}

// ============================================================================
// Series7 configuration registers (configuration_register.h:61-83).
// ============================================================================

pub const REG_CRC : u32 = 0x00;
pub const REG_FAR : u32 = 0x01;
pub const REG_FDRI : u32 = 0x02;
pub const REG_FDRO : u32 = 0x03;
pub const REG_CMD : u32 = 0x04;
pub const REG_CTL0 : u32 = 0x05;
pub const REG_MASK : u32 = 0x06;
pub const REG_STAT : u32 = 0x07;
pub const REG_LOUT : u32 = 0x08;
pub const REG_COR0 : u32 = 0x09;
pub const REG_MFWR : u32 = 0x0A;
pub const REG_CBC : u32 = 0x0B;
pub const REG_IDCODE : u32 = 0x0C;
pub const REG_AXSS : u32 = 0x0D;
pub const REG_COR1 : u32 = 0x0E;
pub const REG_WBSTAR : u32 = 0x10;
pub const REG_TIMER : u32 = 0x11;
pub const REG_UNKNOWN : u32 = 0x13;
pub const REG_BOOTSTS : u32 = 0x16;
pub const REG_CTL1 : u32 = 0x18;
pub const REG_BSPI : u32 = 0x1F;

// ============================================================================
// CMD register values (xc7series/command.h:18-36).
// ============================================================================

pub const CMD_NULL : u32 = 0x00;
pub const CMD_WCFG : u32 = 0x01;
pub const CMD_MFW : u32 = 0x02;
pub const CMD_LFRM : u32 = 0x03;
pub const CMD_RCFG : u32 = 0x04;
pub const CMD_START : u32 = 0x05;
pub const CMD_RCAP : u32 = 0x06;
pub const CMD_RCRC : u32 = 0x07;
pub const CMD_AGHIGH : u32 = 0x08;
pub const CMD_SWITCH : u32 = 0x09;
pub const CMD_GRESTORE : u32 = 0x0A;
pub const CMD_SHUTDOWN : u32 = 0x0B;
pub const CMD_GCAPTURE : u32 = 0x0C;
pub const CMD_DESYNC : u32 = 0x0D;
pub const CMD_IPROG : u32 = 0x0F;
pub const CMD_CRCC : u32 = 0x10;
pub const CMD_LTIMER : u32 = 0x11;
pub const CMD_BSPI_READ : u32 = 0x12;
pub const CMD_FALL_EDGE : u32 = 0x13;

// ============================================================================
// Frame address register (frame_address.cc:20-49):
//   [25:23] block type, [22] bottom half, [21:17] row, [16:7] column, [6:0] minor.
// ============================================================================

pub const BLOCK_CLB_IO_CLK : u32 = 0;
pub const BLOCK_BLOCK_RAM : u32 = 1;
pub const BLOCK_CFG_CLB : u32 = 2;

pub const WORDS_PER_FRAME : u32 = 101;

pub fn far(block: u32, bottom: u32, row: u32, column: u32, minor: u32) u32 {
    return ((block & 7) << 23) | ((bottom & 1) << 22) | ((row & 0x1F) << 17) | ((column & 0x3FF) << 7) | (minor & 0x7F);
}

pub fn far_block(a: u32) u32 {
    return (a >> 23) & 7;
}

pub fn far_bottom(a: u32) u32 {
    return (a >> 22) & 1;
}

pub fn far_row(a: u32) u32 {
    return (a >> 17) & 0x1F;
}

pub fn far_column(a: u32) u32 {
    return (a >> 7) & 0x3FF;
}

pub fn far_minor(a: u32) u32 {
    return a & 0x7F;
}

// FDRI carries whole frames only.
pub fn whole_frames(words: u32) bool {
    return words - (words / WORDS_PER_FRAME) * WORDS_PER_FRAME == 0;
}

// ============================================================================
// CRC (crc.h:15-43). CRC32C polynomial, fed 37 bits per written word: the 32 data bits
// LSB first, then the low 5 bits of the register address. prjxray widens to 64 bits and
// shifts the polynomial left by one; feeding the bits one at a time is the same function.
// ============================================================================

pub const CRC32C_POLY : u32 = 0x82F63B78;

pub fn crc_bit(bit: u32, crc: u32) u32 {
    const differ = ((bit ^ crc) & 1) == 1;
    if (differ) {
        return (crc >> 1) ^ CRC32C_POLY;
    }
    return crc >> 1;
}

// Feed the low n bits of x, LSB first.
pub fn crc_bits(x: u32, n: u32, prev: u32) u32 {
    var crc : u32 = prev;
    var i : u32 = 0;
    while i < n {
        crc = crc_bit(x >> i, crc);
        i = i + 1;
    }
    return crc;
}

// The definition: 32 data bits, then 5 address bits, one bit at a time. Kept as the
// reference the table form below is tested against; the walk does not call it.
pub fn crc_step(addr: u32, data: u32, prev: u32) u32 {
    return crc_bits(addr, 5, crc_bits(data, 32, prev));
}

// Table form. The CRC is linear, so feeding 8 bits b into a running value c equals
// (c >> 8) ^ T[(c ^ b) & 0xFF] with T[i] = crc_bits(i, 8, 0). The 256 entries below are
// not trusted: test crc_table_is_derived recomputes every one from crc_bit, and
// test crc_word_equals_crc_step compares the two forms over a word sweep.
// It replaces 32 of the 37 bit steps per word with 4 lookups (the walk spent ~90% of
// its time in the bitwise form).
pub const CRC32C_TABLE : [256]u32 = [
    0x00000000, 0xF26B8303, 0xE13B70F7, 0x1350F3F4, 0xC79A971F, 0x35F1141C,
    0x26A1E7E8, 0xD4CA64EB, 0x8AD958CF, 0x78B2DBCC, 0x6BE22838, 0x9989AB3B,
