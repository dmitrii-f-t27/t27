    0x32E8915C, 0xC083125F, 0x144976B4, 0xE622F5B7, 0xF5720643, 0x07198540,
    0x590AB964, 0xAB613A67, 0xB831C993, 0x4A5A4A90, 0x9E902E7B, 0x6CFBAD78,
    0x7FAB5E8C, 0x8DC0DD8F, 0xE330A81A, 0x115B2B19, 0x020BD8ED, 0xF0605BEE,
    0x24AA3F05, 0xD6C1BC06, 0xC5914FF2, 0x37FACCF1, 0x69E9F0D5, 0x9B8273D6,
    0x88D28022, 0x7AB90321, 0xAE7367CA, 0x5C18E4C9, 0x4F48173D, 0xBD23943E,
    0xF36E6F75, 0x0105EC76, 0x12551F82, 0xE03E9C81, 0x34F4F86A, 0xC69F7B69,
    0xD5CF889D, 0x27A40B9E, 0x79B737BA, 0x8BDCB4B9, 0x988C474D, 0x6AE7C44E,
    0xBE2DA0A5, 0x4C4623A6, 0x5F16D052, 0xAD7D5351
];

pub fn crc_byte(b: u32, crc: u32) u32 {
    return (crc >> 8) ^ CRC32C_TABLE[(crc ^ b) & 0xFF];
}

pub fn crc_word(addr: u32, data: u32, prev: u32) u32 {
    const c0 = crc_byte(data, prev);
    const c1 = crc_byte(data >> 8, c0);
    const c2 = crc_byte(data >> 16, c1);
    const c3 = crc_byte(data >> 24, c2);
    return crc_bits(addr, 5, c3);
}

// The running CRC after one written payload word.
//   CRC register: the device compares the word against the running value, then restarts.
//   CMD RCRC:     restarts the running value (configuration_packets.cc:156-175).
//   anything else: folded in.
// Reads are not folded in; the walker only calls this for OP_WRITE.
// Consequence: a tool that rewrites any word between an RCRC and the next CRC write --
// COR0's OSCFSEL, say -- must rewrite that CRC word too, or the device stops with CRC_ERROR.
pub fn crc_after(reg: u32, data: u32, crc: u32) u32 {
    const is_check = reg == REG_CRC;
    if (is_check) {
        return 0;
    }
    const is_reset = reg == REG_CMD and data == CMD_RCRC;
    if (is_reset) {
        return 0;
    }
    return crc_word(reg & 0x1F, data, crc);
}

pub fn crc_ok(written: u32, running: u32) bool {
    return written == running;
}

// The CRC word to write after a patch, given the running value over the original words and
// over the patched ones. A check the original passed is re-sealed; a check the original
// already failed is left failing -- a patch must not turn a broken bitstream into a good one.
pub fn resealed(written: u32, orig_running: u32, new_running: u32) u32 {
    if (crc_ok(written, orig_running)) {
        return new_running;
    }
    return written;
}

// ============================================================================
// COR0 (configuration options 0), field by field, in the order prjxray sets them
// (xc7series/configuration_options_0_value.h:55-119). OSCFSEL is the field prjxray calls
// SetCclkFrequency.
// ============================================================================

pub const COR0_FIELDS : [11]str = ["pwrdwn_stat", "done_pipe", "drive_done", "single", "oscfsel", "ssclksrc", "done_cycle", "match_cycle", "lock_cycle", "gts_cycle", "gwe_cycle"];
pub const COR0_HI : [11]u32 = [27, 25, 24, 23, 22, 16, 14, 11, 8, 5, 2];
pub const COR0_LO : [11]u32 = [27, 25, 24, 23, 17, 15, 12, 9, 6, 3, 0];

pub fn field(v: u32, hi: u32, lo: u32) u32 {
    const width = hi - lo + 1;
    if (width >= 32) {
        return v;
    }
    return (v >> lo) & ((1 << width) - 1);
}

pub const COR0_OSCFSEL_SHIFT : u32 = 17;
pub const COR0_OSCFSEL_CLEAR : u32 = 0xFF81FFFF;

pub fn cor0_oscfsel(cor0: u32) u32 {
    return (cor0 >> COR0_OSCFSEL_SHIFT) & 0x3F;
}

pub fn cor0_with_oscfsel(cor0: u32, v: u32) u32 {
    return (cor0 & COR0_OSCFSEL_CLEAR) | ((v & 0x3F) << COR0_OSCFSEL_SHIFT);
}

// ============================================================================
// Tests. Headers are words taken from real bitstreams; the CRC value is Vivado's.
// ============================================================================

test header_words_vivado_writes {
    assert type1(OP_WRITE, REG_CMD, 1) == 0x30008001;
    assert type1(OP_WRITE, REG_FDRI, 0) == 0x30004000;
    assert type1(OP_WRITE, REG_CRC, 1) == 0x30000001;
    assert type1(OP_WRITE, REG_COR0, 1) == 0x30012001;
    assert type1(OP_WRITE, REG_IDCODE, 1) == 0x30018001;
    assert type1(OP_NOP, 0, 0) == NOOP;
}

test header_decode {
    assert header_type(0x30012001) == TYPE1;
    assert opcode(0x30012001) == OP_WRITE;
    assert t1_reg(0x30012001) == REG_COR0;
    assert t1_count(0x30012001) == 1;
    assert count_of(NOOP) == 0;
    assert count_of(SYNC) == 0;
    assert is_header(SYNC) == false;
    assert is_header(DUMMY) == false;
}

// xc7a35t: 5420 frames of 101 words in one Type-2 FDRI write.
test type2_carries_the_frames {
    const w = type2(OP_WRITE, 5420 * WORDS_PER_FRAME);
    assert w == 0x50085A5C;
    assert t2_count(w) == 547420;
    assert reg_after(REG_FDRI, w) == REG_FDRI;
    assert op_after(OP_NOP, w) == OP_WRITE;
    assert whole_frames(547420) == true;
    assert whole_frames(547421) == false;
}

test left_counts_down_then_reloads {
    assert left_after(0, 0x30008001) == 1;
    assert left_after(1, CMD_RCRC) == 0;
    assert left_after(0, NOOP) == 0;
}

test far_round_trip {
    const a = far(BLOCK_BLOCK_RAM, 1, 3, 42, 127);
    assert far_block(a) == BLOCK_BLOCK_RAM;
    assert far_bottom(a) == 1;
    assert far_row(a) == 3;
    assert far_column(a) == 42;
    assert far_minor(a) == 127;
}

// Vivado, A_direct_top.bit (xc7a35tcsg324-1): after the CRC check that closes FDRI it writes
// CMD GRESTORE, CMD LFRM, CMD START, FAR 0x03BE0000, MASK 0x501, CTL0 0x501, then CRC 0xE3AD7EA5.
test crc_matches_vivado_tail {
    const c1 = crc_after(REG_CMD, CMD_GRESTORE, 0);
    const c2 = crc_after(REG_CMD, CMD_LFRM, c1);
    const c3 = crc_after(REG_CMD, CMD_START, c2);
    const c4 = crc_after(REG_FAR, 0x03BE0000, c3);
    const c5 = crc_after(REG_MASK, 0x501, c4);
    const c6 = crc_after(REG_CTL0, 0x501, c5);
    assert crc_ok(0xE3AD7EA5, c6) == true;
}

test crc_table_is_derived {
    var i : u32 = 0;
    var same : u32 = 0;
    while i < 256 {
        if (CRC32C_TABLE[i] == crc_bits(i, 8, 0)) {
            same = same + 1;
        }
        i = i + 1;
    }
    assert same == 256;
}

// 4096 (data, running value) pairs from two xorshift32 streams, with every 5-bit address in
// turn. xorshift and not an LCG: test-report compiles through Zig, where a u32 multiply
// that overflows panics instead of wrapping; shifts drop the high bits without a check.
test crc_word_equals_crc_step {
    var x : u32 = 0x12345678;
    var y : u32 = 0x9E3779B9;
    var k : u32 = 0;
    var same : u32 = 0;
    while k < 4096 {
        x = x ^ (x << 13);
        x = x ^ (x >> 17);
        x = x ^ (x << 5);
        y = y ^ (y << 13);
        y = y ^ (y >> 17);
        y = y ^ (y << 5);
        const prev = y;
        const addr = k & 0x1F;
        if (crc_word(addr, x, prev) == crc_step(addr, x, prev)) {
            same = same + 1;
        }
        k = k + 1;
    }
    assert same == 4096;
}

test crc_restarts {
    assert crc_after(REG_CMD, CMD_RCRC, 0x12345678) == 0;
    assert crc_after(REG_CRC, 0x12345678, 0x12345678) == 0;
    assert crc_step(0, 0, 0) == 0;
}

test reseal_only_what_passed {
    assert resealed(0xE3AD7EA5, 0xE3AD7EA5, 0x11111111) == 0x11111111;
    assert resealed(0xDEADBEEF, 0xE3AD7EA5, 0x11111111) == 0xDEADBEEF;
}

// Vivado's COR0 in every harness bitstream, field by field.
test cor0_fields_of_vivado_default {
    assert field(0x02003FE5, COR0_HI[1], COR0_LO[1]) == 1;
    assert field(0x02003FE5, COR0_HI[4], COR0_LO[4]) == 0;
    assert field(0x02003FE5, COR0_HI[6], COR0_LO[6]) == 3;
    assert field(0x02003FE5, COR0_HI[7], COR0_LO[7]) == 7;
    assert field(0x02003FE5, COR0_HI[8], COR0_LO[8]) == 7;
    assert field(0x02003FE5, COR0_HI[9], COR0_LO[9]) == 4;
    assert field(0x02003FE5, COR0_HI[10], COR0_LO[10]) == 5;
    assert field(0x02003FE5, 31, 0) == 0x02003FE5;
}

test cor0_oscfsel_field {
    assert cor0_oscfsel(0x02003FE5) == 0;
    assert cor0_with_oscfsel(0x02003FE5, 5) == 0x020A3FE5;
    assert cor0_oscfsel(cor0_with_oscfsel(0x02003FE5, 63)) == 63;
    assert cor0_with_oscfsel(cor0_with_oscfsel(0x02003FE5, 9), 0) == 0x02003FE5;
}
