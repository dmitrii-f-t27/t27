// SPDX-License-Identifier: Apache-2.0
; far.t27 -- which frame a configuration word lands in: the 7-series frame address (FAR), the
; order a multi-frame FDRI write walks the addresses in, and the pad frames between rows.
; A writer that puts frame data into a .bit needs exactly this; so does a reader that wants
; to say which tile a bit of a vendor bitstream belongs to.
; ----
; SOURCE (prjxray c9f02d857):
;   lib/xilinx/xc7series/frame_address.cc:20-49              FAR layout
;   lib/xilinx/xc7series/configuration_column.cc:20-31       next minor inside a column
;   lib/xilinx/xc7series/configuration_bus.cc:26-54          next column inside a row
;   lib/xilinx/xc7series/global_clock_region.cc:23-50        next row inside a half
;   lib/xilinx/xc7series/part.cc:36-70                       top half, bottom half, next block
;   lib/include/prjxray/xilinx/configuration.h:330-349       "appear to have 2 frames of
;                                                            padding between rows"
;   prjxray-db artix7/xc7a35tcsg324-1/part.json              the part table below
; ORACLE: Vivado bitstreams, not prjxray. Every FDRI write in the six xc7a35t references is
; 5420 frames, which this walk must produce from the part table; the pad frames it places
; must be empty in all of them; and every package pin a design constrains must land in
; frames that carry data, where the tile of that pin sits (tilegrid.json, from prjxray's
; fuzzers, which read Vivado's own per-frame debug bitstreams). Driver: bitwalk --pins.
; Sharper: every set bit of those six files must be a bit that some tile's segbits name
; (prjxray-db segbits_*.db; *_SING tiles through tilegrid's alias), at the frame this walk
; gives the tile. 4224/4224. A walk that forgets the pads passes the count and the pins
; and leaves 501 bits nobody names. Driver: bitwalk --bits.
; ----
; Driver: bitwalk.rs beside this file.
;   t27c gen-rust specs/xilinx7/far.t27 > specs/xilinx7/far.rs

module xilinx7_far;

// ============================================================================
// Frame address register (frame_address.cc:20-49):
//   [25:23] block type, [22] bottom half, [21:17] row, [16:7] column, [6:0] minor.
// ============================================================================

pub const BLOCK_CLB_IO_CLK : u32 = 0;
pub const BLOCK_BLOCK_RAM : u32 = 1;
pub const BLOCK_CFG_CLB : u32 = 2;

pub fn far(block: u32, bottom: u32, row: u32, column: u32, minor: u32) u32 {
    return ((block & 7) << 23) | ((bottom & 1) << 22) | ((row & 0x1F) << 17) | ((column & 0x3FF) << 7) | (minor & 0x7F);
}

pub fn far_block(a: u32) u32 {
    return (a >> 23) & 7;
}

pub fn far_bottom(a: u32) u32 {
    return (a >> 22) & 1;
}

pub fn far_row(a: u32) u32 {
    return (a >> 17) & 0x1F;
}

pub fn far_column(a: u32) u32 {
    return (a >> 7) & 0x3FF;
}

pub fn far_minor(a: u32) u32 {
    return a & 0x7F;
}

// ============================================================================
// The walk. A multi-frame FDRI write starts at the FAR last written and visits the valid
// addresses in increasing numeric order: minors of a column, columns of a row, then the next
// row (top half before bottom half, part.cc:46-53), then the next block type (part.cc:55-67).
// A row here is one (block, half, row) group -- FAR >> 17. After every group the stream
// carries ROW_PAD_FRAMES frames that belong to no address (configuration.h:335-349).
// ============================================================================

pub const ROW_PAD_FRAMES : u32 = 2;
pub const GROUP_SHIFT : u32 = 17;
pub const NO_FRAME : u32 = 0xFFFFFFFF;

pub fn far_group(a: u32) u32 {
    return a >> GROUP_SHIFT;
}

pub fn group_start(key: u32) u32 {
    return key << GROUP_SHIFT;
}

// The address after `a` inside its row, or NO_FRAME at the row's end. `col_frames` is the
// frame count of a's column, `row_cols` the number of columns in a's row.
pub fn far_next_in_row(a: u32, col_frames: u32, row_cols: u32) u32 {
    const more_minors = far_minor(a) + 1 < col_frames;
    if (more_minors) {
        return a + 1;
    }
    const more_columns = far_column(a) + 1 < row_cols;
    if (more_columns) {
        return far(far_block(a), far_bottom(a), far_row(a), far_column(a) + 1, 0);
    }
    return NO_FRAME;
}

// ============================================================================
// Part table. One entry per (block, half, row) group in walk order: its key (FAR >> 17) and
// its column count; then every column's frame count, groups concatenated.
// ============================================================================

// ---- BEGIN part table: generated by `tri x7-part`, do not edit ----
// from prjxray-db/artix7/xc7a35tcsg324-1/part.json: 6 groups, 134 columns, 5408 frames
pub const XC7A35T_GROUPS : u32 = 6;
pub const XC7A35T_GROUP_KEY : [6]u32 = [0, 1, 32, 64, 65, 96];
pub const XC7A35T_GROUP_COLS : [6]u32 = [44, 38, 44, 3, 2, 3];
pub const XC7A35T_COL_FRAMES : [134]u32 = [
    42, 30, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 36, 36, 36, 36, 30, 36, 36, 36, 36, 30, 36, 36, 36, 36, 36, 36, 28, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 30, 42,
    42, 30, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 36, 36, 36, 36, 30, 36, 36, 36, 36, 30, 36, 36, 36, 36, 36, 36, 28, 36, 36, 36, 28, 36, 36, 32,
    42, 30, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 36, 36, 36, 36, 30, 36, 36, 36, 36, 30, 36, 36, 36, 36, 36, 36, 28, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 30, 42,
    128, 128, 128,
    128, 128,
    128, 128, 128
];
// ---- END part table ----

// Index into XC7A35T_COL_FRAMES of group g's first column.
pub fn first_column(g: u32) u32 {
    var k : u32 = 0;
    var n : u32 = 0;
    while k < g {
        n = n + XC7A35T_GROUP_COLS[k];
        k = k + 1;
    }
    return n;
}

// Frames group g carries, pads excluded, counted by walking it with far_next_in_row.
pub fn group_frames(g: u32) u32 {
    const first = first_column(g);
    const cols = XC7A35T_GROUP_COLS[g];
    var a : u32 = group_start(XC7A35T_GROUP_KEY[g]);
    var n : u32 = 0;
    while a != NO_FRAME {
        n = n + 1;
        a = far_next_in_row(a, XC7A35T_COL_FRAMES[first + far_column(a)], cols);
    }
    return n;
}

// Frames of an FDRI write that starts at FAR 0 and covers the whole part, pads included.
pub fn part_fdri_frames() u32 {
    var g : u32 = 0;
    var n : u32 = 0;
    while g < XC7A35T_GROUPS {
        n = n + group_frames(g) + ROW_PAD_FRAMES;
        g = g + 1;
    }
    return n;
}

// The group holding address a, or XC7A35T_GROUPS if the part has none.
pub fn group_index(a: u32) u32 {
    var g : u32 = 0;
    while g < XC7A35T_GROUPS {
        const hit = XC7A35T_GROUP_KEY[g] == far_group(a);
        if (hit) {
            return g;
        }
        g = g + 1;
    }
    return XC7A35T_GROUPS;
}

// Position of address a in an FDRI write that starts at FAR 0, or NO_FRAME if a is not a
// valid address of the part.
pub fn fdri_index(a: u32) u32 {
    const g = group_index(a);
    const no_group = g == XC7A35T_GROUPS;
    if (no_group) {
        return NO_FRAME;
    }
    const first = first_column(g);
    const col = far_column(a);
    const no_column = col >= XC7A35T_GROUP_COLS[g];
    if (no_column) {
        return NO_FRAME;
    }
    const no_minor = far_minor(a) >= XC7A35T_COL_FRAMES[first + col];
    if (no_minor) {
        return NO_FRAME;
    }
    var n : u32 = 0;
    var k : u32 = 0;
    while k < g {
        n = n + group_frames(k) + ROW_PAD_FRAMES;
        k = k + 1;
    }
    var c : u32 = 0;
    while c < col {
        n = n + XC7A35T_COL_FRAMES[first + c];
        c = c + 1;
    }
    return n + far_minor(a);
}

// ============================================================================
// Tests
// ============================================================================

test far_round_trip {
    const a = far(BLOCK_BLOCK_RAM, 1, 3, 42, 127);
    assert far_block(a) == BLOCK_BLOCK_RAM;
    assert far_bottom(a) == 1;
    assert far_row(a) == 3;
    assert far_column(a) == 42;
    assert far_minor(a) == 127;
}

test next_steps_minor_then_column_then_stops {
    assert far_next_in_row(far(0, 0, 0, 0, 40), 42, 44) == far(0, 0, 0, 0, 41);
    assert far_next_in_row(far(0, 0, 0, 0, 41), 42, 44) == far(0, 0, 0, 1, 0);
    assert far_next_in_row(far(0, 1, 0, 43, 41), 42, 44) == NO_FRAME;
}

test groups_are_in_increasing_address_order {
    assert XC7A35T_GROUP_KEY[0] < XC7A35T_GROUP_KEY[1];
    assert XC7A35T_GROUP_KEY[1] < XC7A35T_GROUP_KEY[2];
    assert XC7A35T_GROUP_KEY[2] < XC7A35T_GROUP_KEY[3];
    assert XC7A35T_GROUP_KEY[3] < XC7A35T_GROUP_KEY[4];
    assert XC7A35T_GROUP_KEY[4] < XC7A35T_GROUP_KEY[5];
}

; Every one of the six Vivado xc7a35t bitstreams (vivado/vendor/A_direct_top.bit,
; B_idelay_top.bit, prjxray-db harness arty-a7/{swbut,uart,pmod}, basys3/swbut) writes FDRI in
; one packet of 547,420 words = 5420 frames. The part table alone sums to 5408; the walk must
; put the other 12 where Vivado put them.
test walk_covers_vivado_fdri_write {
    assert part_fdri_frames() == 5420;
}

; A_direct_top.bit constrains its clock to pin E3, which is RIOB33_X43Y75: tilegrid base
; 0x00001580 (CLB_IO_CLK, top, row 0, column 43), words 51..54. In Vivado's stream the frames
; with data in those words are 1519, 1528 and 1529 and no frame next to them -- 1528 is the
; frame frames.t27 checks its ECC on. Pin A8 is LIOB33_X0Y125: base 0x00020000 (row 1,
; column 0), words 51..54; Vivado's first frame with data there is 1534. Frames 1532 and 1533,
; between the two rows, are zero in all six files.
test vivado_pins_land_in_their_tiles {
    assert fdri_index(0x00001580) == 1490;
    assert fdri_index(0x00001580 + 29) == 1519;
    assert fdri_index(0x00001580 + 38) == 1528;
    assert fdri_index(0x00001580 + 41) == 1531;
    assert fdri_index(0x00020000) == 1534;
}

test invalid_addresses_have_no_frame {
    assert fdri_index(far(0, 0, 0, 44, 0)) == NO_FRAME;
    assert fdri_index(far(0, 0, 0, 0, 42)) == NO_FRAME;
    assert fdri_index(far(0, 1, 1, 0, 0)) == NO_FRAME;
    assert fdri_index(far(BLOCK_CFG_CLB, 0, 0, 0, 0)) == NO_FRAME;
}
