module port::flash;

pub fn usage() -> []const u8 {
    return "Usage: flash.t27 [command]
Commands:
  flash      - Flash bitstream to FPGA (default)
  list       - List connected FPGA boards
  openocd    - Flash using OpenOCD
  ofl        - Flash using openFPGALoader
  impact     - Flash using Xilinx Impact (legacy)

Environment variables:
  BITSTREAM  - Path to bitstream file (default: build/fpga/pnr/design.bit)
  CABLE      - JTAG cable name (default: auto-detect)
  BOARD      - Target board: qmtech_a100t or arty_a7 (default: qmtech_a100t)";
}

pub fn check_bitstream(bitstream_path: []const u8) -> bool {
    // In the original, this function exits with error 1 if bitstream doesn't exist
    // Here we return false to indicate failure, true for success
    return bitstream_path.len > 0; // Simplified - in real implementation would check file existence
}

