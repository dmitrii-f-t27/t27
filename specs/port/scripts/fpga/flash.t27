pub fn flash_impact() {
    // Original calls external commands: impact, creates files
    // Porting the decision, not the plumbing
}

pub fn flash_docker() {
    // Original calls external commands: docker, openocd
    // Porting the decision, not the plumbing
}

pub fn main(command: []const u8, use_docker: bool) -> []const u8 {
    // Returns the action that should be taken based on the command
    if (std.mem.eql(u8, command, "flash")) {
        if (use_docker) {
            return "flash_docker";
        } else {
            return "flash_openocd";
        }
    } else if (std.mem.eql(u8, command, "list")) {
        return "list_boards";
    } else if (std.mem.eql(u8, command, "openocd")) {
        return "flash_openocd";
    } else if (std.mem.eql(u8, command, "ofl")) {
        return "flash_openfpgaloader";
    } else if (std.mem.eql(u8, command, "impact")) {
        return "flash_impact";
    } else if (std.mem.eql(u8, command, "help") or std.mem.eql(u8, command, "--help") or std.mem.eql(u8, command, "-h")) {
        return "usage";
    } else {
        return "unknown_command";
    }
}

test usage_format {
    const help_text = usage();
    assert(help_text.len > 0);
    assert(std.mem.indexOf(u8, help_text, "Usage:") != null);
    assert(std.mem.indexOf(u8, help_text, "Commands:") != null);
    assert(std.mem.indexOf(u8, help_text, "flash") != null);
    assert(std.mem.indexOf(u8, help_text, "list") != null);
}

test check_bitstream_exists {
    assert(check_bitstream("build/fpga/pnr/design.bit") == true);
}

test check_bitstream_empty {
    assert(check_bitstream("") == false);
}

test check_bitstream_custom_path {
    assert(check_bitstream("/custom/path/to/bitstream.bit") == true);
}

test main_flash_default {
    const action = main("flash", false);
    assert(std.mem.eql(u8, action, "flash_openocd"));
}

test main_flash_docker {
    const action = main("flash", true);
    assert(std.mem.eql(u8, action, "flash_docker"));
}

test main_list_command {
    const action = main("list", false);
    assert(std.mem.eql(u8, action, "list_boards"));
}

test main_openocd_command {
    const action = main("openocd", false);
    assert(std.mem.eql(u8, action, "flash_openocd"));
}

test main_ofl_command {
    const action = main("ofl", false);
    assert(std.mem.eql(u8, action, "flash_openfpgaloader"));
}

test main_impact_command {
    const action = main("impact", false);
    assert(std.mem.eql(u8, action, "flash_impact"));
}

test main_help_commands {
    const action1 = main("help", false);
    assert(std.mem.eql(u8, action1, "usage"));
    
    const action2 = main("--help", false);
    assert(std.mem.eql(u8, action2, "usage"));
    
    const action3 = main("-h", false);
    assert(std.mem.eql(u8, action3, "usage"));
}

test main_unknown_command {
    const action = main("unknown", false);
    assert(std.mem.eql(u8, action, "unknown_command"));
}

test main_empty_command {
    const action = main("", false);
    assert(std.mem.eql(u8, action, "flash_openocd")); // default is flash
}