    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test compute_td_residual_basic_case
        given input = 1.0
        when result = compute_td_residual(input)
        then result == 1.0  // With default values: 1.0 + 0.99 * 0.0 - 0.0 = 1.0

    test compute_gae_basic_case
        given input = []f32{len: 3, fill: 1.0}
        when result = compute_gae(input)
        then result.len == 3
        then result[0] == 1.0  // With default values and zero-filled arrays

    test compute_returns_basic_case
        given input = []f32{len: 3, fill: 1.0}
        when result = compute_returns(input)
        then result.len == 3
        then result[0] == 1.0 + 0.99 * 1.0 + 0.99 * 0.99 * 1.0  // Expected return calculation

    test normalize_advantages_basic_case
        given input = []f32{len: 3, fill: 1.0}
        when result = normalize_advantages(input)
        then result.len == 3
        then result[0] == 0.0  // All identical values should normalize to 0.0 (mean = 1.0, std_dev = 0.0)

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
