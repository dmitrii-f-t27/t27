// SPDX-License-Identifier: Apache-2.0
; specs/t27os/nvidia_direct.t27 -- the direct NVIDIA route of T27 OS: integrate.api.nvidia.com (OpenAI
; protocol) with the owner's own key list, beside the OpenRouter route (nvidia/nemotron-*:free) keys.t27 has.
; Owner, 2026-10-22: "a direct NVIDIA provider in the app, and mark the model that does not work".
; Measured 2026-10-22 on the 34 keys of the Keychain item nvidia-api-keys (account dmitrii-f-t27):
;   GET /v1/models                              HTTP 200 on 34 of 34 (84 models: the platform catalogue,
;                                               not what this account may run)
;   yi-large, granite, sea-lion, jamba, deepseek-coder  HTTP 404 "Function ... not found for account"
;   nvidia/nemotron-3-ultra-550b-a55b           HTTP 200 on 34 of 34, 0.73 to 13.5 s, mean 1.81 s
;   deepseek-ai/deepseek-v4.1-flash             no answer in 70 s -> NV_DEAD_MODELS, never sent
; The key list is one Keychain item, a JSON object {"keys":["nvapi-...", ...]}; nv_parse reads it here, the
; host (nvidia_host.t27) only fetches the bytes with /usr/bin/security. Rotation: a key answered 401 or 403
; is dead and never sent again; 429 moves on to the next live key; the counters and the current key survive a
; restart as ~/.t27os/nvidia/state.t27 (nv_state_text), which holds no key, only the list's FNV-1a hash so a
; changed list starts from a clean state. Every test uses fake nvapi-test-... values.
; Why not a tenth row of the provider tables (PROVIDER_COUNT 9 -> 10): those rows hold MAX_KEYS = 8 keys each
; under the service ai.t27.os, and their count sizes the PTY server's shared key table and the window's mask
; buffer; the 34 keys of one JSON item fit neither. The provider id is P_NVIDIA = 9 in keys.t27, the same
; id the feat/t27os-key-auth-hold branch (dmitrii-f-t27/t27#6) gives its NVIDIA row.
; Refs gHashTag/t27#10782.
module T27osNvidiaDirect;

use t27os::editors::same_bytes;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::session_store::csv_field;
use t27os::keys::key_fits;
use t27os::keys::begins_with;
use t27os::keys::NV_CHAT_URL;
use t27os::keys::NV_MODEL_DEFAULT;
use t27os::keys::NV_DEAD_MODELS;
use t27os::keys::NV_KC_SERVICE;
use t27os::keys::NV_KC_ACCOUNT;
use t27os::keys::SEC_OP_READ;
use t27os::keys::sec_argv;

/// nv_parse's answer for bytes that are not the expected JSON object.
pub const NV_BAD : u32 = 4294967295;
/// nv_pick's answer when no key is live.
pub const NV_NONE : u32 = 4294967295;
/// The most keys the list may hold; more are counted as over, not taken.
pub const NV_MAX : u32 = 64;
/// The longest key taken (the measured keys are 70 bytes).
pub const NV_KEY_MAX : u32 = 128;
/// The bytes the host reads from the Keychain item (34 keys measured 2527 bytes).
pub const NV_JSON_CAP : u32 = 8192;
/// Seconds a check waits for an answer: the slowest measured 200 took 13.5 s.
pub const NV_TIMEOUT_S : u32 = 20;
/// The prefix every NVIDIA API key has.
pub const NV_PREFIX : str = "nvapi-";

/// The rotation state, u32 words: the header, then NV_STRIDE words for each key.
pub const NV_S_N : usize = 0;
pub const NV_S_CUR : usize = 1;
pub const NV_S_HASH : usize = 2;
pub const NV_HDR : usize = 4;
pub const NV_STRIDE : usize = 4;
pub const NV_K_FLAGS : usize = 0;
pub const NV_K_OK : usize = 1;
pub const NV_K_RATE : usize = 2;
pub const NV_K_AUTH : usize = 3;
pub const NV_ST_LEN : usize = 260;
pub const NV_F_DEAD : u32 = 1;
/// Counters stop here rather than wrap.
pub const NV_COUNT_CAP : u32 = 999999999;

/// What one answer does (nv_on_status).
pub const NV_A_NONE : u32 = 0;
pub const NV_A_OK : u32 = 1;
pub const NV_A_DEAD : u32 = 2;
pub const NV_A_NEXT : u32 = 3;
pub const NV_A_MODEL : u32 = 4;
pub const NV_A_NET : u32 = 5;
pub const NV_A_RETRY : u32 = 6;
pub const NV_ACTION_WORDS : str = "none,ok,key dead (401/403),rate limited (429) next key,model not deployed for this account (404),no answer,server error";

// ---- the key list --------------------------------------------------------------------------------------

fn nv_ws(c: u8) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13;
}

fn nv_skip_ws(s: []const u8, at: usize) -> usize {
    var i : usize = at;
    while (i < s.len) {
        if (nv_ws(s[i]) == false) { return i; }
        i = i + 1;
    }
    return i;
}

/// The index after the closing quote of the string that opens at s[at]; s.len + 1 when it never closes.
fn nv_str_end(s: []const u8, at: usize) -> usize {
    var i : usize = at + 1;
    while (i < s.len) {
        if (s[i] == 92) {
            i = i + 2;
        } else if (s[i] == 34) {
            return i + 1;
        } else {
            i = i + 1;
        }
    }
    return s.len + 1;
}

/// The index after the JSON value that starts at s[at] (a string, an object, an array or a scalar);
/// s.len + 1 when it is broken.
fn nv_value_end(s: []const u8, at: usize) -> usize {
    if (at >= s.len) { return s.len + 1; }
    const c : u8 = s[at];
    if (c == 34) { return nv_str_end(s, at); }
    if (c == 123 or c == 91) {
        var depth : u32 = 0;
        var i : usize = at;
        while (i < s.len) {
            const d : u8 = s[i];
            if (d == 34) {
                const e : usize = nv_str_end(s, i);
                if (e > s.len) { return s.len + 1; }
                i = e;
            } else {
                if (d == 123 or d == 91) { depth = depth + 1; }
                if (d == 125 or d == 93) {
                    depth = depth - 1;
                    if (depth == 0) { return i + 1; }
                }
                i = i + 1;
            }
        }
        return s.len + 1;
    }
    var j : usize = at;
    while (j < s.len and s[j] != 44 and s[j] != 125 and s[j] != 93 and nv_ws(s[j]) == false) {
        j = j + 1;
    }
    if (j == at) { return s.len + 1; }
    return j;
}

/// Is s[a..a+n] equal to an earlier taken key?
fn nv_seen(s: []const u8, a: usize, n: usize, offs: []const u32, lens: []const u32, count: u32) -> bool {
    var k : u32 = 0;
    while (k < count) {
        const o : usize = @as(usize, offs[k]);
        if (@as(usize, lens[k]) == n) {
            if (same_bytes(s[o .. o + n], s[a .. a + n])) { return true; }
        }
        k = k + 1;
    }
    return false;
}

/// Take the string element s[a..e] (its quotes excluded) when it is a key: spaces around it trimmed, it
/// starts with NV_PREFIX, has no escape, fits key_fits and NV_KEY_MAX, and is not a repeat. res[0] counts
/// repeats, res[1] elements that are not keys or do not fit. The new count comes back.
fn nv_take(s: []const u8, a: usize, e: usize, offs: []u32, lens: []u32, count: u32, res: []u32) -> u32 {
    var x : usize = a;
    var y : usize = e;
    while (x < y and (s[x] == 32 or s[x] == 9)) { x = x + 1; }
    while (y > x and (s[y - 1] == 32 or s[y - 1] == 9)) { y = y - 1; }
    const n : usize = y - x;
    var i : usize = x;
    while (i < y) {
        if (s[i] == 92) {
            res[1] = res[1] + 1;
            return count;
        }
        i = i + 1;
    }
    if (n <= 6 or n > @as(usize, NV_KEY_MAX) or begins_with(s[x .. y], NV_PREFIX) == false or key_fits(s[x .. y]) == false) {
        res[1] = res[1] + 1;
        return count;
    }
    if (nv_seen(s, x, n, offs, lens, count)) {
        res[0] = res[0] + 1;
        return count;
    }
    if (count >= NV_MAX or @as(usize, count) >= offs.len or @as(usize, count) >= lens.len) {
        res[1] = res[1] + 1;
        return count;
    }
    offs[count] = @as(u32, @intCast(x));
    lens[count] = @as(u32, @intCast(n));
    return count + 1;
}

/// Read the key list {"keys":["nvapi-...", ...]}: offs[k] and lens[k] give key k inside json (no copy).
/// The count of keys taken, 0 for an empty list, NV_BAD when the bytes are not one JSON object with one
/// "keys" array (broken JSON, a missing or a second "keys", trailing bytes). Other fields are skipped.
/// res (2 words) counts the repeats dropped and the elements that are not keys.
pub fn nv_parse(json: []const u8, offs: []u32, lens: []u32, res: []u32) -> u32 {
    res[0] = 0;
    res[1] = 0;
    var i : usize = nv_skip_ws(json, 0);
    if (i >= json.len or json[i] != 123) { return NV_BAD; }
    i = nv_skip_ws(json, i + 1);
    var found : bool = false;
    var count : u32 = 0;
    var more : bool = true;
    if (i < json.len and json[i] == 125) { return NV_BAD; }
    while (more) {
        if (i >= json.len or json[i] != 34) { return NV_BAD; }
        const ne : usize = nv_str_end(json, i);
        if (ne > json.len) { return NV_BAD; }
        const is_keys : bool = same_bytes(json[i + 1 .. ne - 1], "keys");
        i = nv_skip_ws(json, ne);
        if (i >= json.len or json[i] != 58) { return NV_BAD; }
        i = nv_skip_ws(json, i + 1);
        if (is_keys) {
            if (found) { return NV_BAD; }
            found = true;
            if (i >= json.len or json[i] != 91) { return NV_BAD; }
            i = nv_skip_ws(json, i + 1);
            var items : bool = true;
            if (i < json.len and json[i] == 93) { items = false; }
            while (items) {
                if (i >= json.len) { return NV_BAD; }
                const ve : usize = nv_value_end(json, i);
                if (ve > json.len) { return NV_BAD; }
                if (json[i] == 34) {
                    count = nv_take(json, i + 1, ve - 1, offs, lens, count, res);
                } else {
                    res[1] = res[1] + 1;
                }
                i = nv_skip_ws(json, ve);
                if (i >= json.len) { return NV_BAD; }
                if (json[i] == 93) {
                    items = false;
                } else if (json[i] == 44) {
                    i = nv_skip_ws(json, i + 1);
                } else {
                    return NV_BAD;
                }
            }
            i = i + 1;
        } else {
            const oe : usize = nv_value_end(json, i);
            if (oe > json.len) { return NV_BAD; }
            i = oe;
        }
        i = nv_skip_ws(json, i);
        if (i >= json.len) { return NV_BAD; }
        if (json[i] == 125) {
            more = false;
        } else if (json[i] == 44) {
            i = nv_skip_ws(json, i + 1);
        } else {
            return NV_BAD;
        }
    }
    if (nv_skip_ws(json, i + 1) < json.len) { return NV_BAD; }
    if (found == false) { return NV_BAD; }
    return count;
}

/// FNV-1a (32 bit) over the taken keys in order, a newline after each: the state file names the list by it,
/// so a changed list (a key added, removed or reordered) starts from a clean state. Not a key, not reversible.
pub fn nv_list_hash(json: []const u8, offs: []const u32, lens: []const u32, count: u32) -> u32 {
    var h : u64 = 2166136261;
    var k : u32 = 0;
    while (k < count) {
        const o : usize = @as(usize, offs[k]);
        var i : usize = 0;
        while (i < @as(usize, lens[k])) {
            h = ((h ^ @as(u64, json[o + i])) * 16777619) % 4294967296;
            i = i + 1;
        }
        h = ((h ^ 10) * 16777619) % 4294967296;
        k = k + 1;
    }
    return @as(u32, @intCast(h));
}

// ---- rotation ------------------------------------------------------------------------------------------

fn nv_at(i: u32, field: usize) -> usize {
    return NV_HDR + @as(usize, i) * NV_STRIDE + field;
}

/// A clean state for a list of n keys (n is cut at NV_MAX) named by `hash`; key 0 goes first.
pub fn nv_state_init(st: []u32, n: u32, hash: u32) -> void {
    var i : usize = 0;
    while (i < st.len) {
        st[i] = 0;
        i = i + 1;
    }
    var m : u32 = n;
    if (m > NV_MAX) { m = NV_MAX; }
    st[NV_S_N] = m;
    st[NV_S_HASH] = hash;
}

pub fn nv_dead(st: []const u32, i: u32) -> bool {
    if (i >= st[NV_S_N]) { return true; }
    return st[nv_at(i, NV_K_FLAGS)] % 2 == 1;
}

/// How many keys are not dead.
pub fn nv_live(st: []const u32) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < st[NV_S_N]) {
        if (nv_dead(st, i) == false) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// The first live key at `from` or after it, wrapping round; NV_NONE when none is live.
fn nv_live_from(st: []const u32, from: u32) -> u32 {
    const n : u32 = st[NV_S_N];
    if (n == 0) { return NV_NONE; }
    var j : u32 = 0;
    while (j < n) {
        const k : u32 = (from + j) % n;
        if (nv_dead(st, k) == false) { return k; }
        j = j + 1;
    }
    return NV_NONE;
}

/// The key the next request uses: the current one, or the first live key after it.
pub fn nv_pick(st: []const u32) -> u32 {
    return nv_live_from(st, st[NV_S_CUR]);
}

fn nv_bump(st: []u32, at: usize) -> void {
    if (st[at] < NV_COUNT_CAP) { st[at] = st[at] + 1; }
}

/// Fold the HTTP status of a request sent with key i into the state, and say what it did:
///   2xx      the key stays current                                   NV_A_OK
///   401/403  the key is dead for good, the next live key is current  NV_A_DEAD
///   429      the next live key is current (this one stays live)      NV_A_NEXT
///   404      the model is not deployed for this account; no key moves NV_A_MODEL
///   0        no answer (network, timeout); no key moves              NV_A_NET
///   other    a server error; no key moves                            NV_A_RETRY
pub fn nv_on_status(st: []u32, i: u32, code: u32) -> u32 {
    const n : u32 = st[NV_S_N];
    if (i >= n) { return NV_A_NONE; }
    if (code >= 200 and code < 300) {
        nv_bump(st, nv_at(i, NV_K_OK));
        st[NV_S_CUR] = i;
        return NV_A_OK;
    }
    if (code == 401 or code == 403) {
        st[nv_at(i, NV_K_FLAGS)] = st[nv_at(i, NV_K_FLAGS)] | NV_F_DEAD;
        nv_bump(st, nv_at(i, NV_K_AUTH));
        const nx : u32 = nv_live_from(st, (i + 1) % n);
        if (nx != NV_NONE) { st[NV_S_CUR] = nx; }
        return NV_A_DEAD;
    }
    if (code == 429) {
        nv_bump(st, nv_at(i, NV_K_RATE));
        const nr : u32 = nv_live_from(st, (i + 1) % n);
        if (nr != NV_NONE) { st[NV_S_CUR] = nr; }
        return NV_A_NEXT;
    }
    if (code == 404) { return NV_A_MODEL; }
    if (code == 0) { return NV_A_NET; }
    return NV_A_RETRY;
}

// ---- models --------------------------------------------------------------------------------------------

/// Is the model on the dead list (it never answers on this account, so it is never sent)?
pub fn nv_model_denied(model: []const u8) -> bool {
    if (model.len == 0) { return false; }
    var f : [96]u8 = undefined;
    var k : u32 = 0;
    var n : usize = csv_field(NV_DEAD_MODELS, 0, f[0..96]);
    while (n > 0) {
        if (same_bytes(f[0..n], model)) { return true; }
        k = k + 1;
        n = csv_field(NV_DEAD_MODELS, k, f[0..96]);
    }
    return false;
}

/// The model a request names: `want` unless it is empty or on the dead list, else NV_MODEL_DEFAULT.
pub fn nv_model_for(want: []const u8, out: []u8) -> usize {
    if (want.len == 0 or nv_model_denied(want)) { return put_bytes(out, 0, NV_MODEL_DEFAULT); }
    return put_bytes(out, 0, want);
}

/// The model's short name for a status line: after the last '/', up to the first dash field that is a size
/// (a digit then 'b' at its end: 550b, a55b). "nvidia/nemotron-3-ultra-550b-a55b" -> "nemotron-3-ultra".
pub fn nv_model_short(model: []const u8, out: []u8) -> usize {
    var a : usize = 0;
    var i : usize = 0;
    while (i < model.len) {
        if (model[i] == 47) { a = i + 1; }
        i = i + 1;
    }
    var end : usize = model.len;
    var fs : usize = a;
    var j : usize = a;
    var stop : bool = false;
    while (j <= model.len and stop == false) {
        if (j == model.len or model[j] == 45) {
            if (j >= fs + 2 and model[j - 1] == 98 and model[j - 2] >= 48 and model[j - 2] <= 57) {
                end = fs;
                if (end > a) { end = end - 1; }
                stop = true;
            }
            fs = j + 1;
        }
        j = j + 1;
    }
    if (end <= a) { end = model.len; }
    return put_bytes(out, 0, model[a .. end]);
}

/// The one-message body a check sends (out needs 160 bytes): one token of the model, no stream.
pub fn nv_probe_body(model: []const u8, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "{\"model\":\"");
    n = nv_model_for(model, out[n .. out.len]) + n;
    n = put_bytes(out, n, "\",\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}],\"max_tokens\":1,\"stream\":false}");
    return n;
}

// ---- the state file ------------------------------------------------------------------------------------

/// The state as text (out needs 64 + 44 per key): "nvidia-state v1 <n> <hash> <cur>" then one line per key,
/// "<flags> <ok> <rate> <auth>". No key and no part of one.
pub fn nv_state_text(st: []const u32, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "nvidia-state v1 ");
    n = put_dec(out, n, @as(u64, st[NV_S_N]));
    out[n] = 32;
    n = put_dec(out, n + 1, @as(u64, st[NV_S_HASH]));
    out[n] = 32;
    n = put_dec(out, n + 1, @as(u64, st[NV_S_CUR]));
    out[n] = 10;
    n = n + 1;
    var i : u32 = 0;
    while (i < st[NV_S_N]) {
        var f : usize = 0;
        while (f < NV_STRIDE) {
            n = put_dec(out, n, @as(u64, st[nv_at(i, f)]));
            if (f + 1 < NV_STRIDE) { out[n] = 32; } else { out[n] = 10; }
            n = n + 1;
            f = f + 1;
        }
        i = i + 1;
    }
    return n;
}

/// One decimal number at text[at] (spaces and newlines before it skipped): into v[0], the index after it;
/// text.len + 1 when there is none or it does not fit 32 bits.
fn nv_num(text: []const u8, at: usize, v: []u32) -> usize {
    var i : usize = nv_skip_ws(text, at);
    var x : u64 = 0;
    const s : usize = i;
    while (i < text.len and text[i] >= 48 and text[i] <= 57) {
        x = x * 10 + @as(u64, text[i] - 48);
        if (x > 4294967295) { return text.len + 1; }
        i = i + 1;
    }
    if (i == s) { return text.len + 1; }
    v[0] = @as(u32, @intCast(x));
    return i;
}

/// Load a saved state for the list now in the Keychain (n keys, named by hash). True when the text is a
/// whole state of that same list; otherwise st is a clean state for the list and false comes back.
pub fn nv_state_load(text: []const u8, n: u32, hash: u32, st: []u32) -> bool {
    nv_state_init(st, n, hash);
    if (begins_with(text, "nvidia-state v1 ") == false) { return false; }
    var v : [2]u32 = undefined;
    var i : usize = nv_num(text, 16, v[0..2]);
    if (i > text.len or v[0] != st[NV_S_N]) { return false; }
    i = nv_num(text, i, v[0..2]);
    if (i > text.len or v[0] != hash) { return false; }
    i = nv_num(text, i, v[0..2]);
    if (i > text.len) { return false; }
    var cur : u32 = v[0];
    var tmp : [260]u32 = undefined;
    var z : usize = 0;
    while (z < NV_ST_LEN) {
        tmp[z] = 0;
        z = z + 1;
    }
    var k : u32 = 0;
    while (k < st[NV_S_N]) {
        var f : usize = 0;
        while (f < NV_STRIDE) {
            i = nv_num(text, i, v[0..2]);
            if (i > text.len) { return false; }
            tmp[nv_at(k, f)] = v[0];
            f = f + 1;
        }
        k = k + 1;
    }
    if (cur >= st[NV_S_N]) { cur = 0; }
    var c : usize = NV_HDR;
    while (c < NV_HDR + @as(usize, st[NV_S_N]) * NV_STRIDE) {
        st[c] = tmp[c];
        c = c + 1;
    }
    st[NV_S_CUR] = cur;
    return true;
}

// ---- the Keychain argument list -------------------------------------------------------------------------

/// The login keychain under a home folder; `security` looks for it under $HOME when no keychain is named.
pub const NV_KC_LOGIN : str = "/Library/Keychains/login.keychain-db";

/// The argument words of the key list read (keys.t27 sec_argv READ for NV_KC_SERVICE / NV_KC_ACCOUNT); the count.
/// `security` finds the default keychain through $HOME, so a process started with another HOME (a test run
/// with HOME=/tmp/...) is answered 44, item not found, although the item is there. When `home` is not the
/// user's own folder `user_home` (getpwuid), word 7 names <user_home>/Library/Keychains/login.keychain-db.
/// An unknown user folder or a path that does not fit leaves the plain 7 words.
pub fn nv_kc_argv(home: []const u8, user_home: []const u8, words: []u8, offs: []u32) -> u32 {
    const argc : u32 = sec_argv(SEC_OP_READ, NV_KC_SERVICE, NV_KC_ACCOUNT, words, offs);
    if (argc != 7 or user_home.len == 0 or same_bytes(home, user_home)) { return argc; }
    const at : usize = @as(usize, offs[6]) + 3;
    if (at + user_home.len + NV_KC_LOGIN.len + 1 > words.len or offs.len < 8) { return argc; }
    offs[7] = @as(u32, @intCast(at));
    var n : usize = put_bytes(words, at, user_home);
    n = put_bytes(words, n, NV_KC_LOGIN);
    words[n] = 0;
    return 8;
}

// ---- the status line -----------------------------------------------------------------------------------

/// The KEYS panel line (out needs 80 bytes): "NVIDIA: 34 keys, 33 live, model nemotron-3-ultra"; `listed` is what
/// nv_parse said (NV_BAD: the item is not a key list). Numbers come from the state, the model from `model`.
pub fn nv_status_line(st: []const u32, listed: u32, model: []const u8, out: []u8) -> usize {
    if (listed == NV_BAD) {
        var b : usize = put_bytes(out, 0, "NVIDIA: key list unreadable (Keychain ");
        b = put_bytes(out, b, NV_KC_SERVICE);
        return put_bytes(out, b, ")");
    }
    if (st[NV_S_N] == 0) {
        var e : usize = put_bytes(out, 0, "NVIDIA: no keys (Keychain ");
        e = put_bytes(out, e, NV_KC_SERVICE);
        return put_bytes(out, e, ")");
    }
    var n : usize = put_bytes(out, 0, "NVIDIA: ");
    n = put_dec(out, n, @as(u64, st[NV_S_N]));
    if (st[NV_S_N] == 1) { n = put_bytes(out, n, " key, "); } else { n = put_bytes(out, n, " keys, "); }
    n = put_dec(out, n, @as(u64, nv_live(st)));
    n = put_bytes(out, n, " live, model ");
    var m : [96]u8 = undefined;
    const ml : usize = nv_model_for(model, m[0..96]);
    var s : [96]u8 = undefined;
    const sl : usize = nv_model_short(m[0..ml], s[0..96]);
    return put_bytes(out, n, s[0..sl]);
}

// ---- tests (fake keys only) ----------------------------------------------------------------------------

fn nv_key_is(json: []const u8, offs: []const u32, lens: []const u32, k: u32, want: []const u8) -> bool {
    const o : usize = @as(usize, offs[k]);
    return same_bytes(json[o .. o + @as(usize, lens[k])], want);
}

test an_empty_list_is_zero_keys_and_not_broken {
    var o : [64]u32 = undefined;
    var l : [64]u32 = undefined;
    var r : [2]u32 = undefined;
    assert nv_parse("{\"keys\":[]}", o[0..64], l[0..64], r[0..2]) == 0;
    assert nv_parse(" { \"keys\" : [ ] } \n", o[0..64], l[0..64], r[0..2]) == 0;
    assert r[0] == 0 and r[1] == 0;
}

test broken_json_is_bad {
    var o : [64]u32 = undefined;
    var l : [64]u32 = undefined;
    var r : [2]u32 = undefined;
    assert nv_parse("", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{}", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("[\"nvapi-test-a1\"]", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{\"keys\":[\"nvapi-test-a1\"", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{\"keys\":[\"nvapi-test-a1]}", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{\"keys\":[\"nvapi-test-a1\" \"nvapi-test-b2\"]}", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{\"keys\":[]} x", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{\"keys\":[],\"keys\":[]}", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{\"other\":1}", o[0..64], l[0..64], r[0..2]) == NV_BAD;
    assert nv_parse("{\"keys\":\"nvapi-test-a1\"}", o[0..64], l[0..64], r[0..2]) == NV_BAD;
}

test one_key_is_taken_with_its_prefix {
    var o : [64]u32 = undefined;
    var l : [64]u32 = undefined;
    var r : [2]u32 = undefined;
    const j : str = "{\"keys\":[\"nvapi-test-0001\"]}";
    assert nv_parse(j, o[0..64], l[0..64], r[0..2]) == 1;
    assert nv_key_is(j, o[0..64], l[0..64], 0, "nvapi-test-0001");
}

test keys_without_the_prefix_or_with_inner_spaces_are_not_keys {
    var o : [64]u32 = undefined;
    var l : [64]u32 = undefined;
    var r : [2]u32 = undefined;
    const j : str = "{\"keys\":[\"sk-test-1\",\"nvapi-\",\"nvapi-te st\",\"nvapi-test-a\\u0041\",7,null,\"nvapi-test-ok\"]}";
    assert nv_parse(j, o[0..64], l[0..64], r[0..2]) == 1;
    assert nv_key_is(j, o[0..64], l[0..64], 0, "nvapi-test-ok");
    assert r[1] == 6 and r[0] == 0;
}

test spaces_around_and_inside_the_quotes_are_trimmed {
    var o : [64]u32 = undefined;
    var l : [64]u32 = undefined;
    var r : [2]u32 = undefined;
    const j : str = "\n{ \"keys\" :\n [ \"  nvapi-test-a1 \" ,\t\"nvapi-test-b2\"\n ] }\n";
    assert nv_parse(j, o[0..64], l[0..64], r[0..2]) == 2;
    assert nv_key_is(j, o[0..64], l[0..64], 0, "nvapi-test-a1");
    assert nv_key_is(j, o[0..64], l[0..64], 1, "nvapi-test-b2");
}

test repeats_are_dropped_and_counted {
    var o : [64]u32 = undefined;
    var l : [64]u32 = undefined;
    var r : [2]u32 = undefined;
    const j : str = "{\"keys\":[\"nvapi-test-a1\",\"nvapi-test-b2\",\" nvapi-test-a1\",\"nvapi-test-b2\"]}";
    assert nv_parse(j, o[0..64], l[0..64], r[0..2]) == 2;
    assert r[0] == 2 and r[1] == 0;
    assert nv_key_is(j, o[0..64], l[0..64], 1, "nvapi-test-b2");
}

test other_fields_are_skipped_in_any_order {
    var o : [64]u32 = undefined;
    var l : [64]u32 = undefined;
    var r : [2]u32 = undefined;
    const j : str = "{\"note\":\"a ] } , string\",\"meta\":{\"n\":[1,{\"x\":\"]\"}]},\"keys\":[\"nvapi-test-a1\"],\"v\":true}";
    assert nv_parse(j, o[0..64], l[0..64], r[0..2]) == 1;
    assert nv_key_is(j, o[0..64], l[0..64], 0, "nvapi-test-a1");
}

test the_list_hash_follows_the_keys_and_their_order {
    var o : [64]u32 = undefined;
    var l : [64]u32 = undefined;
    var r : [2]u32 = undefined;
    const a : str = "{\"keys\":[\"nvapi-test-a1\",\"nvapi-test-b2\"]}";
    const b : str = "{ \"keys\": [\"nvapi-test-a1\", \"nvapi-test-b2\"] }";
    const c : str = "{\"keys\":[\"nvapi-test-b2\",\"nvapi-test-a1\"]}";
    assert nv_parse(a, o[0..64], l[0..64], r[0..2]) == 2;
    const ha : u32 = nv_list_hash(a, o[0..64], l[0..64], 2);
    assert nv_parse(b, o[0..64], l[0..64], r[0..2]) == 2;
    assert nv_list_hash(b, o[0..64], l[0..64], 2) == ha;
    assert nv_parse(c, o[0..64], l[0..64], r[0..2]) == 2;
    assert nv_list_hash(c, o[0..64], l[0..64], 2) != ha;
}

test the_pick_starts_at_the_current_key_and_skips_the_dead {
    var st : [260]u32 = undefined;
    nv_state_init(st[0..260], 4, 7);
    assert nv_pick(st[0..260]) == 0;
    st[nv_at(0, NV_K_FLAGS)] = NV_F_DEAD;
    st[nv_at(1, NV_K_FLAGS)] = NV_F_DEAD;
    assert nv_pick(st[0..260]) == 2;
    st[NV_S_CUR] = 3;
    assert nv_pick(st[0..260]) == 3;
    st[nv_at(3, NV_K_FLAGS)] = NV_F_DEAD;
    assert nv_pick(st[0..260]) == 2;
    st[nv_at(2, NV_K_FLAGS)] = NV_F_DEAD;
    assert nv_pick(st[0..260]) == NV_NONE;
    assert nv_live(st[0..260]) == 0;
    nv_state_init(st[0..260], 0, 0);
    assert nv_pick(st[0..260]) == NV_NONE;
}

test a_refused_key_dies_and_the_next_live_key_goes_next {
    var st : [260]u32 = undefined;
    nv_state_init(st[0..260], 3, 1);
    assert nv_on_status(st[0..260], 0, 401) == NV_A_DEAD;
    assert nv_dead(st[0..260], 0) and nv_pick(st[0..260]) == 1;
    assert nv_on_status(st[0..260], 1, 403) == NV_A_DEAD;
    assert nv_pick(st[0..260]) == 2 and nv_live(st[0..260]) == 1;
    assert st[nv_at(1, NV_K_AUTH)] == 1;
    // a dead key never comes back by an answer to another key
    assert nv_on_status(st[0..260], 2, 200) == NV_A_OK;
    assert nv_dead(st[0..260], 0) and nv_dead(st[0..260], 1) and nv_pick(st[0..260]) == 2;
}

test a_rate_limit_moves_to_the_next_key_and_keeps_this_one_live {
    var st : [260]u32 = undefined;
    nv_state_init(st[0..260], 3, 1);
    st[NV_S_CUR] = 2;
    assert nv_on_status(st[0..260], 2, 429) == NV_A_NEXT;
    assert nv_pick(st[0..260]) == 0;
    assert nv_dead(st[0..260], 2) == false and st[nv_at(2, NV_K_RATE)] == 1;
    // the only live key stays current after a 429
    st[nv_at(0, NV_K_FLAGS)] = NV_F_DEAD;
    st[nv_at(1, NV_K_FLAGS)] = NV_F_DEAD;
    st[NV_S_CUR] = 2;
    assert nv_on_status(st[0..260], 2, 429) == NV_A_NEXT;
    assert nv_pick(st[0..260]) == 2;
}

test model_network_and_server_errors_move_no_key {
    var st : [260]u32 = undefined;
    nv_state_init(st[0..260], 2, 1);
    st[NV_S_CUR] = 1;
    assert nv_on_status(st[0..260], 1, 404) == NV_A_MODEL;
    assert nv_on_status(st[0..260], 1, 0) == NV_A_NET;
    assert nv_on_status(st[0..260], 1, 500) == NV_A_RETRY;
    assert nv_on_status(st[0..260], 1, 503) == NV_A_RETRY;
    assert nv_pick(st[0..260]) == 1 and nv_live(st[0..260]) == 2;
    assert nv_on_status(st[0..260], 5, 401) == NV_A_NONE;
    assert nv_on_status(st[0..260], 1, 200) == NV_A_OK and st[nv_at(1, NV_K_OK)] == 1;
}

test the_dead_model_is_never_sent {
    var m : [96]u8 = undefined;
    assert nv_model_denied("deepseek-ai/deepseek-v4.1-flash");
    assert nv_model_denied("deepseek-ai/deepseek-v4.1") == false;
    assert nv_model_denied(NV_MODEL_DEFAULT) == false;
    assert nv_model_denied("") == false;
    var n : usize = nv_model_for("deepseek-ai/deepseek-v4.1-flash", m[0..96]);
    assert same_bytes(m[0..n], "nvidia/nemotron-3-ultra-550b-a55b");
    n = nv_model_for("", m[0..96]);
    assert same_bytes(m[0..n], NV_MODEL_DEFAULT);
    n = nv_model_for("z-ai/glm-5.3", m[0..96]);
    assert same_bytes(m[0..n], "z-ai/glm-5.3");
    var b : [200]u8 = undefined;
    n = nv_probe_body("deepseek-ai/deepseek-v4.1-flash", b[0..200]);
    assert begins_with(b[0..n], "{\"model\":\"nvidia/nemotron-3-ultra-550b-a55b\",\"messages\":");
    assert b[n - 1] == 125;
}

test the_short_model_name_drops_the_vendor_and_the_sizes {
    var s : [96]u8 = undefined;
    var n : usize = nv_model_short("nvidia/nemotron-3-ultra-550b-a55b", s[0..96]);
    assert same_bytes(s[0..n], "nemotron-3-ultra");
    n = nv_model_short("z-ai/glm-5.3", s[0..96]);
    assert same_bytes(s[0..n], "glm-5.3");
    n = nv_model_short("plain", s[0..96]);
    assert same_bytes(s[0..n], "plain");
}

test the_state_survives_a_restart_of_the_same_list_only {
    var st : [260]u32 = undefined;
    nv_state_init(st[0..260], 3, 77);
    nv_on_status(st[0..260], 0, 403);
    nv_on_status(st[0..260], 1, 429);
    nv_on_status(st[0..260], 2, 200);
    nv_on_status(st[0..260], 2, 200);
    var t : [400]u8 = undefined;
    const n : usize = nv_state_text(st[0..260], t[0..400]);
    assert begins_with(t[0..n], "nvidia-state v1 3 77 2\n1 0 0 1\n0 0 1 0\n0 2 0 0\n");
    var back : [260]u32 = undefined;
    assert nv_state_load(t[0..n], 3, 77, back[0..260]);
    assert nv_pick(back[0..260]) == 2 and nv_live(back[0..260]) == 2 and back[nv_at(2, NV_K_OK)] == 2;
    assert nv_dead(back[0..260], 0);
    // another list (count or hash) or a cut file starts clean
    assert nv_state_load(t[0..n], 4, 77, back[0..260]) == false;
    assert nv_live(back[0..260]) == 4 and nv_pick(back[0..260]) == 0;
    assert nv_state_load(t[0..n], 3, 78, back[0..260]) == false;
    assert nv_state_load(t[0 .. n - 6], 3, 77, back[0..260]) == false;
    assert nv_live(back[0..260]) == 3;
    assert nv_state_load("", 3, 77, back[0..260]) == false;
}

test the_status_line_reads_the_numbers_from_the_state {
    var st : [260]u32 = undefined;
    var o : [96]u8 = undefined;
    nv_state_init(st[0..260], 34, 5);
    nv_on_status(st[0..260], 7, 401);
    var n : usize = nv_status_line(st[0..260], 34, NV_MODEL_DEFAULT, o[0..96]);
    assert same_bytes(o[0..n], "NVIDIA: 34 keys, 33 live, model nemotron-3-ultra");
    n = nv_status_line(st[0..260], 34, "deepseek-ai/deepseek-v4.1-flash", o[0..96]);
    assert same_bytes(o[0..n], "NVIDIA: 34 keys, 33 live, model nemotron-3-ultra");
    nv_state_init(st[0..260], 1, 5);
    n = nv_status_line(st[0..260], 1, NV_MODEL_DEFAULT, o[0..96]);
    assert same_bytes(o[0..n], "NVIDIA: 1 key, 1 live, model nemotron-3-ultra");
    nv_state_init(st[0..260], 0, 0);
    n = nv_status_line(st[0..260], 0, NV_MODEL_DEFAULT, o[0..96]);
    assert same_bytes(o[0..n], "NVIDIA: no keys (Keychain nvidia-api-keys)");
    n = nv_status_line(st[0..260], NV_BAD, NV_MODEL_DEFAULT, o[0..96]);
    assert same_bytes(o[0..n], "NVIDIA: key list unreadable (Keychain nvidia-api-keys)");
    assert NV_CHAT_URL.len > 0;
}

test the_key_list_read_names_the_login_keychain_only_under_another_home {
    var w : [256]u8 = undefined;
    var o : [8]u32 = undefined;
    var z : usize = 0;
    while (z < 8) {
        o[z] = 0;
        z = z + 1;
    }
    var n : u32 = nv_kc_argv("/Users/a", "/Users/a", w[0..256], o[0..8]);
    assert n == 7;
    assert same_bytes(w[@as(usize, o[6]) .. @as(usize, o[6]) + 2], "-w");
    n = nv_kc_argv("", "", w[0..256], o[0..8]);
    assert n == 7;
    n = nv_kc_argv("/tmp/nvchk/home", "/Users/a", w[0..256], o[0..8]);
    assert n == 8;
    const k : usize = @as(usize, o[7]);
    assert same_bytes(w[k .. k + 44], "/Users/a/Library/Keychains/login.keychain-db");
    assert w[k + 44] == 0;
    assert same_bytes(w[@as(usize, o[3]) .. @as(usize, o[3]) + 15], "nvidia-api-keys");
    n = nv_kc_argv("/tmp/h", "/Users/a", w[0..120], o[0..8]);
    assert n == 7;
}
