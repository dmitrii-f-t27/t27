// SPDX-License-Identifier: Apache-2.0
// Explicit local owner import, dmitrii-f-t27/t27#6.
// T27OS_IMPORT_FILE is a local path. Dry-run unless T27OS_IMPORT_APPLY=1.
// Never emits a key, never uploads, never replaces an existing Keychain item.
// Order: read and validate every recognized line; then PLAN both providers before anything is written. A plan
// reads the provider's stored keys once (all MAX_KEYS = 64 numbers, kc_read_n): a slot is stored only on a read
// that returned a key and free only on an explicit "no such item"; a denied or failed read refuses the WHOLE import
// (keys_import_logic import_read_class). Each input key is then a duplicate (equal to a stored key), a repeat
// (equal to an earlier line of the input, import_earlier, exact past 64 new keys) or new; the new keys must fit the
// free slots (import_fits), else the WHOLE import is refused. With T27OS_IMPORT_APPLY=1 each new key is written to
// the lowest free slot (import_slots; a stored item is never replaced) and that slot is read back and compared in
// process; the summary counts what was really stored.
module T27osKeysImport;
use t27os::keys_import_logic::import_line;
use t27os::keys_import_logic::IMPORT_INVALID;
use t27os::keys_import_logic::import_fits;
use t27os::keys_import_logic::import_slots;
use t27os::keys_import_logic::import_earlier;
use t27os::keys_import_logic::import_read_class;
use t27os::keys_import_logic::READ_STORED;
use t27os::keys_import_logic::READ_UNKNOWN;
use t27os::keys::P_ZAI;
use t27os::keys::P_NVIDIA;
use t27os::keys::MAX_KEYS;
use t27os::keys::slot_add;
use t27os::keys::slot_count;
use t27os::keys::slot_taken;
use t27os::keys::SEC_OK;
use t27os::keys::SEC_FAILED;
use t27os::keys_host::kc_read_n;
use t27os::keys_host::kc_put_n;
use t27os::editors::same_bytes;
use t27os::pty_sys::sys_getenv;
use t27os::pty_sys::sys_strlen;
use t27os::pty_sys::sys_peek;
use t27os::pty_sys::sys_open_ro;
use t27os::pty_sys::sys_read;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_close;
use t27os::pty_sys::sys_exit;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

fn wipe(b: []u8) -> void {
    var i : usize = 0;
    while (i < b.len) { b[i] = 0; i = i + 1; }
}
fn say(s: []const u8) -> void { sys_write(1, s, @as(u64, s.len)); }
fn env(name: []const u8, out: []u8) -> usize {
    var z : [64]u8 = undefined;
    wipe(z[0..64]);
    if (name.len >= 64) { return 0; }
    put_bytes(z[0..64], 0, name);
    const p : u64 = sys_getenv(z[0..64]);
    if (p == 0) { return 0; }
    const n : u64 = sys_strlen(p);
    if (n == 0 or n >= @as(u64, out.len)) { return 0; }
    wipe(out);
    sys_peek(out, p, n);
    return @as(usize, @intCast(n));
}
/// One summary line; counts only, never a key.
fn summary(p: u32, found: u32, duplicate: u32, repeated: u32, new_keys: u32, free: u32, added: u32, failed: u32) -> void {
    var out : [192]u8 = undefined;
    var n : usize = 0;
    if (p == P_NVIDIA) { n = put_bytes(out[0..192], n, "NVIDIA"); }
    else { n = put_bytes(out[0..192], n, "Z.ai Coding Plan"); }
    n = put_bytes(out[0..192], n, " found=");
    n = put_dec(out[0..192], n, @as(u64, found));
    n = put_bytes(out[0..192], n, " duplicate=");
    n = put_dec(out[0..192], n, @as(u64, duplicate));
    n = put_bytes(out[0..192], n, " repeated=");
    n = put_dec(out[0..192], n, @as(u64, repeated));
    n = put_bytes(out[0..192], n, " new=");
    n = put_dec(out[0..192], n, @as(u64, new_keys));
    n = put_bytes(out[0..192], n, " free=");
    n = put_dec(out[0..192], n, @as(u64, free));
    n = put_bytes(out[0..192], n, " added=");
    n = put_dec(out[0..192], n, @as(u64, added));
    n = put_bytes(out[0..192], n, " failed=");
    n = put_dec(out[0..192], n, @as(u64, failed));
    n = put_bytes(out[0..192], n, "\n");
    say(out[0..n]);
}

/// Read every slot of provider p once (all MAX_KEYS numbers) into ex (256 bytes a slot) and exl; the stored-slot
/// mask. ok[0] is set to 0 when any read was neither a key nor an explicit "no such item" (denied, failed, a
/// timeout, output that is no key): that slot may hold a key the import cannot see.
fn load_stored(p: u32, ex: []u8, exl: []u32, ok: []u32) -> u64 {
    var m : u64 = 0;
    var st : [2]u32 = [0, 0];
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        const at : usize = @as(usize, k) * 256;
        wipe(ex[at .. at + 256]);
        st[0] = SEC_FAILED;
        const sn : usize = kc_read_n(p, k, ex[at .. at + 256], st[0..1]);
        const cls : u32 = import_read_class(st[0], sn);
        if (cls == READ_STORED) {
            exl[@as(usize, k)] = @as(u32, @intCast(sn));
            m = slot_add(m, k);
        } else {
            exl[@as(usize, k)] = 0;
            wipe(ex[at .. at + 256]);
            if (cls == READ_UNKNOWN) { ok[0] = 0; }
        }
        k = k + 1;
    }
    return m;
}

/// Is v one of the stored keys in ex/exl?
fn stored_has(ex: []const u8, exl: []const u32, m: u64, v: []const u8) -> bool {
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (slot_taken(m, k)) {
            const at : usize = @as(usize, k) * 256;
            if (same_bytes(ex[at .. at + @as(usize, exl[@as(usize, k)])], v)) { return true; }
        }
        k = k + 1;
    }
    return false;
}

/// Plan provider p over the input: c[0] found, c[1] duplicate (equal to a stored key), c[2] repeated (equal to an
/// earlier input line), c[3] new. The byte ranges of the first MAX_KEYS new keys go to plo/phi at `base` (more new
/// keys than that never fit, and the import is refused then; the counts stay exact).
fn plan(p: u32, data: []const u8, n: usize, ex: []const u8, exl: []const u32, m: u64, plo: []u32, phi: []u32, base: usize, c: []u32) -> void {
    c[0] = 0;
    c[1] = 0;
    c[2] = 0;
    c[3] = 0;
    var b : [2]u32 = [0, 0];
    var a : usize = 0;
    while (a < n) {
        var e : usize = a;
        while (e < n and data[e] != 10) { e = e + 1; }
        if (import_line(data[a..e], b[0..2]) == p) {
            c[0] = c[0] + 1;
            const lo : usize = a + @as(usize, b[0]);
            const hi : usize = a + @as(usize, b[1]);
            if (stored_has(ex, exl, m, data[lo..hi])) {
                c[1] = c[1] + 1;
            } else if (import_earlier(data[0..n], a, p, data[lo..hi])) {
                c[2] = c[2] + 1;
            } else {
                if (c[3] < MAX_KEYS) {
                    plo[base + @as(usize, c[3])] = @as(u32, @intCast(lo));
                    phi[base + @as(usize, c[3])] = @as(u32, @intCast(hi));
                }
                c[3] = c[3] + 1;
            }
        }
        a = e + 1;
    }
}

fn group_provider(g: u32) -> u32 {
    if (g == 1) { return P_ZAI; }
    return P_NVIDIA;
}

pub fn main() -> void {
    var path : [4096]u8 = undefined;
    const pn : usize = env("T27OS_IMPORT_FILE", path[0..4096]);
    if (pn == 0) { say("Missing local import path.\n"); sys_exit(2); }
    const fd : i32 = sys_open_ro(path[0..pn + 1], 0);
    wipe(path[0..4096]);
    if (fd < 0) { say("Cannot open local import file.\n"); sys_exit(2); }
    var data : [65536]u8 = undefined;
    wipe(data[0..65536]);
    var n : usize = 0;
    var bad : bool = false;
    var done : bool = false;
    while (done == false and n < 65536) {
        const r : i64 = sys_read(fd, data[n..65536], @as(u64, 65536 - n));
        if (r < 0) { bad = true; done = true; }
        else if (r == 0) { done = true; }
        else { n = n + @as(usize, @intCast(r)); }
    }
    sys_close(fd);
    if (bad or n == 65536) {
        wipe(data[0..65536]); say("Import read failed or exceeded size limit.\n"); sys_exit(2);
    }
    var flags : [8]u8 = undefined;
    const fnn : usize = env("T27OS_IMPORT_APPLY", flags[0..8]);
    const apply : bool = fnn == 1 and flags[0] == 49;
    // Validate every recognized line before the first write.
    var a : usize = 0;
    var b : [2]u32 = [0, 0];
    while (a < n) {
        var e : usize = a;
        while (e < n and data[e] != 10) { e = e + 1; }
        if (import_line(data[a..e], b[0..2]) == IMPORT_INVALID) { bad = true; }
        a = e + 1;
    }
    if (bad) { wipe(data[0..65536]); say("Invalid recognized value; nothing imported.\n"); sys_exit(2); }
    // Plan both providers before any write.
    var ex : [16384]u8 = undefined;
    var exl : [64]u32 = undefined;
    var plo : [128]u32 = undefined;
    var phi : [128]u32 = undefined;
    var slots : [64]u32 = undefined;
    var c : [8]u32 = [0, 0, 0, 0, 0, 0, 0, 0];
    var m : [2]u64 = [0, 0];
    var okr : [2]u32 = [1, 0];
    var unreadable : bool = false;
    var refuse : bool = false;
    var g : u32 = 0;
    while (g < 2) {
        const p : u32 = group_provider(g);
        const gb : usize = @as(usize, g) * 4;
        okr[0] = 1;
        m[@as(usize, g)] = load_stored(p, ex[0..16384], exl[0..64], okr[0..1]);
        plan(p, data[0..65536], n, ex[0..16384], exl[0..64], m[@as(usize, g)], plo[0..128], phi[0..128], @as(usize, g) * 64, c[gb .. gb + 4]);
        wipe(ex[0..16384]);
        if (okr[0] == 0) { unreadable = true; }
        if (import_fits(m[@as(usize, g)], c[gb + 3]) == false) { refuse = true; }
        g = g + 1;
    }
    if (apply == false or unreadable or refuse) {
        g = 0;
        while (g < 2) {
            const gb : usize = @as(usize, g) * 4;
            summary(group_provider(g), c[gb], c[gb + 1], c[gb + 2], c[gb + 3], MAX_KEYS - slot_count(m[@as(usize, g)]), 0, 0);
            g = g + 1;
        }
    }
    if (unreadable) {
        wipe(data[0..65536]);
        say("A Keychain read failed or was denied; free slots are unknown; nothing imported.\n");
        sys_exit(2);
    }
    if (refuse) {
        wipe(data[0..65536]);
        say("Not enough free key slots (64 a provider); nothing imported.\n");
        sys_exit(2);
    }
    if (apply == false) {
        wipe(data[0..65536]);
        say("Dry-run: no Keychain writes.\n");
        sys_exit(0);
    }
    // Write each new key to the lowest free slot of its provider and read exactly that slot back.
    var tmp : [256]u8 = undefined;
    var rst : [2]u32 = [0, 0];
    g = 0;
    while (g < 2) {
        const p : u32 = group_provider(g);
        const gb : usize = @as(usize, g) * 4;
        const base : usize = @as(usize, g) * 64;
        var added : u32 = 0;
        var failed : u32 = 0;
        const got : u32 = import_slots(m[@as(usize, g)], c[gb + 3], slots[0..64]);
        var i : u32 = 0;
        while (i < got) {
            const ix : usize = @as(usize, i);
            const v : []const u8 = data[@as(usize, plo[base + ix]) .. @as(usize, phi[base + ix])];
            var ok : bool = false;
            if (kc_put_n(p, slots[ix], v)) {
                // Read-back of exactly that slot, compared in process; the value is never emitted.
                wipe(tmp[0..256]);
                rst[0] = SEC_FAILED;
                const rn : usize = kc_read_n(p, slots[ix], tmp[0..256], rst[0..1]);
                ok = rst[0] == SEC_OK and rn == v.len and same_bytes(tmp[0..rn], v);
                wipe(tmp[0..256]);
            }
            if (ok) { added = added + 1; } else { failed = failed + 1; }
            i = i + 1;
        }
        failed = failed + (c[gb + 3] - got);
        summary(p, c[gb], c[gb + 1], c[gb + 2], c[gb + 3], MAX_KEYS - slot_count(m[@as(usize, g)]), added, failed);
        if (failed > 0) { bad = true; }
        g = g + 1;
    }
    wipe(data[0..65536]);
    if (bad) { sys_exit(1); }
    sys_exit(0);
}

test the_import_program_is_declared {
    // every decision this program makes is tested in keys_import_logic.t27; this file only reads, writes and
    // reports (a module holding @extern imports cannot run tests that call them)
    var b : [4]u8 = undefined;
    b[0] = 1;
    assert b[0] == 1;
}
