use t27os::call_session::cs_text_take;
use t27os::call_session::CS_EV_NONE;
use t27os::call_session::CS_EV_RINGING;
use t27os::call_session::CS_EV_CODE;
use t27os::call_session::CS_EV_ACTIVE;
use t27os::call_session::CS_EV_ENDED;
use t27os::call_session::CS_EV_FAILED;
use t27os::chat_core::CH_K_TEXT;
use t27os::chat_core::CH_K_ACK;
use t27os::chat_core::CH_K_READ;
use t27os::chat_core::CH_R_SEND;
use t27os::chat_core::CH_R_GIVEUP;
use t27os::chat_core::CH_RX_NEW;
use t27os::chat_core::CH_RX_DUP;
use t27os::chat_core::CH_CALLING_MS;
use t27os::chat_core::CF_OK;
use t27os::chat_core::CF_MAX;
use t27os::chat_core::ch_kind;
use t27os::chat_core::ch_msg;
use t27os::chat_core::ch_part;
use t27os::chat_core::ch_put_text;
use t27os::chat_core::ch_put_ack;
use t27os::chat_core::ch_put_read;
use t27os::chat_core::ch_rx_text;
use t27os::chat_core::ch_rx_acks;
use t27os::chat_core::ch_rx_ack;
use t27os::chat_core::ch_rx_read;
use t27os::chat_core::ch_idle_close;
use t27os::chat_core::ch_redial_ms;
use t27os::chat_core::cl_init;
use t27os::chat_core::cl_count;
use t27os::chat_core::cl_msg;
use t27os::chat_core::cl_time;
use t27os::chat_core::cl_text;
use t27os::chat_core::cl_parts;
use t27os::chat_core::cl_tries;
use t27os::chat_core::cl_due;
use t27os::chat_core::cl_part_due;
use t27os::chat_core::cl_mark_sent;
use t27os::chat_core::cl_session_start;
use t27os::chat_core::cl_pending;
use t27os::chat_core::cl_out_add;
use t27os::chat_core::cl_open_read;
use t27os::chat_core::cf_encode;
use t27os::chat_core::cf_decode;
use t27os::chat_core::cf_name;

fn chh_access(path: []const u8, mode: i32) -> i32 { return @extern("access"); }

// ---------------------------------------------------------------- the file

pub const CHH_NEW : u32 = 1;
pub const CHH_LOADED : u32 = 2;
/// The file did not check: it was moved to <name>.bad and the log starts empty. Low 8 bits CHH_MOVED, next 8 the
/// cf_decode status.
pub const CHH_MOVED : u32 = 3;
pub const CHH_IOERR : u32 = 4;

/// kind 0 = <home>/.t27os/chat (the directory), 1 = the friend's log, 2 = its .tmp, 3 = its .bad. NUL-terminated;
/// the length, 0 when it does not fit.
pub fn chh_path(home: []const u8, hn: usize, fp: []const u8, kind: u32, out: []u8) -> usize {
    if (hn + 64 > out.len) { return 0; }
    var n : usize = put_bytes(out, 0, home[0..hn]);
    n = put_bytes(out, n, "/.t27os/chat");
    if (kind != 0) {
        out[n] = 47;
        n = n + 1;
        var nm : [24]u8 = undefined;
        if (cf_name(fp, nm[0..24]) != 24) { return 0; }
        n = put_bytes(out, n, nm[0..24]);
        if (kind == 2) { n = put_bytes(out, n, ".tmp"); }
        if (kind == 3) { n = put_bytes(out, n, ".bad"); }
    }
    out[n] = 0;
    return n;
}

/// Open the log of friend fp keeping cap lines: no file -> empty (CHH_NEW); a good file -> loaded; a file that does
/// not check -> moved aside, empty (CHH_MOVED | status << 8). buf is scratch of CF_MAX bytes.
pub fn chh_load(fp: []const u8, log: []u8, cap: u32, buf: []u8) -> u32 {
    if (!cl_init(log, fp, cap) or buf.len < CF_MAX + 1) { return CHH_IOERR; }
    var home : [256]u8 = undefined;
    const hn : usize = ih_home(home[0..IH_PATH_MAX]);
    if (hn == 0) { return CHH_IOERR; }
    var path : [256]u8 = undefined;
    if (chh_path(home[0..256], hn, fp, 1, path[0..256]) == 0) { return CHH_IOERR; }
    if (chh_access(path[0..256], 0) != 0) { return CHH_NEW; }
    const got : i64 = ih_slurp(path[0..256], buf, CF_MAX + 1);
    if (got < 0) { return CHH_IOERR; }
    var st : u32 = 1;
    if (@as(usize, @intCast(got)) <= CF_MAX) { st = cf_decode(buf[0..@as(usize, @intCast(got))], log); }
    if (st == CF_OK) { return CHH_LOADED; }
    cl_init(log, fp, cap);
    var bad : [256]u8 = undefined;
    chh_path(home[0..256], hn, fp, 3, bad[0..256]);
    if (sys_rename(path[0..256], bad[0..256]) != 0) { return CHH_IOERR; }
    return CHH_MOVED | (st << 8);
}

/// Write the log of its friend whole and atomically. buf is scratch of CF_MAX bytes.
pub fn chh_save(log: []const u8, buf: []u8) -> bool {
    const n : usize = cf_encode(log, buf);
    if (n == 0) { return false; }
    var home : [256]u8 = undefined;
    const hn : usize = ih_home(home[0..IH_PATH_MAX]);
    if (hn == 0) { return false; }
    var dir : [256]u8 = undefined;
    var path : [256]u8 = undefined;
    var tmp : [256]u8 = undefined;
    // the parent ~/.t27os first (mkdir of an existing one is a no-op)
    var top : [256]u8 = undefined;
    var tn : usize = put_bytes(top[0..256], 0, home[0..hn]);
    tn = put_bytes(top[0..256], tn, "/.t27os");
    top[tn] = 0;
    chh_path(home[0..256], hn, log[28..38], 0, dir[0..256]);
    chh_path(home[0..256], hn, log[28..38], 1, path[0..256]);
    chh_path(home[0..256], hn, log[28..38], 2, tmp[0..256]);
    sys_mkdir(top[0..256], 448);
    return ih_write_atomic(dir[0..256], path[0..256], tmp[0..256], buf, n);
}

// ---------------------------------------------------------------- the session driver

/// The driver's block: CHM_LEN bytes of u64 slots (u64 k at 8 k), then the friend's fingerprint.
pub const CHM_LEN : usize = 256;
const M_IP : usize = 0;
const M_PORT : usize = 1;
const M_LAST : usize = 2;
const M_REDIAL : usize = 3;
const M_READ_UPTO : usize = 4;
const M_READ_SENT : usize = 5;
const M_DIRTY : usize = 6;
/// Counters (chm_stat).
pub const CHM_TX_FRAMES : u32 = 7;
pub const CHM_TX_RESENDS : u32 = 8;
pub const CHM_RX_NEW : u32 = 9;
pub const CHM_RX_DUP : u32 = 10;
pub const CHM_ACK_TX : u32 = 11;
pub const CHM_ACK_RX : u32 = 12;
pub const CHM_READ_TX : u32 = 13;
pub const CHM_READ_RX : u32 = 14;
pub const CHM_SESSIONS : u32 = 15;
pub const CHM_IDLE_CLOSED : u32 = 16;
pub const CHM_REFUSED : u32 = 17;
pub const CHM_DROPPED : u32 = 18;
pub const CHM_FAILED : u32 = 19;
pub const CHM_DIALS : u32 = 20;
pub const CHM_SEND_ERR : u32 = 21;
/// Test aid: the n-th text frame this side sends (TEXT parts only, from 1) is sealed and dropped as a lost datagram;
/// 0 = none.
pub const CHM_K_DROP : u32 = 22;
const M_TXN : usize = 23;
const M_FP : usize = 192;

/// chm_tick says what moved (bits): a new incoming line, a status of a line, the log needs saving.
pub const CHM_E_NEW : u32 = 1;
pub const CHM_E_STATUS : u32 = 2;
pub const CHM_E_DIRTY : u32 = 4;

fn mg(m: []const u8, k: usize) -> u64 { return get_u64(m, k * 8); }
fn mp(m: []u8, k: usize, v: u64) -> void { put_u64(m, k * 8, v); }
fn ma(m: []u8, k: usize) -> void { mp(m, k, mg(m, k) + 1); }

/// The friend fp reachable at ip:port (its chat port).
pub fn chm_init(m: []u8, fp: []const u8, ip: u64, port: u64) -> bool {
    if (m.len < CHM_LEN or fp.len != 10) { return false; }
    var i : usize = 0;
    while (i < CHM_LEN) {
        m[i] = 0;
        i = i + 1;
    }
    mp(m, M_IP, ip);
    mp(m, M_PORT, port);
    i = 0;
    while (i < 10) {
        m[M_FP + i] = fp[i];
        i = i + 1;
    }
    return true;
}

pub fn chm_stat(m: []const u8, k: u32) -> u64 {
    if (@as(usize, k) * 8 + 8 > M_FP) { return 0; }
    return mg(m, @as(usize, k));
}

pub fn chm_set(m: []u8, k: u32, v: u64) -> bool {
    if (k != CHM_K_DROP) { return false; }
    mp(m, @as(usize, k), v);
    return true;
}

/// A message typed by the person: queued PENDING (chm_tick dials and sends it). Its number, 0 when refused.
pub fn chm_send(m: []u8, log: []u8, text: []const u8, now: u64) -> u32 {
    const msg : u32 = cl_out_add(log, text, now);
    if (msg != 0) { mp(m, M_DIRTY, 1); }
    return msg;
}

/// The chat is shown: every incoming line is READ; the READ goes out with the next tick of a session.
pub fn chm_open(m: []u8, log: []u8) -> bool {
    const upto : u32 = cl_open_read(log);
    if (upto == 0) { return false; }
    if (@as(u64, upto) > mg(m, M_READ_UPTO)) { mp(m, M_READ_UPTO, @as(u64, upto)); }
    mp(m, M_DIRTY, 1);
    return true;
}

fn chm_peer_is(m: []const u8, s: []const u8) -> bool {
    var fp : [10]u8 = undefined;
    if (cs_peer(s, fp[0..10]) == 0) { return false; }
    var i : usize = 0;
    while (i < 10) {
        if (fp[i] != m[M_FP + i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn chm_tx(m: []u8, s: []u8, pt: []const u8) -> bool {
    if (cs_text_send(s, pt)) { return true; }
    ma(m, CHM_SEND_ERR);
    return false;
}

/// One pass: run the session (answer a friend, confirm, dismiss an ended one), take every received chat frame,
/// send what is due, send a pending READ, dial when something waits, close when idle. me_fp is this device's
/// fingerprint, friends the peer_identity table. Returns CHM_E_* bits.
pub fn chm_tick(m: []u8, s: []u8, log: []u8, asm: []u8, friends: []const u8, me_fp: []const u8, now: u64) -> u32 {
    var ev : u32 = 0;
    var e : u32 = cs_poll(s);
    var guard : u32 = 0;
    while (e != CS_EV_NONE and guard < 32) {
        if (e == CS_EV_RINGING) {
            var fp : [10]u8 = undefined;
            cs_peer(s, fp[0..10]);
            if (ft_find(friends, fp[0..10]) != FT_MAX and chm_peer_is(m, s)) {
                cs_answer(s);
            } else {
                ma(m, CHM_REFUSED);
                cs_decline(s);
            }
        } else if (e == CS_EV_CODE) {
            cs_confirm(s, true);
        } else if (e == CS_EV_ACTIVE) {
            ma(m, CHM_SESSIONS);
            mp(m, M_LAST, now);
            mp(m, M_READ_SENT, 0);
            if (cl_session_start(log) > 0) { ev = ev | CHM_E_STATUS; }
        } else if (e == CS_EV_ENDED or e == CS_EV_FAILED) {
            cs_dismiss(s);
        }
        e = cs_poll(s);
        guard = guard + 1;
    }
    const st : u32 = cs_state(s);
    if (st == CK_ACTIVE) {
        var pt : [720]u8 = undefined;
        var n : usize = cs_text_take(s, pt[0..720]);
        while (n > 0) {
            mp(m, M_LAST, now);
            const kind : u32 = ch_kind(pt[0..n]);
            if (kind == CH_K_TEXT) {
                const r : u32 = ch_rx_text(log, asm, pt[0..n]);
                if (r == CH_RX_NEW) {
                    ma(m, CHM_RX_NEW);
                    ev = ev | CHM_E_NEW | CHM_E_DIRTY;
                }
                if (r == CH_RX_DUP) { ma(m, CHM_RX_DUP); }
                if (ch_rx_acks(r)) {
                    var a : [20]u8 = undefined;
                    ch_put_ack(a[0..20], ch_msg(pt[0..n]), ch_part(pt[0..n]));
                    if (chm_tx(m, s, a[0..20])) { ma(m, CHM_ACK_TX); }
                }
            } else if (kind == CH_K_ACK) {
                ma(m, CHM_ACK_RX);
                if (ch_rx_ack(log, pt[0..n])) { ev = ev | CHM_E_STATUS | CHM_E_DIRTY; }
            } else if (kind == CH_K_READ) {
                ma(m, CHM_READ_RX);
                if (ch_rx_read(log, pt[0..n]) > 0) { ev = ev | CHM_E_STATUS | CHM_E_DIRTY; }
            }
            n = cs_text_take(s, pt[0..720]);
        }
        // what is due goes out: every part still without its ACK
        const cnt : usize = @as(usize, cl_count(log));
        var i : usize = 0;
        while (i < cnt) {
            const d : u32 = cl_due(log, i, now);
            if (d == CH_R_GIVEUP) {
                ma(m, CHM_FAILED);
                ev = ev | CHM_E_STATUS | CHM_E_DIRTY;
            }
            if (d == CH_R_SEND) {
                if (cl_tries(log, i) > 0) { ma(m, CHM_TX_RESENDS); }
                var k : u32 = 0;
                while (k < cl_parts(log, i)) {
                    if (cl_part_due(log, i, k)) {
                        var p : [720]u8 = undefined;
                        const pn : usize = ch_put_text(p[0..720], cl_msg(log, i), k, cl_time(log, i), cl_text(log, i));
                        ma(m, M_TXN);
                        if (mg(m, M_TXN) == mg(m, @as(usize, CHM_K_DROP))) {
                            ma(m, CHM_DROPPED);
                        } else if (pn > 0 and chm_tx(m, s, p[0..pn])) {
                            ma(m, CHM_TX_FRAMES);
                        }
                    }
                    k = k + 1;
                }
                cl_mark_sent(log, i, now);
                mp(m, M_LAST, now);
                ev = ev | CHM_E_STATUS;
            }
            i = i + 1;
        }
        // a READ is sent once per session for the highest message shown
        const upto : u64 = mg(m, M_READ_UPTO);
        if (upto > mg(m, M_READ_SENT)) {
            var r : [20]u8 = undefined;
            ch_put_read(r[0..20], @as(u32, @intCast(upto)));
            if (chm_tx(m, s, r[0..20])) {
                ma(m, CHM_READ_TX);
                mp(m, M_READ_SENT, upto);
                mp(m, M_LAST, now);
            }
        }
        var waiting : u32 = cl_pending(log);
        if (upto > mg(m, M_READ_SENT)) { waiting = waiting + 1; }
        if (ch_idle_close(now, mg(m, M_LAST), waiting)) {
            ma(m, CHM_IDLE_CLOSED);
            cs_hangup(s);
            cs_dismiss(s);
        }
    } else if (st == CK_IDLE or st == CK_ENDED or st == CK_FAILED) {
        if (st != CK_IDLE) { cs_dismiss(s); }
        // something waits: dial the friend's chat port; a dial that was not answered is retried after the redial gap
        var need : bool = cl_pending(log) > 0 or mg(m, M_READ_UPTO) > mg(m, M_READ_SENT);
        if (need and now >= mg(m, M_REDIAL) and mg(m, M_IP) != 0) {
            if (cs_call(s, mg(m, M_IP), mg(m, M_PORT), m[M_FP..M_FP + 10])) { ma(m, CHM_DIALS); }
            mp(m, M_REDIAL, now + CH_CALLING_MS + ch_redial_ms(me_fp, m[M_FP..M_FP + 10]));
        }
    }
    if (mg(m, M_DIRTY) != 0) {
        mp(m, M_DIRTY, 0);
        ev = ev | CHM_E_DIRTY;
    }
    return ev;
}

// ---------------------------------------------------------------- tests

test the_log_path_is_the_chat_folder_and_the_fingerprint {
    const home : [10]u8 = [47, 85, 115, 101, 114, 115, 47, 120, 121, 122];
    const fp : [10]u8 = [0, 1, 2, 3, 4, 5, 6, 7, 8, 171];
    var out : [256]u8 = undefined;
    const d : usize = chh_path(home[0..10], 10, fp[0..10], 0, out[0..256]);
    assert d == 10 + 12 and out[d] == 0 and out[17] == 47 and out[21] == 116;
    const f : usize = chh_path(home[0..10], 10, fp[0..10], 1, out[0..256]);
    assert f == d + 1 + 24 and out[d] == 47 and out[d + 1] == 48 and out[d + 19] == 97 and out[d + 20] == 98;
    assert chh_path(home[0..10], 10, fp[0..10], 2, out[0..256]) == f + 4;
    assert chh_path(home[0..10], 10, fp[0..10], 3, out[0..256]) == f + 4;
    assert out[f + 1] == 98;
    assert chh_path(home[0..10], 10, fp[0..9], 1, out[0..256]) == 0;
    assert chh_path(home[0..10], 10, fp[0..10], 1, out[0..60]) == 0;
    var m : [256]u8 = undefined;
    assert chm_init(m[0..256], fp[0..10], 2130706433, 47800);
    assert chm_stat(m[0..256], CHM_SESSIONS) == 0;
    assert chm_set(m[0..256], CHM_K_DROP, 5) and chm_stat(m[0..256], CHM_K_DROP) == 5;
    assert chm_set(m[0..256], CHM_SESSIONS, 5) == false;
    assert chm_stat(m[0..256], 40) == 0;
}
