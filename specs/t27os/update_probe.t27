fn up_peek32(at: u64) -> u32 {
    var c : [4]u8 = undefined;
    sys_peek(c[0..4], at, 4);
    return @as(u32, c[0]) | (@as(u32, c[1]) << 8) | (@as(u32, c[2]) << 16) | (@as(u32, c[3]) << 24);
}

fn up_peek8(at: u64) -> u32 {
    var c : [1]u8 = undefined;
    sys_peek(c[0..1], at, 1);
    return @as(u32, c[0]);
}

fn up_say(s: []const u8) -> void { sys_write(1, s, @as(u64, s.len)); }

fn up_dec(v: u64) -> void {
    var d : [24]u8 = undefined;
    const n : usize = put_dec(d[0..24], 0, v);
    sys_write(1, d[0..n], @as(u64, n));
}

fn up_hex(b: []const u8, n: usize) -> void {
    var h : [512]u8 = undefined;
    var i : usize = 0;
    while (i < n) {
        const hi : u32 = @as(u32, b[i]) >> 4;
        const lo : u32 = @as(u32, b[i]) & 15;
        var c1 : u32 = 87 + hi;
        if (hi < 10) { c1 = 48 + hi; }
        var c2 : u32 = 87 + lo;
        if (lo < 10) { c2 = 48 + lo; }
        h[2 * i] = @as(u8, @intCast(c1));
        h[2 * i + 1] = @as(u8, @intCast(c2));
        i = i + 1;
    }
    sys_write(1, h[0..2 * n], @as(u64, 2 * n));
}

fn up_ok(label: []const u8, ok: bool) -> bool {
    if (ok) { up_say("PASS "); } else { up_say("FAIL "); }
    up_say(label);
    up_say("\n");
    return ok;
}

/// One table row: label, the code expected, the code got.
fn up_row(label: []const u8, want: u32, got: u32) -> bool {
    if (want == got) { up_say("PASS "); } else { up_say("FAIL "); }
    up_say(label);
    up_say(" | expect ");
    up_dec(@as(u64, want));
    up_say(" | got ");
    up_dec(@as(u64, got));
    up_say("\n");
    return want == got;
}

fn up_env(name: []const u8, out: []u8) -> usize {
    const p : u64 = sys_getenv(name);
    if (p == 0) { return 0; }
    var n : u64 = sys_strlen(p);
    if (n >= @as(u64, out.len)) { n = @as(u64, out.len - 1); }
    if (n > 0) { sys_peek(out[0..@as(usize, n)], p, n); }
    out[@as(usize, n)] = 0;
    return @as(usize, n);
}

fn up_env_num(name: []const u8, dflt: u64) -> u64 {
    var b : [24]u8 = undefined;
    const n : usize = up_env(name, b[0..24]);
    if (n == 0) { return dflt; }
    var v : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        if (b[i] < 48 or b[i] > 57) { return dflt; }
        v = v * 10 + @as(u64, b[i] - 48);
        i = i + 1;
    }
    return v;
}

/// UP_VERSION "a.b.c" into a packed version; fallback 0.1.3.
fn up_env_version() -> u64 {
    var b : [24]u8 = undefined;
    const n : usize = up_env("UP_VERSION", b[0..24]);
    var part : [3]u32 = undefined;
    part[0] = 0;
    part[1] = 1;
    part[2] = 3;
    if (n == 0) { return um_pack(0, 1, 3); }
    var k : usize = 0;
    var v : u32 = 0;
    var any : bool = false;
    var i : usize = 0;
    while (i <= n) {
        if (i == n or b[i] == 46) {
            if (any == false or k > 2) { return um_pack(0, 1, 3); }
            part[k] = v;
            k = k + 1;
            v = 0;
            any = false;
        } else if (b[i] >= 48 and b[i] <= 57) {
            v = v * 10 + @as(u32, b[i]) - 48;
            any = true;
        } else {
            return um_pack(0, 1, 3);
        }
        i = i + 1;
    }
    if (k != 3) { return um_pack(0, 1, 3); }
    return um_pack(part[0], part[1], part[2]);
}

fn up_now_ms() -> u64 {
    var tv : [16]u8 = undefined;
    sys_gettimeofday(tv[0..16], 0);
    return get_u64(tv[0..16], 0) * 1000 + (get_u64(tv[0..16], 8) & 4294967295) / 1000;
}

// ---------------------------------------------------------------- table

/// A throw-away identity in memory: the 207-byte identity buffer and its fingerprint.
fn up_identity(id: []u8, fp: []u8) -> bool {
    var priv : [97]u8 = undefined;
    var pubk : [65]u8 = undefined;
    if (ks_gen_pair(priv[0..97], pubk[0..65]) == false) { return false; }
    const nick : [1]u8 = [120];
    if (id_build(pubk[0..65], priv[0..97], nick[0..1], 1, id) != ID_LEN) { return false; }
    return ih_fingerprint(pubk[0..65], fp);
}

fn up_write_file(path: []const u8, bytes: usize, flip_at: usize) -> bool {
    const fd : i32 = sys_creat(path, 384);
    if (fd < 0) { return false; }
    var buf : [16384]u8 = undefined;
    var done : usize = 0;
    while (done < bytes) {
        var i : usize = 0;
        while (i < 16384) {
            buf[i] = @as(u8, @intCast(((done + i) * 7 + 13) & 255));
            i = i + 1;
        }
        var want : usize = bytes - done;
        if (want > 16384) { want = 16384; }
        if (flip_at >= done and flip_at < done + want) { buf[flip_at - done] = buf[flip_at - done] ^ 1; }
        const w : i64 = sys_write(fd, buf[0..want], @as(u64, want));
        if (w <= 0) {
            sys_close(fd);
            return false;
        }
        done = done + @as(usize, @intCast(w));
    }
    sys_close(fd);
    return true;
}

fn up_path(out: []u8) -> usize {
    var dir : [96]u8 = undefined;
    var dn : usize = up_env("UP_DIR", dir[0..96]);
    var n : usize = 0;
    if (dn == 0) {
        n = put_bytes(out, 0, "/tmp");
    } else {
        n = put_bytes(out, 0, dir[0..dn]);
    }
    n = put_bytes(out, n, "/t27os-update-probe.bin");
    out[n] = 0;
    return n;
}

fn up_table() -> bool {
    var all : bool = true;
    up_say("codes: 0 accepted | 1 manifest does not parse | 2 fingerprint is not the key's | 3 stranger | 4 rollback (build not newer)\n");
    up_say("       5 version below the running one | 6 size out of 1..200 MiB | 10 signature not true | 11 file does not match\n");
    var ida : [208]u8 = undefined;
    var fpa : [10]u8 = undefined;
    var idb : [208]u8 = undefined;
    var fpb : [10]u8 = undefined;
    var idc : [208]u8 = undefined;
    var fpc : [10]u8 = undefined;
    all = up_ok("three throw-away identities (A author, B friend's device, C stranger)", up_identity(ida[0..208], fpa[0..10]) and up_identity(idb[0..208], fpb[0..10]) and up_identity(idc[0..208], fpc[0..10])) and all;
    // B's friends table holds A; C is nobody's friend
    var ftb : [1108]u8 = undefined;
    var inv : [25]u8 = undefined;
    ft_init(ftb[0..1108]);
    invite_make(fpa[0..10], inv[0..25]);
    all = up_ok("B befriends A (invite string)", ft_add(ftb[0..1108], inv[0..25], fpb[0..10]) == FA_OK) and all;

    // the bundle: 2 MiB test file, its hash and size
    var path : [128]u8 = undefined;
    up_path(path[0..128]);
    const size : usize = 2097152;
    all = up_ok("2 MiB test file written", up_write_file(path[0..128], size, 99999999)) and all;
    var sha : [32]u8 = undefined;
    const got : i64 = uh_file_sha(path[0..128], sha[0..32]);
    all = up_ok("file SHA-256 read in chunks, size 2097152", got == 2097152) and all;
    up_say("file sha256 ");
    up_hex(sha[0..32], 32);
    up_say("\n");


    var ftc : [1108]u8 = undefined;
    ft_init(ftc[0..1108]);
    const cur_ver : u64 = um_pack(0, 1, 3);
    const cur_build : u32 = 4311;
    var m : [216]u8 = undefined;
    const mn : usize = uh_make_manifest(ida[0..208], 0, 1, 3, 4321, 2097152, sha[0..32], m[0..216]);
    all = up_ok("A makes and signs a manifest (216 bytes)", mn == 216) and all;
    up_say("manifest ");
    up_hex(m[0..216], 216);
    up_say("\n");
    up_say("CASE | EXPECT | GOT\n");
    all = up_row("B checks A's manifest (friend, newer build, signature true)", 0, uh_check_manifest(m[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    all = up_row("A checks its own manifest (this device counts as known)", 0, uh_check_manifest(m[0..216], ftc[0..1108], fpa[0..10], cur_ver, cur_build)) and all;
    all = up_row("C with no friends checks A's manifest (stranger)", 3, uh_check_manifest(m[0..216], ftc[0..1108], fpc[0..10], cur_ver, cur_build)) and all;

    // one byte flipped in every region of the manifest
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 3, 1, "flip magic") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 8, 1, "flip format") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 12, 10, "flip major (0->1)") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 16, 5, "flip minor (1->0, below running)") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 20, 5, "flip patch (3->2, below running)") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 24, 10, "flip build (4321->4320)") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 28, 10, "flip size") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 36, 10, "flip bundle hash") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 68, 2, "flip author fingerprint") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 78, 1, "flip public key prefix") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 100, 2, "flip a public key byte") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 143, 1, "flip signature length") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 150, 10, "flip a signature byte") and all;

    // a truncated manifest
    all = up_row("truncated manifest, 215 bytes", 1, uh_check_manifest(m[0..215], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    all = up_row("truncated manifest, 100 bytes", 1, uh_check_manifest(m[0..100], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    all = up_row("empty manifest", 1, uh_check_manifest(m[0..0], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;

    // a stranger's own, perfectly signed manifest
    var mc : [216]u8 = undefined;
    all = up_ok("C makes and signs a manifest", uh_make_manifest(idc[0..208], 0, 1, 3, 4321, 2097152, sha[0..32], mc[0..216]) == 216) and all;
    all = up_row("B checks C's manifest (valid signature, author not a friend)", 3, uh_check_manifest(mc[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;

    // C forges: A's key and fingerprint in the body, C's signature
    var fb : [143]u8 = undefined;
    var fi : [159]u8 = undefined;
    var fs : [128]u8 = undefined;
    var forged : [216]u8 = undefined;
    um_body(0, 1, 3, 4321, 2097152, sha[0..32], fpa[0..10], ida[ID_OFF_PUB..ID_OFF_PUB + 65], fb[0..143]);
    um_sign_input(fb[0..143], fi[0..159]);
    const fsn : usize = ks_sign(idc[ID_OFF_PRIV..ID_OFF_PRIV + 97], fi[0..159], fs[0..128]);
    all = up_ok("C signs A's body with C's key", fsn > 0 and um_seal(fb[0..143], fs[0..fsn], forged[0..216]) == 216) and all;
    all = up_row("B checks the forged manifest (A's name, C's signature)", 10, uh_check_manifest(forged[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;

    // rollback: build-1 and the same build, both honestly signed by a friend
    var mr : [216]u8 = undefined;
    uh_make_manifest(ida[0..208], 0, 1, 3, cur_build - 1, 2097152, sha[0..32], mr[0..216]);
    all = up_row("A's manifest with build-1 (4310 against 4311)", 4, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 3, cur_build, 2097152, sha[0..32], mr[0..216]);
    all = up_row("A's manifest with the same build (4311 against 4311)", 4, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 3, cur_build + 1, 2097152, sha[0..32], mr[0..216]);
    all = up_row("A's manifest with build+1 (4312 against 4311)", 0, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 2, 9000, 2097152, sha[0..32], mr[0..216]);
    all = up_row("A's version 0.1.2 with build 9000 (version below 0.1.3)", 5, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;

    // size out of range, honestly signed
    uh_make_manifest(ida[0..208], 0, 1, 3, 4321, 210763776, sha[0..32], mr[0..216]);
    all = up_row("size 201 MiB", 6, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 3, 4321, 1048575, sha[0..32], mr[0..216]);
    all = up_row("size 1 MiB minus 1 byte", 6, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 3, 4321, 209715200, sha[0..32], mr[0..216]);
    all = up_row("size exactly 200 MiB (the limit is allowed)", 0, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    all = up_row("manifest with build 0 is not even made (0 bytes)", 0, @as(u32, @intCast(uh_make_manifest(ida[0..208], 0, 1, 3, 0, 2097152, sha[0..32], mr[0..216])))) and all;

    // the file against the manifest (0 = the file is what the manifest says, 11 = it is not)
    all = up_row("bundle file matches the manifest (size and SHA-256)", 0, up_fcode(m[0..216], path[0..128])) and all;
    up_write_file(path[0..128], size, 1000000);
    all = up_row("one byte of the bundle changed after the manifest", 11, up_fcode(m[0..216], path[0..128])) and all;
    up_write_file(path[0..128], size - 1, 99999999);
    all = up_row("bundle one byte short", 11, up_fcode(m[0..216], path[0..128])) and all;
    sys_unlink(path[0..128]);
    all = up_row("bundle file missing", 11, up_fcode(m[0..216], path[0..128])) and all;

    // one update at a time
    var st : u32 = st_next(ST_IDLE, EV_START);
    all = up_row("start while idle -> fetching", ST_FETCHING, st) and all;
    all = up_row("second start while fetching is refused", ST_REJECT, st_next(st, EV_START)) and all;
    return all;
}

fn up_fcode(m: []const u8, path: []const u8) -> u32 {
    if (uh_file_matches(m, path)) { return 0; }
    return 11;
}

/// Flip one byte of the good manifest and say what the check makes of it.
fn up_flip(m: []const u8, ft: []const u8, own: []const u8, at: usize, want: u32, label: []const u8) -> bool {
    var t : [216]u8 = undefined;
    var i : usize = 0;
    while (i < 216) {
        t[i] = m[i];
        i = i + 1;
    }
    t[at] = t[at] ^ 1;
    return up_row(label, want, uh_check_manifest(t[0..216], ft, own, um_pack(0, 1, 3), 4311));
}

// ---------------------------------------------------------------- roles: announce / browse

fn up_print_name(e: u64) -> void {
    var nb : [64]u8 = undefined;
    var i : usize = 0;
    var n : usize = 0;
    while (i < 64) {
        nb[i] = @as(u8, @intCast(up_peek8(e + BE_NAME + i)));
        if (nb[i] == 0) { break; }
        n = n + 1;
        i = i + 1;
    }
    sys_write(1, nb[0..n], @as(u64, n));
}

fn up_poke(dst: u64, src: []const u8, n: u64) -> u64 { return @extern("memmove"); }

fn up_poke_state(e: u64, v: u32) -> void {
    var c : [4]u8 = undefined;
    c[0] = @as(u8, @intCast(v & 255));
    c[1] = 0;
    c[2] = 0;
    c[3] = 0;
    up_poke(e + BE_STATE, c[0..4], 4);
}

fn up_run(announce: bool, browse: bool) -> bool {
    var all : bool = true;
    var nickb : [32]u8 = undefined;
    var nn : usize = up_env("UP_NICK", nickb[0..32]);
    if (nn == 0) {
        nickb[0] = 116;
        nickb[1] = 50;
        nickb[2] = 55;
        nickb[3] = 111;
        nickb[4] = 115;
        nn = 5;
    }
    if (nn > NICK_MAX) { nn = NICK_MAX; }
    const secs : u64 = up_env_num("UP_SECONDS", 8);
    const port : u32 = @as(u32, @intCast(up_env_num("UP_PORT", 47741)));
    const my_ver : u64 = up_env_version();
    const my_build : u32 = @as(u32, @intCast(up_env_num("UP_BUILD", 4321)));
    var rref : [8]u8 = undefined;
    var bref : [8]u8 = undefined;
    put_u64(rref[0..8], 0, 0);
    put_u64(bref[0..8], 0, 0);
    var res : [72]u8 = undefined;
    var block : [4112]u8 = undefined;
    var clo : [160]u8 = undefined;
    var refs : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 72) {
        res[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 4112) {
        block[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 160) {
        clo[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 256) {
        refs[i] = 0;
        i = i + 1;
    }
    const block_at : u64 = ih_addr(block[0..4112]);
    var fp : [10]u8 = undefined;
    var inv : [25]u8 = undefined;
    var txt0 : [96]u8 = undefined;
    var txt : [96]u8 = undefined;
    var txn : usize = 0;
    var name : [64]u8 = undefined;
    var code : u64 = 0;
    if (announce) {
        var id : [208]u8 = undefined;
        const r : u32 = ih_identity_open(nickb[0..32], nn, id[0..208], fp[0..10]);
        all = up_ok("identity opened (created or loaded)", r == IH_CREATED or r == IH_LOADED) and all;
        if (r != IH_CREATED and r != IH_LOADED) { return false; }
        invite_make(fp[0..10], inv[0..25]);
        up_say("MY INVITE ");
        sys_write(1, inv[0..25], 25);
        up_say("\n");
        const n0 : usize = txt_build(inv[0..25], port, nickb[0..32], nn, txt0[0..96]);
        txn = upd_txt_add(txt0[0..96], n0, up_part(my_ver, 2), up_part(my_ver, 1), up_part(my_ver, 0), my_build, txt[0..96]);
        all = up_ok("TXT record built with ver and build", n0 > 0 and txn > n0) and all;
        up_say("TXT announced (");
        up_dec(@as(u64, txn));
        up_say(" bytes): ver=");
        up_dec(@as(u64, up_part(my_ver, 2)));
        up_say(".");
        up_dec(@as(u64, up_part(my_ver, 1)));
        up_say(".");
        up_dec(@as(u64, up_part(my_ver, 0)));
        up_say(" build=");
        up_dec(@as(u64, my_build));
        up_say("\n");
        var nl : usize = up_env("UP_NAME", name[0..64]);
        if (nl == 0) {
            i = 0;
            while (i < nn) {
                name[i] = nickb[i];
                i = i + 1;
            }
            name[nn] = 0;
        }
        const rc : i32 = ih_register(rref[0..8], name[0..64], port, txt[0..96], txn, res[0..72]);
        all = up_ok("DNSServiceRegister taken", rc == 0) and all;
    }
    if (browse) {
        code = ih_resolve_closure(clo[0..160]);
        all = up_ok("libffi closure for the resolve callback", code != 0) and all;
        const bc : i32 = ih_browse(bref[0..8], block_at);
        all = up_ok("DNSServiceBrowse taken", bc == 0) and all;
    }
    const start : u64 = up_now_ms();
    const end : u64 = start + secs * 1000;
    var acked : bool = false;
    while (up_now_ms() < end) {
        if (announce) {
            ih_pump(get_u64(rref[0..8], 0), 0);
            if (up_peek32(ih_addr(res[0..72])) == 1) { acked = true; }
        }
        if (browse) {
            ih_pump(get_u64(bref[0..8], 0), 0);
            var k : usize = 0;
            while (k < BR_COUNT) {
                const e : u64 = ih_entry(block_at, k);
                const st : u32 = up_peek32(e + BE_STATE);
                const rs : u64 = get_u64(refs[0..256], k * 16);
                if (st == BS_NEW and rs == 0) {
                    var rb : [8]u8 = undefined;
                    if (ih_resolve(rb[0..8], e, code) == 0) {
                        put_u64(refs[0..256], k * 16, get_u64(rb[0..8], 0));
                        up_poke_state(e, BS_RESOLVING);
                    }
                }
                if (st == BS_RESOLVING and rs != 0) { ih_pump(rs, 0); }
                k = k + 1;
            }
        }
        ih_sleep_ms(40);
    }
    if (announce) {
        all = up_ok("announcement acknowledged by the daemon with error 0", acked and up_peek32(ih_addr(res[0..72]) + 4) == 0) and all;
    }
    var seen_ver : u32 = 0;
    if (browse) {
        var k2 : usize = 0;
        while (k2 < BR_COUNT) {
            const e : u64 = ih_entry(block_at, k2);
            const st : u32 = up_peek32(e + BE_STATE);
            if (st >= BS_RESOLVED) {
                up_say("SERVICE name=");
                up_print_name(e);
                up_say(" host=");
                var hb : [44]u8 = undefined;
                var h : usize = 0;
                var hl : usize = 0;
                while (h < 44) {
                    hb[h] = @as(u8, @intCast(up_peek8(e + BE_HOST + h)));
                    if (hb[h] == 0) { break; }
                    hl = hl + 1;
                    h = h + 1;
                }
                sys_write(1, hb[0..hl], @as(u64, hl));
                up_say(" port=");
                up_dec(@as(u64, up_peek32(e + BE_PORT)));
                var tb : [128]u8 = undefined;
                var z : usize = 0;
                while (z < 128) {
                    tb[z] = @as(u8, @intCast(up_peek8(e + BE_TXT + z)));
                    z = z + 1;
                }
                const tl : usize = @as(usize, up_peek32(e + BE_TXTLEN));
                const nv : u64 = upd_txt_version(tb[0..128], tl);
                const nb2 : u32 = upd_txt_build(tb[0..128], tl);
                up_say(" txt_len=");
                up_dec(@as(u64, tl));
                if (nv == NO_VERSION) {
                    up_say(" ver=NONE");
                } else {
                    up_say(" ver=");
                    up_dec(@as(u64, up_part(nv, 2)));
                    up_say(".");
                    up_dec(@as(u64, up_part(nv, 1)));
                    up_say(".");
                    up_dec(@as(u64, up_part(nv, 0)));
                    seen_ver = seen_ver + 1;
                }
                up_say(" build=");
                if (nb2 == 0) { up_say("NONE"); } else { up_dec(@as(u64, nb2)); }
                if (upd_neighbour_newer(tb[0..128], tl, my_ver, my_build)) { up_say(" NEWER_THAN_ME"); }
                up_say("\n");
            }
            k2 = k2 + 1;
        }
        up_say("services resolved with ver and build: ");
        up_dec(@as(u64, seen_ver));
        up_say("\n");
        all = up_ok("at least one service shows ver and build in its TXT", seen_ver > 0) and all;
    }
    var q2 : usize = 0;
    while (q2 < BR_COUNT) {
        ih_free(get_u64(refs[0..256], q2 * 16));
        q2 = q2 + 1;
    }
    ih_free(get_u64(bref[0..8], 0));
    ih_free(get_u64(rref[0..8], 0));
    return all;
}

/// part 2 = major, 1 = minor, 0 = patch of a packed version
fn up_part(v: u64, which: u32) -> u32 {
    if (which == 2) { return @as(u32, @intCast((v >> 40) & 1048575)); }
    if (which == 1) { return @as(u32, @intCast((v >> 20) & 1048575)); }
    return @as(u32, @intCast(v & 1048575));
}

pub fn main() -> void {
    var rb : [16]u8 = undefined;
    const rn : usize = up_env("UP_ROLE", rb[0..16]);
    var ok : bool = false;
    if (rn == 8 and rb[0] == 97) {
        up_say("update probe: announce\n");
        ok = up_run(true, false);
    } else if (rn == 6 and rb[0] == 98) {
        up_say("update probe: browse\n");
        ok = up_run(false, true);
    } else if (rn == 4 and rb[0] == 98) {
        up_say("update probe: both\n");
        ok = up_run(true, true);
    } else {
        up_say("update probe: table\n");
        ok = up_table();
    }
    if (ok) {
        up_say("ALL CHECKS PASSED\n");
        sys_exit(0);
    }
    up_say("SOME CHECKS FAILED\n");
    sys_exit(1);
}
