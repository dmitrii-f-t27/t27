// SPDX-License-Identifier: Apache-2.0
// specs/t27os/callback_probe.t27 -- can the OS call back into a t27b fn? Evidence for the in-OS call audio
// (owner, 2026-10-21: avatar calls inside T27 OS, no servers). Every streaming audio API on macOS (AudioQueue,
// AudioUnit, AVAudioEngine) hands its buffers to a C callback, and the language cannot take a fn's address.
// t27b does export every all-scalar fn as the global `_<name>` (cli/t27b/README.md, "exported"), and the window
// is linked with no export list, so dlsym(RTLD_DEFAULT, "<name>") may return that fn's address. This program
// checks exactly that, three ways, and prints one line per check. Not part of the app.
//   1. libc qsort sorts 8 bytes with cbp_cmp, reached only through its dlsym address (a synchronous callback).
//   2. A CFRunLoop timer calls cbp_tick on this thread while CFRunLoopRunInMode runs: the shape an AudioQueue
//      created with the main run loop would use, so a callback never runs on another thread.
//   3. An AudioQueue output queue with cbp_out as its callback, run on this run loop for 0.3 s. It never decides
//      the exit code and prints AUDIO VERIFIED, AUDIO UNVERIFIED or AUDIO SKIP. Exit 0 says nothing about
//      audio: playback, capture and duplex audio need their own acceptance on a Mac with devices.
// Build (Apple silicon):
//   t27b build specs/t27os/callback_probe.t27 -o probe.o --macho
//   ld -arch arm64 -platform_version macos 11.0 $(xcrun --show-sdk-version) -syslibroot $(xcrun --show-sdk-path) \
//      -e _main -lSystem -framework CoreFoundation -framework AudioToolbox -o probe probe.o
// Step 4 (ABI probe): part A is a 10 ms timer for 10 s with first/last time marks; part B is a 440 Hz tone, 10 ms
// buffers (960 bytes, 48 kHz mono 16 bit), 4 buffers, 60 s, callbacks counted. Exits 0 only when the direct calls and checks 1 and 2 pass. ASCII only (L3).
// Part C (capture): an AudioQueue INPUT queue, same format and buffers, cbp_in on this run loop for 10 s; prints
// the NewInput and Start statuses, callbacks, nonzero samples, mean |sample| and the first 4 bytes. It never
// decides the exit code of the full run. On macOS a microphone denied by TCC usually does not fail NewInput or
// Start: the queue runs and delivers zero samples, so the verdict comes from the samples, not the statuses.
// CBP_ONLY_C=1 skips A and B (no 60 s tone); then the exit code is 0 only when C ran with callbacks.
// Part D (foreign thread): an AudioQueue OUTPUT queue created with inCallbackRunLoop = NULL, so the system calls
// cbp_outd on a thread of its own while main sleeps. Same 440 Hz format and buffers, 10 s. The state block holds a
// magic and its own address; every call checks both, counts calls and integrity errors, and compares pthread_self
// with the main thread's. CBP_ONLY_D=1 runs only D, and then the exit code is 0 only when D ran clean on another
// thread. This is the precondition for VoiceProcessingIO, whose render callback runs on a realtime thread.
// Part E (duplex loop): an input and an output queue at once, both on this run loop, joined by a ring of 8 slots
// of 960 bytes in one preallocated block (no allocation in a callback). cbp_ein copies each captured buffer into
// the next slot or counts an overrun; cbp_eout plays the oldest slot or zeros and counts an underrun. The output
// volume is set to 0.05 and read back before the output starts (no start otherwise), against acoustic feedback.
// Both queues start together; the output plays warm-up silence (counted apart from underruns) until the ring
// holds 2 slots, keeps 3 buffers in flight, and runs exactly 20 s. It prints
// statuses, callbacks, underruns, overruns, bytes, checksums, time marks, ring residence and a latency estimate.
// CBP_ONLY_E=1 runs only E; the exit code is 0 only for a clean loop.

module T27osCallbackProbe;

use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_exit;
use t27os::pty_sys::sys_peek;
use t27os::pty_sys::sys_addr;
use t27os::pty_proto::put_u64;
use t27os::pty_proto::get_u64;
use t27os::pty_sys::sys_getenv;

const CBP_RTLD_DEFAULT : u64 = 18446744073709551614;
/// kAudioFormatLinearPCM, 'lpcm'.
const CBP_LPCM : u32 = 1819304813;
/// kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked.
const CBP_PCM_FLAGS : u32 = 12;

fn cbp_dlsym(h: u64, name: []const u8) -> u64 { return @extern("dlsym"); }
/// memmove with a raw destination address: copy n bytes of src to memory at dst.
fn cbp_poke(dst: u64, src: []const u8, n: u64) -> u64 { return @extern("memmove"); }
fn cbp_qsort(base: []u8, n: u64, width: u64, cmp: u64) -> void { @extern("qsort"); }
fn cbp_rl_current() -> u64 { return @extern("CFRunLoopGetCurrent"); }
fn cbp_now() -> f64 { return @extern("CFAbsoluteTimeGetCurrent"); }
fn cbp_timer_create(alloc: u64, fire: f64, every: f64, flags: u64, order: i64, callout: u64, ctx: []const u8) -> u64 { return @extern("CFRunLoopTimerCreate"); }
fn cbp_add_timer(rl: u64, timer: u64, mode: u64) -> void { @extern("CFRunLoopAddTimer"); }
fn cbp_run(mode: u64, seconds: f64, after_one: bool) -> i32 { return @extern("CFRunLoopRunInMode"); }
fn cbp_timer_invalidate(timer: u64) -> void { @extern("CFRunLoopTimerInvalidate"); }
fn cbp_release(x: u64) -> void { @extern("CFRelease"); }
fn cbp_aq_new_output(fmt: []const u8, cb: u64, user: u64, rl: u64, mode: u64, flags: u32, out_aq: []u8) -> i32 { return @extern("AudioQueueNewOutput"); }
fn cbp_aq_new_input(fmt: []const u8, cb: u64, user: u64, rl: u64, mode: u64, flags: u32, out_aq: []u8) -> i32 { return @extern("AudioQueueNewInput"); }
fn cbp_aq_alloc(aq: u64, size: u32, out_buf: []u8) -> i32 { return @extern("AudioQueueAllocateBuffer"); }
fn cbp_aq_enqueue(aq: u64, buf: u64, n: u32, descs: u64) -> i32 { return @extern("AudioQueueEnqueueBuffer"); }
fn cbp_aq_start(aq: u64, at: u64) -> i32 { return @extern("AudioQueueStart"); }
fn cbp_sin(x: f64) -> f64 { return @extern("sin"); }
fn cbp_aq_dispose(aq: u64, now: bool) -> i32 { return @extern("AudioQueueDispose"); }
fn cbp_thread() -> u64 { return @extern("pthread_self"); }
fn cbp_is_main() -> i32 { return @extern("pthread_main_np"); }
fn cbp_usleep(us: u32) -> i32 { return @extern("usleep"); }
fn cbp_aq_set_param(aq: u64, id: u32, v: f32) -> i32 { return @extern("AudioQueueSetParameter"); }
fn cbp_aq_get_param(aq: u64, id: u32, out: []u8) -> i32 { return @extern("AudioQueueGetParameter"); }
/// memcpy and bzero between raw addresses (the ring and the AudioQueue buffers); no allocation.
fn cbp_copy(dst: u64, src: u64, n: u64) -> u64 { return @extern("memcpy"); }
fn cbp_zero(dst: u64, n: u64) -> void { @extern("bzero"); }

/// Part D magic, 0x5432374400000D27 ("T27D" over 0x0D27).
const CBP_D_MAGIC : u64 = 6066972413218786599;

fn cbp_get(at: u64) -> u64 {
    var c : [8]u8 = undefined;
    sys_peek(c[0..8], at, 8);
    return get_u64(c[0..8], 0);
}

fn cbp_put(at: u64, v: u64) -> void {
    var c : [8]u8 = undefined;
    put_u64(c[0..8], 0, v);
    cbp_poke(at, c[0..8], 8);
}

/// Microseconds on the CF absolute clock.
fn cbp_us() -> u64 { return @as(u64, @intFromFloat(cbp_now() * 1000000.0)); }

/// qsort comparator. a and b are the addresses of two 1-byte elements.
pub fn cbp_cmp(a: u64, b: u64) -> i32 {
    var x : [1]u8 = undefined;
    var y : [1]u8 = undefined;
    sys_peek(x[0..1], a, 1);
    sys_peek(y[0..1], b, 1);
    return @as(i32, @intCast(x[0])) - @as(i32, @intCast(y[0]));
}

/// State block at `st` (u64 slots): 0 count, 1 info as received, 2 magic, 3 first us, 4 last us, 5 sample index.
/// CFRunLoopTimer callout (timer, info): info is the address of the state block.
pub fn cbp_tick(timer: u64, info: u64) -> u64 {
    const n : u64 = cbp_get(info) + 1;
    cbp_put(info, n);
    cbp_put(info + 8, info);
    const t : u64 = cbp_us();
    if (n == 1) { cbp_put(info + 24, t); }
    cbp_put(info + 32, t);
    return n;
}

/// Fill the AudioQueue buffer with 480 samples (10 ms) of 440 Hz and enqueue it.
fn cbp_fill(st: u64, aq: u64, buf: u64) -> i32 {
    var pcm : [960]u8 = undefined;
    const base : u64 = cbp_get(st + 40);
    var i : usize = 0;
    while (i < 480) {
        const ph : f64 = 6.283185307179586 * 440.0 * @as(f64, @floatFromInt(base + @as(u64, i))) / 48000.0;
        const v : i32 = @as(i32, @intFromFloat(cbp_sin(ph) * 8000.0)) + 32768;
        pcm[i * 2] = @as(u8, @intCast(v & 255));
        pcm[i * 2 + 1] = @as(u8, @intCast((v >> 8) & 255)) ^ 128;
        i = i + 1;
    }
    cbp_put(st + 40, base + 480);
    cbp_poke(cbp_get(buf + 8), pcm[0..960], 960);
    var sz : [4]u8 = undefined;
    sz[0] = 192; sz[1] = 3; sz[2] = 0; sz[3] = 0;
    cbp_poke(buf + 16, sz[0..4], 4);
    return cbp_aq_enqueue(aq, buf, 0, 0);
}

/// AudioQueue output callback (user, queue, buffer): user is the address of the state block.
pub fn cbp_out(user: u64, aq: u64, buf: u64) -> u64 {
    const n : u64 = cbp_get(user) + 1;
    cbp_put(user, n);
    const t : u64 = cbp_us();
    if (n == 1) { cbp_put(user + 24, t); }
    cbp_put(user + 32, t);
    cbp_fill(user, aq, buf);
    return n;
}

/// Part D state block (u64 slots): 0 calls, 1 own address, 2 magic, 3 first us, 4 last us, 5 sample index,
/// 6 integrity errors, 7 main pthread, 8 first callback pthread, 9 calls on the main pthread,
/// 10 calls where pthread_main_np != 0, 11 failed enqueues.
/// AudioQueue output callback for a queue with no run loop: runs on a system thread.
pub fn cbp_outd(user: u64, aq: u64, buf: u64) -> u64 {
    if (cbp_get(user + 16) != CBP_D_MAGIC or cbp_get(user + 8) != user) {
        cbp_put(user + 48, cbp_get(user + 48) + 1);
        return 0;
    }
    const n : u64 = cbp_get(user) + 1;
    cbp_put(user, n);
    const t : u64 = cbp_us();
    const th : u64 = cbp_thread();
    if (n == 1) { cbp_put(user + 24, t); cbp_put(user + 64, th); }
    cbp_put(user + 32, t);
    if (th == cbp_get(user + 56)) { cbp_put(user + 72, cbp_get(user + 72) + 1); }
    if (cbp_is_main() != 0) { cbp_put(user + 80, cbp_get(user + 80) + 1); }
    if (cbp_fill(user, aq, buf) != 0) { cbp_put(user + 88, cbp_get(user + 88) + 1); }
    return n;
}

/// Capture state block (u64 slots): 0 callbacks, 1 first 4 bytes, 2 first-buffer flag, 3 first us, 4 last us,
/// 5 samples, 6 nonzero samples, 7 sum of |sample|, 8 bytes, 9 failed re-enqueues, 10 max |sample|.
/// AudioQueue input callback (user, queue, buffer, start time, packet count, packet descs).
pub fn cbp_in(user: u64, aq: u64, buf: u64, ts: u64, npk: u32, pd: u64) -> u64 {
    const n : u64 = cbp_get(user) + 1;
    cbp_put(user, n);
    const t : u64 = cbp_us();
    if (n == 1) { cbp_put(user + 24, t); }
    cbp_put(user + 32, t);
    var hd : [4]u8 = undefined;
    sys_peek(hd[0..4], buf + 16, 4);
    var sz : u64 = @as(u64, @intCast(hd[0])) | (@as(u64, @intCast(hd[1])) << 8) | (@as(u64, @intCast(hd[2])) << 16) | (@as(u64, @intCast(hd[3])) << 24);
    if (sz > 960) { sz = 960; }
    var pcm : [960]u8 = undefined;
    const data : u64 = cbp_get(buf + 8);
    if (data == 0) { sz = 0; }
    if (sz > 0) { sys_peek(pcm[0..960], data, sz); }
    if (n == 1 and sz >= 4) {
        cbp_put(user + 8, @as(u64, @intCast(pcm[0])) | (@as(u64, @intCast(pcm[1])) << 8) | (@as(u64, @intCast(pcm[2])) << 16) | (@as(u64, @intCast(pcm[3])) << 24));
        cbp_put(user + 16, 1);
    }
    var nz : u64 = 0;
    var sum : u64 = 0;
    var mx : u64 = cbp_get(user + 80);
    var i : u64 = 0;
    while (i < sz / 2) {
        var v : i64 = @as(i64, @intCast(pcm[i * 2])) | (@as(i64, @intCast(pcm[i * 2 + 1])) << 8);
        if (v >= 32768) { v = v - 65536; }
        if (v < 0) { v = 0 - v; }
        const a : u64 = @as(u64, @intCast(v));
        if (a != 0) { nz = nz + 1; }
        if (a > mx) { mx = a; }
        sum = sum + a;
        i = i + 1;
    }
    cbp_put(user + 40, cbp_get(user + 40) + sz / 2);
    cbp_put(user + 48, cbp_get(user + 48) + nz);
    cbp_put(user + 56, cbp_get(user + 56) + sum);
    cbp_put(user + 64, cbp_get(user + 64) + sz);
    cbp_put(user + 80, mx);
    if (cbp_aq_enqueue(aq, buf, 0, 0) != 0) { cbp_put(user + 72, cbp_get(user + 72) + 1); }
    return n;
}

/// Part E ring: 8 slots of 960 bytes after a 448-byte header of u64 slots:
/// 0 in calls, 1 out calls, 2 slots written, 3 slots read, 4 underruns, 5 overruns, 6 bytes into the ring,
/// 7 bytes out of the ring, 8 first in us, 9 last in us, 10 first out us, 11 last out us, 12 ring base,
/// 13 sum of fill at out calls, 14 max fill, 15 failed in enqueues, 16 failed out enqueues, 17 bytes dropped,
/// 18 bytes received by input, 19 age sum us, 20 age max us, 21 age min us, 22 checksum mismatches,
/// 23 checksum sum in, 24 checksum sum out, 25 nonzero samples out, 26 magic, 27 stopping, 28 zero bytes out,
/// 29 min fill at out calls, 30 max out interval us, 31 max in interval us,
/// 32..39 slot sizes, 40..47 slot write us, 48..55 slot checksums, 56 warming, 57 warm-up silent buffers,
/// 58 warm-up end us.
const CBP_E_SLOTS : u64 = 8;
const CBP_E_HDR : u64 = 472;
const CBP_E_BYTES : usize = 8152;
/// While warming, the output plays silence (not an underrun) until the ring holds this many slots; output buffers in flight.
const CBP_E_PRE : u64 = 2;
const CBP_E_OUTBUFS : u32 = 3;
/// kAudioQueueParam_Volume, and the bits of 0.04f / 0.06f (the accepted read-back range of 0.05f).
const CBP_VOLUME : u32 = 1;
const CBP_VOL_LO : u64 = 1025758986;
const CBP_VOL_HI : u64 = 1031127695;

fn cbp_inc(at: u64, by: u64) -> void { cbp_put(at, cbp_get(at) + by); }
fn cbp_emax(at: u64, v: u64) -> void { if (v > cbp_get(at)) { cbp_put(at, v); } }
fn cbp_emin(at: u64, v: u64) -> void { if (v < cbp_get(at)) { cbp_put(at, v); } }

/// Position-weighted byte checksum of n bytes at addr (n <= 960).
fn cbp_sum(addr: u64, n: u64) -> u64 {
    var b : [960]u8 = undefined;
    if (n == 0) { return 0; }
    sys_peek(b[0..960], addr, n);
    var s : u64 = 0;
    var i : u64 = 0;
    while (i < n) { s = s + (@as(u64, @intCast(b[i])) + 1) * (i + 1); i = i + 1; }
    return s;
}

/// Nonzero 16-bit samples in n bytes at addr.
fn cbp_nz(addr: u64, n: u64) -> u64 {
    var b : [960]u8 = undefined;
    if (n == 0) { return 0; }
    sys_peek(b[0..960], addr, n);
    var c : u64 = 0;
    var i : u64 = 0;
    while (i + 1 < n) { if (b[i] != 0 or b[i + 1] != 0) { c = c + 1; } i = i + 2; }
    return c;
}

/// Ring and its slot tables are the block itself; the header geometry must fit the declared size.
fn cbp_e_size() -> u64 { return CBP_E_HDR + CBP_E_SLOTS * 960; }

/// Part E input callback: copy the captured buffer into the next ring slot, or count an overrun and drop it.
pub fn cbp_ein(user: u64, aq: u64, buf: u64, ts: u64, npk: u32, pd: u64) -> u64 {
    if (cbp_get(user + 216) != 0) { return 0; }
    const n : u64 = cbp_get(user) + 1;
    cbp_put(user, n);
    const t : u64 = cbp_us();
    if (n == 1) { cbp_put(user + 64, t); } else { cbp_emax(user + 248, t - cbp_get(user + 72)); }
    cbp_put(user + 72, t);
    var hd : [4]u8 = undefined;
    sys_peek(hd[0..4], buf + 16, 4);
    var sz : u64 = @as(u64, @intCast(hd[0])) | (@as(u64, @intCast(hd[1])) << 8) | (@as(u64, @intCast(hd[2])) << 16) | (@as(u64, @intCast(hd[3])) << 24);
    if (sz > 960) { sz = 960; }
    const data : u64 = cbp_get(buf + 8);
    if (data == 0) { sz = 0; }
    cbp_inc(user + 144, sz);
    const w : u64 = cbp_get(user + 16);
    const r : u64 = cbp_get(user + 24);
    if (w - r >= CBP_E_SLOTS) {
        cbp_inc(user + 40, 1);
        cbp_inc(user + 136, sz);
    } else {
        const slot : u64 = w % CBP_E_SLOTS;
        const dst : u64 = cbp_get(user + 96) + slot * 960;
        if (sz > 0) { cbp_copy(dst, data, sz); }
        const cs : u64 = cbp_sum(dst, sz);
        cbp_put(user + 256 + slot * 8, sz);
        cbp_put(user + 320 + slot * 8, t);
        cbp_put(user + 384 + slot * 8, cs);
        cbp_put(user + 16, w + 1);
        cbp_inc(user + 48, sz);
        cbp_inc(user + 184, cs);
        cbp_emax(user + 112, w + 1 - r);
    }
    if (cbp_aq_enqueue(aq, buf, 0, 0) != 0) { cbp_inc(user + 120, 1); }
    return n;
}

/// Fill one output buffer from the ring (zeros and an underrun when it is empty) and enqueue it.
fn cbp_epull(user: u64, aq: u64, buf: u64) -> i32 {
    const data : u64 = cbp_get(buf + 8);
    if (data == 0) { return -1; }
    const w : u64 = cbp_get(user + 16);
    const r : u64 = cbp_get(user + 24);
    if (cbp_get(user + 448) != 0 and w - r >= CBP_E_PRE) {
        cbp_put(user + 448, 0);
        cbp_put(user + 464, cbp_us());
    }
    if (cbp_get(user + 448) != 0) {
        cbp_zero(data, 960);
        cbp_inc(user + 456, 1);
    } else if (w == r) {
        cbp_zero(data, 960);
        cbp_inc(user + 32, 1);
        cbp_inc(user + 224, 960);
    } else {
        const slot : u64 = r % CBP_E_SLOTS;
        const sz : u64 = cbp_get(user + 256 + slot * 8);
        if (sz > 0) { cbp_copy(data, cbp_get(user + 96) + slot * 960, sz); }
        if (sz < 960) { cbp_zero(data + sz, 960 - sz); }
        const cs : u64 = cbp_sum(data, sz);
        if (cs != cbp_get(user + 384 + slot * 8)) { cbp_inc(user + 176, 1); }
        cbp_inc(user + 192, cs);
        cbp_inc(user + 200, cbp_nz(data, sz));
        const age : u64 = cbp_us() - cbp_get(user + 320 + slot * 8);
        cbp_inc(user + 152, age);
        cbp_emax(user + 160, age);
        cbp_emin(user + 168, age);
        cbp_inc(user + 56, sz);
        cbp_put(user + 24, r + 1);
    }
    var sz4 : [4]u8 = undefined;
    sz4[0] = 192; sz4[1] = 3; sz4[2] = 0; sz4[3] = 0;
    cbp_poke(buf + 16, sz4[0..4], 4);
    return cbp_aq_enqueue(aq, buf, 0, 0);
}

/// Part E output callback (user, queue, buffer).
pub fn cbp_eout(user: u64, aq: u64, buf: u64) -> u64 {
    if (cbp_get(user + 216) != 0) { return 0; }
    const n : u64 = cbp_get(user + 8) + 1;
    cbp_put(user + 8, n);
    const t : u64 = cbp_us();
    if (n == 1) { cbp_put(user + 80, t); } else { cbp_emax(user + 240, t - cbp_get(user + 88)); }
    cbp_put(user + 88, t);
    const fill : u64 = cbp_get(user + 16) - cbp_get(user + 24);
    cbp_inc(user + 104, fill);
    cbp_emin(user + 232, fill);
    if (cbp_epull(user, aq, buf) != 0) { cbp_inc(user + 128, 1); }
    return n;
}

fn say_line(s: []const u8) -> void { sys_write(1, s, @as(u64, s.len)); }

fn say_u(label: []const u8, v: u64) -> void { say_num(label, @as(i64, @intCast(v))); }

/// Part E: microphone -> ring -> speakers, both queues on this run loop, output volume 0.05, 20 s.
fn cbp_part_e(mode: u64, fmt: []const u8) -> bool {
    var blk : [8152]u8 = undefined;
    var z : usize = 0;
    while (z < CBP_E_BYTES) { blk[z] = 0; z = z + 1; }
    const pe : u64 = sys_addr(blk[0..8152], blk[0..8152], 0);
    cbp_put(pe + 96, pe + CBP_E_HDR);
    cbp_put(pe + 168, 18446744073709551615);
    cbp_put(pe + 232, 18446744073709551615);
    cbp_put(pe + 208, CBP_D_MAGIC);
    cbp_put(pe + 448, 1);
    const fin : u64 = cbp_dlsym(CBP_RTLD_DEFAULT, "cbp_ein");
    const fout : u64 = cbp_dlsym(CBP_RTLD_DEFAULT, "cbp_eout");
    say("dlsym finds cbp_ein and cbp_eout", fin != 0 and fout != 0);
    if (fin == 0 or fout == 0 or mode == 0) { return false; }
    var aqi : [8]u8 = undefined;
    var aqo : [8]u8 = undefined;
    put_u64(aqi[0..8], 0, 0);
    put_u64(aqo[0..8], 0, 0);
    const s_in : i32 = cbp_aq_new_input(fmt, fin, pe, cbp_rl_current(), mode, 0, aqi[0..8]);
    say_num("E AudioQueueNewInput status: ", @as(i64, s_in));
    const s_out : i32 = cbp_aq_new_output(fmt, fout, pe, cbp_rl_current(), mode, 0, aqo[0..8]);
    say_num("E AudioQueueNewOutput status: ", @as(i64, s_out));
    const qi : u64 = get_u64(aqi[0..8], 0);
    const qo : u64 = get_u64(aqo[0..8], 0);
    var vol_ok : bool = false;
    if (s_out == 0 and qo != 0) {
        const s_vol : i32 = cbp_aq_set_param(qo, CBP_VOLUME, 0.05);
        say_num("E AudioQueueSetParameter(Volume, 0.05) status: ", @as(i64, s_vol));
        var vb : [4]u8 = undefined;
        vb[0] = 0; vb[1] = 0; vb[2] = 0; vb[3] = 0;
        const s_get : i32 = cbp_aq_get_param(qo, CBP_VOLUME, vb[0..4]);
        const bits : u64 = @as(u64, @intCast(vb[0])) | (@as(u64, @intCast(vb[1])) << 8) | (@as(u64, @intCast(vb[2])) << 16) | (@as(u64, @intCast(vb[3])) << 24);
        say_num("E AudioQueueGetParameter(Volume) status: ", @as(i64, s_get));
        say_u("E volume read back, f32 bits (0.05f = 1028443341): ", bits);
        vol_ok = s_vol == 0 and s_get == 0 and bits >= CBP_VOL_LO and bits <= CBP_VOL_HI;
    }
    say("E output volume reads back within 0.04..0.06", vol_ok);
    var started_in : bool = false;
    var started_out : bool = false;
    var in_q : u32 = 0;
    var out_q : u32 = 0;
    var t0 : u64 = 0;
    var t_out : u64 = 0;
    if (s_in == 0 and qi != 0 and vol_ok) {
        var m : u32 = 0;
        while (m < 4) {
            var b : [8]u8 = undefined;
            put_u64(b[0..8], 0, 0);
            if (cbp_aq_alloc(qi, 960, b[0..8]) == 0) {
                if (cbp_aq_enqueue(qi, get_u64(b[0..8], 0), 0, 0) == 0) { in_q = in_q + 1; }
            }
            m = m + 1;
        }
        say_num("E input buffers enqueued: ", @as(i64, @intCast(in_q)));
        t0 = cbp_us();
        const s_si : i32 = cbp_aq_start(qi, 0);
        say_num("E input AudioQueueStart status: ", @as(i64, s_si));
        started_in = s_si == 0;
    }
    if (started_in) {
        var k : u32 = 0;
        while (k < CBP_E_OUTBUFS) {
            var b : [8]u8 = undefined;
            put_u64(b[0..8], 0, 0);
            if (cbp_aq_alloc(qo, 960, b[0..8]) == 0) {
                if (cbp_epull(pe, qo, get_u64(b[0..8], 0)) == 0) { out_q = out_q + 1; }
            }
            k = k + 1;
        }
        say_num("E output buffers primed (warm-up silence): ", @as(i64, @intCast(out_q)));
        t_out = cbp_us();
        const s_so : i32 = cbp_aq_start(qo, 0);
        say_num("E output AudioQueueStart status: ", @as(i64, s_so));
        started_out = s_so == 0;
    }
    if (started_out) {
        var sec : u32 = 0;
        while (sec < 20) {
            cbp_run(mode, 1.0, false);
            sys_write(1, "E t+", 4);
            say_num("s ", @as(i64, @intCast(sec + 1)));
            say_u("  in/out/under/over/fill: ", cbp_get(pe));
            say_u("                          ", cbp_get(pe + 8));
            say_u("                          ", cbp_get(pe + 32));
            say_u("                          ", cbp_get(pe + 40));
            say_u("                          ", cbp_get(pe + 16) - cbp_get(pe + 24));
            sec = sec + 1;
        }
    }
    const t_end : u64 = cbp_us();
    // Snapshot first, then stop: Dispose hands buffers back through the callbacks, which now return at once.
    cbp_put(pe + 216, 1);
    const n_in : u64 = cbp_get(pe);
    const n_out : u64 = cbp_get(pe + 8);
    const w : u64 = cbp_get(pe + 16);
    const r : u64 = cbp_get(pe + 24);
    const under : u64 = cbp_get(pe + 32);
    const over : u64 = cbp_get(pe + 40);
    var d_out : i32 = -1;
    var d_in : i32 = -1;
    if (s_out == 0 and qo != 0) { d_out = cbp_aq_dispose(qo, true); }
    if (s_in == 0 and qi != 0) { d_in = cbp_aq_dispose(qi, true); }
    say_num("E output AudioQueueDispose status: ", @as(i64, d_out));
    say_num("E input AudioQueueDispose status: ", @as(i64, d_in));
    if (!started_out) { say_line("E LOOP NOT RUN: a status above is nonzero or the volume did not read back\n"); return false; }
    say_u("E output run us (start to stop): ", t_end - t_out);
    say_u("E warm-up silent output buffers (not underruns): ", cbp_get(pe + 456));
    if (cbp_get(pe + 448) == 0) { say_num("E warm-up ended +us (from input start): ", @as(i64, @intCast(cbp_get(pe + 464) - t0))); }
    say_u("E input callbacks: ", n_in);
    say_u("E output callbacks: ", n_out);
    say_u("E underruns: ", under);
    say_u("E overruns: ", over);
    say_u("E failed input re-enqueues: ", cbp_get(pe + 120));
    say_u("E failed output enqueues: ", cbp_get(pe + 128));
    say_u("E bytes received by input: ", cbp_get(pe + 144));
    say_u("E bytes dropped on overrun: ", cbp_get(pe + 136));
    say_u("E bytes written into the ring: ", cbp_get(pe + 48));
    say_u("E bytes read out of the ring: ", cbp_get(pe + 56));
    say_u("E zero bytes played on underrun: ", cbp_get(pe + 224));
    var resid_b : u64 = 0;
    var resid_c : u64 = 0;
    var j : u64 = r;
    while (j < w) {
        resid_b = resid_b + cbp_get(pe + 256 + (j % CBP_E_SLOTS) * 8);
        resid_c = resid_c + cbp_get(pe + 384 + (j % CBP_E_SLOTS) * 8);
        j = j + 1;
    }
    say_u("E slots left in the ring at stop: ", w - r);
    say_u("E bytes left in the ring at stop: ", resid_b);
    const bytes_ok : bool = cbp_get(pe + 48) == cbp_get(pe + 56) + resid_b and cbp_get(pe + 144) == cbp_get(pe + 48) + cbp_get(pe + 136) and resid_b <= CBP_E_SLOTS * 960;
    say("E bytes: written = read + left in ring, received = written + dropped, left <= 7680", bytes_ok);
    say_u("E checksum mismatches (ring slot vs played buffer): ", cbp_get(pe + 176));
    const sum_ok : bool = cbp_get(pe + 176) == 0 and cbp_get(pe + 184) == cbp_get(pe + 192) + resid_c;
    say("E checksums: sum in = sum out + sum left in ring, no mismatch", sum_ok);
    say_u("E nonzero samples played from the ring: ", cbp_get(pe + 200));
    say_num("E first input callback +us (from input start): ", @as(i64, @intCast(cbp_get(pe + 64) - t0)));
    say_num("E last input callback +us: ", @as(i64, @intCast(cbp_get(pe + 72) - t0)));
    say_num("E first output callback +us (from input start): ", @as(i64, @intCast(cbp_get(pe + 80) - t0)));
    say_num("E last output callback +us: ", @as(i64, @intCast(cbp_get(pe + 88) - t0)));
    say_u("E max interval between input callbacks us: ", cbp_get(pe + 248));
    say_u("E max interval between output callbacks us: ", cbp_get(pe + 240));
    say_u("E ring fill: max slots: ", cbp_get(pe + 112));
    say_u("E ring fill: min slots at output callbacks: ", cbp_get(pe + 232));
    var fill100 : u64 = 0;
    if (n_out > 0) { fill100 = cbp_get(pe + 104) * 100 / n_out; }
    say_u("E ring fill: mean slots at output callbacks x100: ", fill100);
    var age_avg : u64 = 0;
    if (r > 0) { age_avg = cbp_get(pe + 152) / r; }
    say_u("E ring residence us: mean ", age_avg);
    say_u("E ring residence us: min ", cbp_get(pe + 168));
    say_u("E ring residence us: max ", cbp_get(pe + 160));
    // First sample: captured one buffer (10 ms) before the input callback, sits in the ring, then waits behind
    // the other output buffers in flight. Device input/output latency is not included.
    const lat : u64 = 10000 + age_avg + @as(u64, @intCast(CBP_E_OUTBUFS - 1)) * 10000;
    say_u("E estimated software latency us (10 ms in + ring mean + 20 ms out queue, no device latency): ", lat);
    const clean : bool = n_in >= 1900 and n_out >= 1900 and under == 0 and over == 0 and bytes_ok and sum_ok and cbp_get(pe + 120) == 0 and cbp_get(pe + 128) == 0 and d_out == 0 and d_in == 0;
    if (clean and cbp_get(pe + 200) > 0) {
        say_line("LOOP CLEAN: 20 s, no underrun, no overrun, bytes and checksums balance, microphone data played\n");
    } else if (clean) {
        say_line("LOOP CLEAN BUT SILENT: the ring balanced, every played sample is zero (TCC or muted input)\n");
    } else {
        say_line("LOOP NOT CLEAN: see the counters above\n");
    }
    return clean;
}

fn say(s: []const u8, ok: bool) -> bool {
    if (ok) { sys_write(1, "ok   ", 5); } else { sys_write(1, "FAIL ", 5); }
    sys_write(1, s, @as(u64, s.len));
    sys_write(1, "\n", 1);
    return ok;
}

/// One decimal line, "<label><n>".
fn say_num(label: []const u8, n: i64) -> void {
    var b : [24]u8 = undefined;
    var v : u64 = 0;
    var neg : bool = false;
    if (n < 0) { neg = true; v = @as(u64, @intCast(0 - n)); } else { v = @as(u64, @intCast(n)); }
    var i : usize = 24;
    if (v == 0) { i = i - 1; b[i] = 48; }
    while (v > 0) {
        i = i - 1;
        b[i] = @as(u8, @intCast(48 + v % 10));
        v = v / 10;
    }
    if (neg) { i = i - 1; b[i] = 45; }
    sys_write(1, label, @as(u64, label.len));
    sys_write(1, b[i..24], @as(u64, 24 - i));
    sys_write(1, "\n", 1);
}

/// The CFStringRef a CF constant holds, read through its dlsym address; 0 when the symbol is absent.
fn cbp_konst(name: []const u8) -> u64 {
    const a : u64 = cbp_dlsym(CBP_RTLD_DEFAULT, name);
    if (a == 0) { return 0; }
    var c : [8]u8 = undefined;
    sys_peek(c[0..8], a, 8);
    return get_u64(c[0..8], 0);
}

/// The 40-byte AudioStreamBasicDescription of 16-bit mono PCM at 48 kHz.
fn cbp_pcm48k(out: []u8) -> void {
    var i : usize = 0;
    while (i < 40) { out[i] = 0; i = i + 1; }
    // mSampleRate 48000.0 as IEEE-754 binary64 = 0x40E7700000000000.
    put_u64(out, 0, 4676829883349860352);
    out[8] = @as(u8, @intCast(CBP_LPCM & 255));
    out[9] = @as(u8, @intCast((CBP_LPCM >> 8) & 255));
    out[10] = @as(u8, @intCast((CBP_LPCM >> 16) & 255));
    out[11] = @as(u8, @intCast((CBP_LPCM >> 24) & 255));
    out[12] = @as(u8, @intCast(CBP_PCM_FLAGS));
    out[16] = 2;
    out[20] = 1;
    out[24] = 2;
    out[28] = 1;
    out[32] = 16;
}

pub fn main() -> void {
    var st : [64]u8 = undefined;
    var z : usize = 0;
    while (z < 64) { st[z] = 0; z = z + 1; }
    const ps : u64 = sys_addr(st[0..64], st[0..64], 0);
    cbp_put(ps + 16, 1511506142);
    cbp_tick(0, ps);
    // Never true (count is 1): only makes sure cbp_out is emitted and so exported.
    if (cbp_get(ps) == 99) { cbp_out(ps, 0, 0); cbp_in(ps, 0, 0, 0, 0, 0); cbp_outd(ps, 0, 0); cbp_ein(ps, 0, 0, 0, 0, 0); cbp_eout(ps, 0, 0); }
    const only_d : bool = sys_getenv("CBP_ONLY_D") != 0;
    const only_c : bool = sys_getenv("CBP_ONLY_C") != 0 or only_d;
    const direct : bool = say("direct call: tick counts 1", cbp_get(ps) == 1);
    cbp_put(ps, 0);
    cbp_put(ps + 24, 0);

    // A. 10 ms timer for 10 s through the dlsym address.
    const ftick : u64 = cbp_dlsym(CBP_RTLD_DEFAULT, "cbp_tick");
    const fout : u64 = cbp_dlsym(CBP_RTLD_DEFAULT, "cbp_out");
    const mode : u64 = cbp_konst("kCFRunLoopDefaultMode");
    say("dlsym finds cbp_tick and cbp_out", ftick != 0 and fout != 0);
    // E. Duplex loop only: CBP_ONLY_E=1 skips A, B, C and D; the exit code is 0 only for a clean loop.
    if (sys_getenv("CBP_ONLY_E") != 0) {
        var efmt : [40]u8 = undefined;
        cbp_pcm48k(efmt[0..40]);
        if (direct and cbp_part_e(mode, efmt[0..40])) { say_line("abi-probe: E duplex loop clean\n"); sys_exit(0); }
        say_line("abi-probe: FAILED\n");
        sys_exit(1);
    }
    var ctx : [40]u8 = undefined;
    var k : usize = 0;
    while (k < 40) { ctx[k] = 0; k = k + 1; }
    put_u64(ctx[0..40], 8, ps);
    var by_timer : bool = false;
    if (!only_c and ftick != 0 and mode != 0) {
        const t0 : u64 = cbp_us();
        const t : u64 = cbp_timer_create(0, cbp_now() + 0.01, 0.01, 0, 0, ftick, ctx[0..40]);
        if (t != 0) {
            cbp_add_timer(cbp_rl_current(), t, mode);
            const r : i32 = cbp_run(mode, 10.0, false);
            say_num("run loop result: ", @as(i64, r));
            cbp_timer_invalidate(t);
            cbp_release(t);
        }
        const n : u64 = cbp_get(ps);
        say_num("A ticks in 10 s: ", @as(i64, @intCast(n)));
        say_num("A info sent (address of state): ", @as(i64, @intCast(ps)));
        say_num("A info received:                ", @as(i64, @intCast(cbp_get(ps + 8))));
        say_num("A magic in state block:         ", @as(i64, @intCast(cbp_get(ps + 16))));
        say_num("A start us:       ", @as(i64, @intCast(t0)));
        say_num("A first tick +us: ", @as(i64, @intCast(cbp_get(ps + 24) - t0)));
        say_num("A last tick  +us: ", @as(i64, @intCast(cbp_get(ps + 32) - t0)));
        by_timer = n >= 900 and n <= 1100 and cbp_get(ps + 8) == ps;
    }
    const a_ok : bool = say("A: about 1000 ticks, info matches", by_timer);

    // B. 440 Hz tone, 4 buffers of 960 bytes, 60 s on this run loop.
    var fmt : [40]u8 = undefined;
    cbp_pcm48k(fmt[0..40]);
    var aqb : [8]u8 = undefined;
    put_u64(aqb[0..8], 0, 0);
    cbp_put(ps, 0);
    cbp_put(ps + 24, 0);
    cbp_put(ps + 40, 0);
    var s1 : i32 = -1;
    if (!only_c and a_ok and fout != 0) { s1 = cbp_aq_new_output(fmt[0..40], fout, ps, cbp_rl_current(), mode, 0, aqb[0..8]); }
    say_num("AudioQueueNewOutput status: ", @as(i64, s1));
    const aq : u64 = get_u64(aqb[0..8], 0);
    var queued : u32 = 0;
    var s2 : i32 = -1;
    var b_calls : u64 = 0;
    var disposed : bool = false;
    if (s1 == 0 and aq != 0) {
        var n : u32 = 0;
        while (n < 4) {
            var bb : [8]u8 = undefined;
            put_u64(bb[0..8], 0, 0);
            if (cbp_aq_alloc(aq, 960, bb[0..8]) == 0) {
                if (cbp_fill(ps, aq, get_u64(bb[0..8], 0)) == 0) { queued = queued + 1; }
            }
            n = n + 1;
        }
        say_num("buffers enqueued: ", @as(i64, @intCast(queued)));
        s2 = cbp_aq_start(aq, 0);
        say_num("AudioQueueStart status: ", @as(i64, s2));
        if (s2 == 0) {
            var sec : u32 = 0;
            while (sec < 6) {
                cbp_run(mode, 10.0, false);
                say_num("B callbacks so far: ", @as(i64, @intCast(cbp_get(ps))));
                sec = sec + 1;
            }
        }
        b_calls = cbp_get(ps);
        say_num("B callbacks in 60 s: ", @as(i64, @intCast(b_calls)));
        say_num("B first +us (from queue start): ", @as(i64, @intCast(cbp_get(ps + 24))));
        say_num("B last us - first us: ", @as(i64, @intCast(cbp_get(ps + 32) - cbp_get(ps + 24))));
        disposed = cbp_aq_dispose(aq, true) == 0;
    }
    const b_ok : bool = say("B: Start=0, 4 buffers, callbacks >= 5900, disposed", s2 == 0 and queued == 4 and b_calls >= 5900 and disposed);

    // C. Capture: input queue, 4 buffers of 960 bytes, 10 s on this run loop.
    var cst : [96]u8 = undefined;
    var q : usize = 0;
    while (q < 96) { cst[q] = 0; q = q + 1; }
    const pc : u64 = sys_addr(cst[0..96], cst[0..96], 0);
    const fin : u64 = cbp_dlsym(CBP_RTLD_DEFAULT, "cbp_in");
    say("dlsym finds cbp_in", fin != 0);
    var aqi : [8]u8 = undefined;
    put_u64(aqi[0..8], 0, 0);
    var s3 : i32 = -1;
    if (!only_d and fin != 0 and mode != 0) { s3 =cbp_aq_new_input(fmt[0..40], fin, pc, cbp_rl_current(), mode, 0, aqi[0..8]); }
    say_num("AudioQueueNewInput status: ", @as(i64, s3));
    const qi : u64 = get_u64(aqi[0..8], 0);
    var c_queued : u32 = 0;
    var s4 : i32 = -1;
    var c_calls : u64 = 0;
    var c_disposed : bool = false;
    if (s3 == 0 and qi != 0) {
        var m : u32 = 0;
        while (m < 4) {
            var cb : [8]u8 = undefined;
            put_u64(cb[0..8], 0, 0);
            if (cbp_aq_alloc(qi, 960, cb[0..8]) == 0) {
                if (cbp_aq_enqueue(qi, get_u64(cb[0..8], 0), 0, 0) == 0) { c_queued = c_queued + 1; }
            }
            m = m + 1;
        }
        say_num("C buffers enqueued: ", @as(i64, @intCast(c_queued)));
        const tc : u64 = cbp_us();
        s4 = cbp_aq_start(qi, 0);
        say_num("C AudioQueueStart status: ", @as(i64, s4));
        if (s4 == 0) {
            var sec : u32 = 0;
            while (sec < 10) {
                cbp_run(mode, 1.0, false);
                say_num("C callbacks so far: ", @as(i64, @intCast(cbp_get(pc))));
                sec = sec + 1;
            }
        }
        c_disposed = cbp_aq_dispose(qi, true) == 0;
        c_calls = cbp_get(pc);
        say_num("C input callbacks in 10 s: ", @as(i64, @intCast(c_calls)));
        if (c_calls > 0) {
            say_num("C first callback +us (from start): ", @as(i64, @intCast(cbp_get(pc + 24) - tc)));
            say_num("C last us - first us: ", @as(i64, @intCast(cbp_get(pc + 32) - cbp_get(pc + 24))));
        }
        say_num("C bytes captured: ", @as(i64, @intCast(cbp_get(pc + 64))));
        say_num("C samples: ", @as(i64, @intCast(cbp_get(pc + 40))));
        say_num("C nonzero samples: ", @as(i64, @intCast(cbp_get(pc + 48))));
        var mean : u64 = 0;
        if (cbp_get(pc + 40) > 0) { mean = cbp_get(pc + 56) / cbp_get(pc + 40); }
        say_num("C mean |sample| (sum/samples): ", @as(i64, @intCast(mean)));
        say_num("C max |sample|: ", @as(i64, @intCast(cbp_get(pc + 80))));
        say_num("C failed re-enqueues: ", @as(i64, @intCast(cbp_get(pc + 72))));
        if (cbp_get(pc + 16) == 1) {
            const w : u64 = cbp_get(pc + 8);
            say_num("C first buffer byte 0: ", @as(i64, @intCast(w & 255)));
            say_num("C first buffer byte 1: ", @as(i64, @intCast((w >> 8) & 255)));
            say_num("C first buffer byte 2: ", @as(i64, @intCast((w >> 16) & 255)));
            say_num("C first buffer byte 3: ", @as(i64, @intCast((w >> 24) & 255)));
        }
        say("C disposed", c_disposed);
    }
    const c_ran : bool = s3 == 0 and s4 == 0 and c_queued == 4 and c_calls > 0 and c_disposed;
    if (only_d) {
        sys_write(1, "C skipped (CBP_ONLY_D)\n", 23);
    } else if (s3 != 0 or s4 != 0) {
        sys_write(1, "CAPTURE REFUSED: a status above is nonzero\n", 43);
    } else if (c_calls == 0) {
        sys_write(1, "CAPTURE UNVERIFIED: queue started, no input callback\n", 53);
    } else if (cbp_get(pc + 48) == 0) {
        sys_write(1, "CAPTURE SILENT: callbacks arrive, every sample is zero (TCC denial or muted input)\n", 83);
    } else {
        sys_write(1, "CAPTURE LIVE: callbacks arrive with nonzero samples\n", 52);
    }

    // D. Output queue with no run loop: the system calls cbp_outd on its own thread while main sleeps 10 s.
    var dst : [96]u8 = undefined;
    var dz : usize = 0;
    while (dz < 96) { dst[dz] = 0; dz = dz + 1; }
    const pd : u64 = sys_addr(dst[0..96], dst[0..96], 0);
    cbp_put(pd + 8, pd);
    cbp_put(pd + 16, CBP_D_MAGIC);
    const main_th : u64 = cbp_thread();
    cbp_put(pd + 56, main_th);
    const fd : u64 = cbp_dlsym(CBP_RTLD_DEFAULT, "cbp_outd");
    say("dlsym finds cbp_outd", fd != 0);
    say("D main thread: pthread_main_np != 0", cbp_is_main() != 0);
    var aqd : [8]u8 = undefined;
    put_u64(aqd[0..8], 0, 0);
    var s5 : i32 = -1;
    if (fd != 0) { s5 = cbp_aq_new_output(fmt[0..40], fd, pd, 0, 0, 0, aqd[0..8]); }
    say_num("D AudioQueueNewOutput status (run loop NULL): ", @as(i64, s5));
    const qd : u64 = get_u64(aqd[0..8], 0);
    var d_queued : u32 = 0;
    var s6 : i32 = -1;
    var d_calls : u64 = 0;
    var d_disposed : bool = false;
    var d_live_fail : u64 = 1;
    if (s5 == 0 and qd != 0) {
        var j : u32 = 0;
        while (j < 4) {
            var db : [8]u8 = undefined;
            put_u64(db[0..8], 0, 0);
            if (cbp_aq_alloc(qd, 960, db[0..8]) == 0) {
                if (cbp_fill(pd, qd, get_u64(db[0..8], 0)) == 0) { d_queued = d_queued + 1; }
            }
            j = j + 1;
        }
        say_num("D buffers enqueued: ", @as(i64, @intCast(d_queued)));
        const td : u64 = cbp_us();
        s6 = cbp_aq_start(qd, 0);
        say_num("D AudioQueueStart status: ", @as(i64, s6));
        if (s6 == 0) {
            var sec : u32 = 0;
            while (sec < 10) {
                cbp_usleep(1000000);
                say_num("D callbacks so far: ", @as(i64, @intCast(cbp_get(pd))));
                sec = sec + 1;
            }
        }
        d_live_fail = cbp_get(pd + 88);
        say_num("D failed enqueues before Dispose: ", @as(i64, @intCast(d_live_fail)));
        d_disposed = cbp_aq_dispose(qd, true) == 0;
        d_calls = cbp_get(pd);
        say_num("D callbacks in 10 s: ", @as(i64, @intCast(d_calls)));
        say_num("D integrity errors (magic or own address): ", @as(i64, @intCast(cbp_get(pd + 48))));
        say("D magic and own address intact after run", cbp_get(pd + 16) == CBP_D_MAGIC and cbp_get(pd + 8) == pd);
        say_num("D failed enqueues in total (buffers handed back by Dispose fail to re-enqueue): ",@as(i64, @intCast(cbp_get(pd + 88))));
        say_num("D calls on the main pthread: ", @as(i64, @intCast(cbp_get(pd + 72))));
        say_num("D calls with pthread_main_np != 0: ", @as(i64, @intCast(cbp_get(pd + 80))));
        if (d_calls > 0) {
            if (cbp_get(pd + 64) == main_th) {
                sys_write(1, "D callback thread: SAME as main\n", 32);
            } else {
                sys_write(1, "D callback thread: OTHER than main\n", 35);
            }
            say_num("D first callback +us (from start): ", @as(i64, @intCast(cbp_get(pd + 24) - td)));
            say_num("D last us - first us: ", @as(i64, @intCast(cbp_get(pd + 32) - cbp_get(pd + 24))));
        }
        say("D disposed", d_disposed);
    }
    const d_ok : bool = s5 == 0 and s6 == 0 and d_queued == 4 and d_calls >= 900 and d_disposed and cbp_get(pd + 48) == 0 and d_live_fail == 0 and cbp_get(pd + 72) == 0 and cbp_get(pd + 80) == 0;
    say("D: foreign-thread callbacks >= 900, no integrity errors, never on main, disposed", d_ok);
    if (only_d) {
        if (direct and d_ok) {
            sys_write(1, "abi-probe: D ran clean on a system thread\n", 42);
            sys_exit(0);
        }
        sys_write(1, "abi-probe: FAILED\n", 18);
        sys_exit(1);
    }
    if (only_c) {
        if (direct and c_ran) {
            sys_write(1, "abi-probe: C ran (see the CAPTURE line for the samples)\n", 56);
            sys_exit(0);
        }
        sys_write(1, "abi-probe: FAILED\n", 18);
        sys_exit(1);
    }
    if (a_ok and b_ok) {
        sys_write(1, "abi-probe: A and B pass (audibility of the tone not checked)\n", 62);
        sys_exit(0);
    }
    sys_write(1, "abi-probe: FAILED\n", 18);
    sys_exit(1);
}

test the_pcm_format_is_48_khz_mono_16_bit {
    var f : [40]u8 = undefined;
    cbp_pcm48k(f[0..40]);
    // 0x40E7700000000000: sign 0, exponent 0x40E (2^15), mantissa 0x77 << 44; 1.46484375 * 32768 = 48000.
    assert get_u64(f[0..40], 0) == 4676829883349860352;
    assert (get_u64(f[0..40], 0) >> 44) == 265847 and (get_u64(f[0..40], 0) & 17592186044415) == 0;
    assert f[8] == 109 and f[9] == 99 and f[10] == 112 and f[11] == 108;
    assert f[12] == 12 and f[16] == 2 and f[20] == 1 and f[24] == 2 and f[28] == 1 and f[32] == 16;
}

test the_duplex_ring_fits_its_block {
    assert cbp_e_size() == 8152;
    assert @as(u64, CBP_E_BYTES) == cbp_e_size();
    // Header slots end at 59 * 8 = 472: tables 32..55, then warming, warm-up buffers, warm-up end.
    assert 384 + CBP_E_SLOTS * 8 + 24 == CBP_E_HDR;
    assert CBP_E_PRE >= 1 and CBP_E_PRE + @as(u64, CBP_E_OUTBUFS) < CBP_E_SLOTS;
    assert CBP_VOL_LO < 1028443341 and 1028443341 < CBP_VOL_HI;
}
