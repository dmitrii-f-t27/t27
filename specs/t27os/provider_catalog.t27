// SPDX-License-Identifier: Apache-2.0
// dmitrii-f-t27/t27#6. Owner: NVIDIA and Z.ai honeycomb cells.
// Verified 2026-10-21 against build.nvidia.com model cards (Free Endpoint)
// and https://docs.z.ai/guides/overview/pricing (three fully free models).
// NVIDIA trial limits apply. Z.ai uses the owner's Coding Plan endpoint only.
// Paid GLM-5.3 and NVIDIA's soon-deprecated GLM-5.3 are deliberately absent.
// The token is persisted in the existing v2 session model field. It is an
// explicit provider pin, never an API model id; only the exact catalog is valid.
module T27osProviderCatalog;
use t27os::session_store::put_bytes;
use t27os::session_store::model_ok;
use t27os::windows::session_space;
use t27os::windows::session_agent;
use t27os::windows::add_session;

pub const PC_COUNT : u32 = 10;
pub const PC_NONE : u32 = 255;
pub const PC_NVIDIA_COUNT : u32 = 7;
pub const PC_ROWS : u32 = 5;

pub fn pc_model(i: u32) -> str {
    if (i == 0) { return "nvidia/nemotron-3.5-super-vl-120b-a12b"; }
    if (i == 1) { return "stepfun-ai/step-5-preview"; }
    if (i == 2) { return "deepseek-ai/deepseek-v4.1-flash"; }
    if (i == 3) { return "z-ai/glm-5.3-flash"; }
    if (i == 4) { return "nvidia/nemotron-3.5-lightning-30b-a3b"; }
    if (i == 5) { return "meta/muse-glimmer-30b"; }
    if (i == 6) { return "poolside/laguna-xs-2.1"; }
    if (i == 7) { return "glm-4.7-flash"; }
    if (i == 8) { return "glm-4.5-flash"; }
    if (i == 9) { return "glm-4.6v-flash"; }
    return "";
}
pub fn pc_label(i: u32) -> str {
    if (i == 0) { return "Nemotron 3.5 Super VL"; }
    if (i == 1) { return "Step 5 Preview"; }
    if (i == 2) { return "DeepSeek V4.1 Flash"; }
    if (i == 3) { return "GLM-5.3-Flash"; }
    if (i == 4) { return "Nemotron 3.5 Lightning"; }
    if (i == 5) { return "Muse Glimmer 30B"; }
    if (i == 6) { return "Laguna XS 2.1"; }
    if (i == 7) { return "GLM-4.7-Flash"; }
    if (i == 8) { return "GLM-4.5-Flash"; }
    if (i == 9) { return "GLM-4.6V-Flash"; }
    return "";
}
pub fn pc_provider(i: u32) -> u32 {
    if (i < PC_NVIDIA_COUNT) { return 9; }
    if (i < PC_COUNT) { return 4; }
    return PC_NONE;
}
pub fn pc_profile(i: u32) -> u32 {
    if (i < PC_NVIDIA_COUNT) { return 4; }
    if (i < PC_COUNT) { return 0; }
    return PC_NONE;
}
pub fn pc_token(i: u32, out: []u8) -> usize {
    if (i >= PC_COUNT or out.len < 64) { return 0; }
    var p : str = "nv:";
    if (i >= PC_NVIDIA_COUNT) { p = "za:"; }
    return put_bytes(out, put_bytes(out, 0, p), pc_model(i));
}
pub fn pc_find(s: []const u8) -> u32 {
    var b : [64]u8 = undefined;
    var i : u32 = 0;
    while (i < PC_COUNT) {
        const n : usize = pc_token(i, b[0..64]);
        if (n == s.len) {
            var same : bool = true;
            var j : usize = 0;
            while (j < n) { if (s[j] != b[j]) { same = false; } j = j + 1; }
            if (same) { return i; }
        }
        i = i + 1;
    }
    return PC_NONE;
}
pub fn pc_reserved(s: []const u8) -> bool {
    return s.len >= 3 and s[2] == 58 and ((s[0] == 110 and s[1] == 118) or (s[0] == 122 and s[1] == 97));
}
pub fn pc_page_count(cell: u32) -> u32 {
    if (cell == 1) { return 2; }
    if (cell == 2) { return 1; }
    return 0;
}
pub fn pc_row(cell: u32, page: u32, row: u32) -> u32 {
    if (row >= PC_ROWS or page >= pc_page_count(cell)) { return PC_NONE; }
    if (cell == 1 and page * PC_ROWS + row < PC_NVIDIA_COUNT) { return page * PC_ROWS + row; }
    if (cell == 2 and row < PC_COUNT - PC_NVIDIA_COUNT) { return PC_NVIDIA_COUNT + row; }
    return PC_NONE;
}
pub fn pc_url(i: u32) -> str {
    if (i < PC_NVIDIA_COUNT) { return "https://integrate.api.nvidia.com/v1/chat/completions"; }
    if (i < PC_COUNT) { return "https://api.z.ai/api/coding/paas/v4/chat/completions"; }
    return "";
}
pub fn pc_body(i: u32, out: []u8) -> usize {
    if (i >= PC_COUNT or out.len < 256) { return 0; }
    var n : usize = put_bytes(out, 0, "{\"model\":\"");
    n = put_bytes(out, n, pc_model(i));
    return put_bytes(out, n, "\",\"messages\":[{\"role\":\"user\",\"content\":\"Say OK\"}],\"max_tokens\":16,\"stream\":false}");
}
// Seven independent bytes correspond to the window's seven compact session slots: 0 none, 1..PC_COUNT a
// catalog row + 1, PC_BOUND a chat bound by api_manage.t27 to an exact key and model (its token lives in the
// window's binding table). pc_get reads only catalog rows; pc_raw / pc_set_raw move any byte unchanged.
pub const PC_BOUND : u32 = 11;
pub fn pc_power(i: u32) -> u64 {
    var p : u64 = 1; var j : u32 = 0;
    while (j < i and j < 7) { p = p * 256; j = j + 1; }
    return p;
}
pub fn pc_get(pins: u64, i: u32) -> u32 {
    if (i >= 7) { return PC_NONE; }
    const n : u32 = @as(u32, @intCast(pins / pc_power(i) % 256));
    if (n == 0 or n > PC_COUNT) { return PC_NONE; }
    return n - 1;
}
pub fn pc_set(pins: u64, i: u32, choice: u32) -> u64 {
    if (i >= 7) { return pins; }
    var n : u64 = 0;
    if (choice < PC_COUNT) { n = @as(u64, choice) + 1; }
    const p : u64 = pc_power(i);
    return pins - (pins / p % 256) * p + n * p;
}
pub fn pc_raw(pins: u64, i: u32) -> u32 {
    if (i >= 7) { return 0; }
    return @as(u32, @intCast(pins / pc_power(i) % 256));
}
pub fn pc_set_raw(pins: u64, i: u32, v: u32) -> u64 {
    if (i >= 7 or v > 255) { return pins; }
    const p : u64 = pc_power(i);
    return pins - (pins / p % 256) * p + @as(u64, v) * p;
}
pub fn pc_drop(pins: u64, i: u32) -> u64 {
    if (i >= 7) { return pins; }
    return pins % pc_power(i) + pins / pc_power(i + 1) * pc_power(i);
}
pub fn pc_drop_space(pins: u64, ss: u64, space: u32) -> u64 {
    var out : u64 = 0; var at : u32 = 0; var i : u32 = 0;
    while (i < 7) {
        if (session_space(ss, i) != space) { out = pc_set_raw(out, at, pc_raw(pins, i)); at = at + 1; }
        i = i + 1;
    }
    return out;
}
pub fn pc_ordinal(pins: u64, ss: u64, cur: u32) -> u32 {
    var i : u32 = 0; var n : u32 = 0;
    while (i < cur and i < 7) {
        if (session_agent(ss, i) == session_agent(ss, cur) and pc_raw(pins, i) == 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
test mixed_session_pins_compact_and_round_trip {
    var p : u64 = pc_set(0, 1, 0);
    p = pc_set(p, 3, 7);
    assert pc_get(p, 0) == PC_NONE and pc_get(p, 1) == 0;
    p = pc_drop(p, 1);
    assert pc_get(p, 1) == PC_NONE and pc_get(p, 2) == 7;
    assert pc_get(p, 7) == PC_NONE;
}
test bound_session_bytes_survive_every_compaction {
    var p : u64 = pc_set_raw(0, 0, PC_BOUND);
    p = pc_set(p, 1, 3);
    p = pc_set_raw(p, 2, PC_BOUND);
    assert pc_get(p, 0) == PC_NONE and pc_raw(p, 0) == PC_BOUND and pc_get(p, 1) == 3;
    const q : u64 = pc_drop(p, 1);
    assert pc_raw(q, 0) == PC_BOUND and pc_raw(q, 1) == PC_BOUND and pc_raw(q, 2) == 0;
    // three OpenCode chats in spaces 0, 1, 0: closing space 1 keeps both bound bytes in order
    const ss : u64 = add_session(add_session(add_session(0, 3, 0), 3, 1), 3, 0);
    const r : u64 = pc_drop_space(pc_set_raw(pc_set_raw(0, 0, PC_BOUND), 2, PC_BOUND), ss, 1);
    assert pc_raw(r, 0) == PC_BOUND and pc_raw(r, 1) == PC_BOUND and pc_raw(r, 2) == 0;
    // a bound chat is not an unpinned one: it does not take an unpinned chat's LIST ordinal
    assert pc_ordinal(pc_set_raw(0, 0, PC_BOUND), ss, 2) == 1;
    assert pc_ordinal(0, ss, 2) == 2;
    assert pc_set_raw(p, 7, 1) == p and pc_set_raw(p, 0, 256) == p;
}
test all_catalog_tokens_round_trip_without_changing_agent_or_shell_ids {
    var b : [256]u8 = undefined;
    var i : u32 = 0;
    while (i < PC_COUNT) {
        const n : usize = pc_token(i, b[0..64]);
        assert n <= 60 and model_ok(b[0..n]);
        assert pc_find(b[0..n]) == i;
        assert pc_body(i, b[0..256]) > 0;
        assert pc_url(i).len > 0;
        i = i + 1;
    }
    assert pc_find("glm-4.7-flash") == PC_NONE;
    assert pc_find("nv:glm-4.7-flash") == PC_NONE;
    assert pc_find("za:glm-5.3") == PC_NONE;
    assert pc_reserved("za:glm-5.3") and pc_reserved("nv:unknown");
    assert pc_reserved("glm-4.7-flash") == false;
    assert pc_provider(0) == 9 and pc_profile(0) == 4;
    assert pc_provider(7) == 4 and pc_profile(7) == 0;
    assert pc_row(1, 1, 1) == 6;
    assert pc_row(1, 1, 2) == PC_NONE;
    assert pc_row(2, 0, 2) == 9;
    assert pc_row(2, 1, 0) == PC_NONE;
}
