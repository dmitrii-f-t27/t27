// SPDX-License-Identifier: Apache-2.0
// dmitrii-f-t27/t27#6. Owner: NVIDIA and Z.ai honeycomb cells.
// Verified 2026-10-21 against build.nvidia.com model cards (Free Endpoint)
// and https://docs.z.ai/guides/overview/pricing (three fully free models).
// NVIDIA trial limits apply. Z.ai uses the owner's Coding Plan endpoint only.
// Ordinary GLM-5.3 on NVIDIA (owner request 2026-10-22): https://build.nvidia.com/z-ai/glm-5-3/build, read
// 2026-10-22, marks a Free Endpoint with the API model id z-ai/glm-5.3 (the URL has hyphens, the id a decimal
// point), deprecated on 2026-10-27 and unsupported after 2026-10-28. It is row PC_GLM53, its own choice beside
// GLM-5.3-Flash (z-ai/glm-5.3-flash), and carries that date note (pc_note). Paid Z.ai GLM-5.3 stays absent.
// The token is persisted in the existing v2 session model field. It is an
// explicit provider pin, never an API model id; only the exact catalog is valid.
module T27osProviderCatalog;
use t27os::session_store::put_bytes;
use t27os::session_store::model_ok;
use t27os::windows::session_space;
use t27os::windows::session_agent;
use t27os::windows::add_session;

/// Rows 0 .. PC_NVIDIA_COUNT - 1 are NVIDIA's, the rest Z.ai's: each provider's rows are contiguous (api_manage
/// reads them as a range). A row index is a runtime index only; what persists is the token text (pc_token) and,
/// in the window's session pins, the byte of pc_byte, which never changes meaning.
pub const PC_COUNT : u32 = 11;
pub const PC_NONE : u32 = 255;
pub const PC_NVIDIA_COUNT : u32 = 8;
pub const PC_ROWS : u32 = 5;
/// Ordinary GLM-5.3 on NVIDIA: the last NVIDIA row.
pub const PC_GLM53 : u32 = 7;

pub fn pc_model(i: u32) -> str {
    if (i == 0) { return "nvidia/nemotron-3.5-super-vl-120b-a12b"; }
    if (i == 1) { return "stepfun-ai/step-5-preview"; }
    if (i == 2) { return "deepseek-ai/deepseek-v4.1-flash"; }
    if (i == 3) { return "z-ai/glm-5.3-flash"; }
    if (i == 4) { return "nvidia/nemotron-3.5-lightning-30b-a3b"; }
    if (i == 5) { return "meta/muse-glimmer-30b"; }
    if (i == 6) { return "poolside/laguna-xs-2.1"; }
    if (i == 7) { return "z-ai/glm-5.3"; }
    if (i == 8) { return "glm-4.7-flash"; }
    if (i == 9) { return "glm-4.5-flash"; }
    if (i == 10) { return "glm-4.6v-flash"; }
    return "";
}
pub fn pc_label(i: u32) -> str {
    if (i == 0) { return "Nemotron 3.5 Super VL"; }
    if (i == 1) { return "Step 5 Preview"; }
    if (i == 2) { return "DeepSeek V4.1 Flash"; }
    if (i == 3) { return "GLM-5.3-Flash"; }
    if (i == 4) { return "Nemotron 3.5 Lightning"; }
    if (i == 5) { return "Muse Glimmer 30B"; }
    if (i == 6) { return "Laguna XS 2.1"; }
    if (i == 7) { return "GLM-5.3"; }
    if (i == 8) { return "GLM-4.7-Flash"; }
    if (i == 9) { return "GLM-4.5-Flash"; }
    if (i == 10) { return "GLM-4.6V-Flash"; }
    return "";
}
/// The dated warning a row carries, shown when it is chosen and while it is selected; "" for the rows without one.
/// pc_note_short is the part that must stay visible where the full note does not fit: beside the exact id in the
/// model picker's narrow row, where the longer "no support after ..." form cut the day off (live QA 2026-10-22),
/// so it is the end date alone and stays whole.
pub fn pc_note(i: u32) -> str {
    if (i == PC_GLM53) { return "Deprecated 2026-10-27, no support after 2026-10-28."; }
    return "";
}
pub fn pc_note_short(i: u32) -> str {
    if (i == PC_GLM53) { return "ends 2026-10-28"; }
    return "";
}
pub fn pc_provider(i: u32) -> u32 {
    if (i < PC_NVIDIA_COUNT) { return 9; }
    if (i < PC_COUNT) { return 4; }
    return PC_NONE;
}
pub fn pc_profile(i: u32) -> u32 {
    if (i < PC_NVIDIA_COUNT) { return 4; }
    if (i < PC_COUNT) { return 0; }
    return PC_NONE;
}
pub fn pc_token(i: u32, out: []u8) -> usize {
    if (i >= PC_COUNT or out.len < 64) { return 0; }
    var p : str = "nv:";
    if (i >= PC_NVIDIA_COUNT) { p = "za:"; }
    return put_bytes(out, put_bytes(out, 0, p), pc_model(i));
}
pub fn pc_find(s: []const u8) -> u32 {
    var b : [64]u8 = undefined;
    var i : u32 = 0;
    while (i < PC_COUNT) {
        const n : usize = pc_token(i, b[0..64]);
        if (n == s.len) {
            var same : bool = true;
            var j : usize = 0;
            while (j < n) { if (s[j] != b[j]) { same = false; } j = j + 1; }
            if (same) { return i; }
        }
        i = i + 1;
    }
    return PC_NONE;
}
pub fn pc_reserved(s: []const u8) -> bool {
    return s.len >= 3 and s[2] == 58 and ((s[0] == 110 and s[1] == 118) or (s[0] == 122 and s[1] == 97));
}
pub fn pc_page_count(cell: u32) -> u32 {
    if (cell == 1) { return 2; }
    if (cell == 2) { return 1; }
    return 0;
}
pub fn pc_row(cell: u32, page: u32, row: u32) -> u32 {
    if (row >= PC_ROWS or page >= pc_page_count(cell)) { return PC_NONE; }
    if (cell == 1 and page * PC_ROWS + row < PC_NVIDIA_COUNT) { return page * PC_ROWS + row; }
    if (cell == 2 and row < PC_COUNT - PC_NVIDIA_COUNT) { return PC_NVIDIA_COUNT + row; }
    return PC_NONE;
}
pub fn pc_url(i: u32) -> str {
    if (i < PC_NVIDIA_COUNT) { return "https://integrate.api.nvidia.com/v1/chat/completions"; }
    if (i < PC_COUNT) { return "https://api.z.ai/api/coding/paas/v4/chat/completions"; }
    return "";
}
pub fn pc_body(i: u32, out: []u8) -> usize {
    if (i >= PC_COUNT or out.len < 256) { return 0; }
    var n : usize = put_bytes(out, 0, "{\"model\":\"");
    n = put_bytes(out, n, pc_model(i));
    return put_bytes(out, n, "\",\"messages\":[{\"role\":\"user\",\"content\":\"Say OK\"}],\"max_tokens\":16,\"stream\":false}");
}
// Seven independent bytes correspond to the window's seven compact session slots: 0 none, a catalog row's byte
// (pc_byte), or PC_BOUND, a chat bound by api_manage.t27 to an exact key and model (its token lives in the
// window's binding table). The window persists these bytes raw (NSUserDefaults t27os.provider-pins1), so a byte
// keeps its meaning forever: bytes 1..10 are the ten rows that existed before ordinary GLM-5.3 (1..7 the first
// seven NVIDIA models, 8..10 the three Z.ai ones), 11 is PC_BOUND, and GLM-5.3 takes the first free byte, 12.
// pc_get reads only catalog bytes; pc_raw / pc_set_raw move any byte unchanged.
pub const PC_BOUND : u32 = 11;
pub const PC_GLM53_BYTE : u32 = 12;
/// The persisted byte of catalog row `row`; 0 for no row.
pub fn pc_byte(row: u32) -> u32 {
    if (row < PC_GLM53) { return row + 1; }
    if (row == PC_GLM53) { return PC_GLM53_BYTE; }
    if (row < PC_COUNT) { return row; }
    return 0;
}
/// The catalog row a persisted byte names; PC_NONE for 0, PC_BOUND and any byte no row uses.
pub fn pc_row_of(byte: u32) -> u32 {
    if (byte >= 1 and byte <= PC_GLM53) { return byte - 1; }
    if (byte == PC_GLM53_BYTE) { return PC_GLM53; }
    if (byte > PC_GLM53 and byte < PC_COUNT) { return byte; }
    return PC_NONE;
}
pub fn pc_power(i: u32) -> u64 {
    var p : u64 = 1; var j : u32 = 0;
    while (j < i and j < 7) { p = p * 256; j = j + 1; }
    return p;
}
pub fn pc_get(pins: u64, i: u32) -> u32 {
    if (i >= 7) { return PC_NONE; }
    return pc_row_of(@as(u32, @intCast(pins / pc_power(i) % 256)));
}
pub fn pc_set(pins: u64, i: u32, choice: u32) -> u64 {
    if (i >= 7) { return pins; }
    const n : u64 = @as(u64, pc_byte(choice));
    const p : u64 = pc_power(i);
    return pins - (pins / p % 256) * p + n * p;
}
pub fn pc_raw(pins: u64, i: u32) -> u32 {
    if (i >= 7) { return 0; }
    return @as(u32, @intCast(pins / pc_power(i) % 256));
}
pub fn pc_set_raw(pins: u64, i: u32, v: u32) -> u64 {
    if (i >= 7 or v > 255) { return pins; }
    const p : u64 = pc_power(i);
    return pins - (pins / p % 256) * p + @as(u64, v) * p;
}
pub fn pc_drop(pins: u64, i: u32) -> u64 {
    if (i >= 7) { return pins; }
    return pins % pc_power(i) + pins / pc_power(i + 1) * pc_power(i);
}
pub fn pc_drop_space(pins: u64, ss: u64, space: u32) -> u64 {
    var out : u64 = 0; var at : u32 = 0; var i : u32 = 0;
    while (i < 7) {
        if (session_space(ss, i) != space) { out = pc_set_raw(out, at, pc_raw(pins, i)); at = at + 1; }
        i = i + 1;
    }
    return out;
}
pub fn pc_ordinal(pins: u64, ss: u64, cur: u32) -> u32 {
    var i : u32 = 0; var n : u32 = 0;
    while (i < cur and i < 7) {
        if (session_agent(ss, i) == session_agent(ss, cur) and pc_raw(pins, i) == 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
test mixed_session_pins_compact_and_round_trip {
    var p : u64 = pc_set(0, 1, 0);
    p = pc_set(p, 3, 7);
    assert pc_get(p, 0) == PC_NONE and pc_get(p, 1) == 0;
    p = pc_drop(p, 1);
    assert pc_get(p, 1) == PC_NONE and pc_get(p, 2) == 7;
    assert pc_get(p, 7) == PC_NONE;
}
test bound_session_bytes_survive_every_compaction {
    var p : u64 = pc_set_raw(0, 0, PC_BOUND);
    p = pc_set(p, 1, 3);
    p = pc_set_raw(p, 2, PC_BOUND);
    assert pc_get(p, 0) == PC_NONE and pc_raw(p, 0) == PC_BOUND and pc_get(p, 1) == 3;
    const q : u64 = pc_drop(p, 1);
    assert pc_raw(q, 0) == PC_BOUND and pc_raw(q, 1) == PC_BOUND and pc_raw(q, 2) == 0;
    // three OpenCode chats in spaces 0, 1, 0: closing space 1 keeps both bound bytes in order
    const ss : u64 = add_session(add_session(add_session(0, 3, 0), 3, 1), 3, 0);
    const r : u64 = pc_drop_space(pc_set_raw(pc_set_raw(0, 0, PC_BOUND), 2, PC_BOUND), ss, 1);
    assert pc_raw(r, 0) == PC_BOUND and pc_raw(r, 1) == PC_BOUND and pc_raw(r, 2) == 0;
    // a bound chat is not an unpinned one: it does not take an unpinned chat's LIST ordinal
    assert pc_ordinal(pc_set_raw(0, 0, PC_BOUND), ss, 2) == 1;
    assert pc_ordinal(0, ss, 2) == 2;
    assert pc_set_raw(p, 7, 1) == p and pc_set_raw(p, 0, 256) == p;
}
test all_catalog_tokens_round_trip_without_changing_agent_or_shell_ids {
    var b : [256]u8 = undefined;
    var i : u32 = 0;
    while (i < PC_COUNT) {
        const n : usize = pc_token(i, b[0..64]);
        assert n <= 60 and model_ok(b[0..n]);
        assert pc_find(b[0..n]) == i;
        assert pc_body(i, b[0..256]) > 0;
        assert pc_url(i).len > 0;
        i = i + 1;
    }
    assert pc_find("glm-4.7-flash") == PC_NONE;
    assert pc_find("nv:glm-4.7-flash") == PC_NONE;
    assert pc_find("za:glm-5.3") == PC_NONE;
    assert pc_reserved("za:glm-5.3") and pc_reserved("nv:unknown");
    assert pc_reserved("glm-4.7-flash") == false;
    assert pc_provider(0) == 9 and pc_profile(0) == 4;
    assert pc_provider(PC_GLM53) == 9 and pc_profile(PC_GLM53) == 4;
    assert pc_provider(PC_NVIDIA_COUNT) == 4 and pc_profile(PC_NVIDIA_COUNT) == 0;
    assert pc_row(1, 1, 1) == 6;
    assert pc_row(1, 1, 2) == PC_GLM53;
    assert pc_row(1, 1, 3) == PC_NONE;
    assert pc_row(2, 0, 2) == 10;
    assert pc_row(2, 1, 0) == PC_NONE;
}
test ordinary_glm_5_3_is_its_own_nvidia_row_beside_flash {
    // the exact API ids differ only by the suffix; neither token stands in for the other
    assert pc_t_same(pc_model(PC_GLM53), "z-ai/glm-5.3") and pc_t_same(pc_model(3), "z-ai/glm-5.3-flash");
    assert pc_t_same(pc_label(PC_GLM53), "GLM-5.3") and pc_t_same(pc_label(3), "GLM-5.3-Flash");
    assert pc_find("nv:z-ai/glm-5.3") == PC_GLM53 and pc_find("nv:z-ai/glm-5.3-flash") == 3;
    assert pc_find("nv:z-ai/glm-5-3") == PC_NONE and pc_find("za:z-ai/glm-5.3") == PC_NONE;
    // NVIDIA's row, NVIDIA's route, the NVIDIA profile; the provider ranges stay contiguous
    assert pc_t_same(pc_url(PC_GLM53), "https://integrate.api.nvidia.com/v1/chat/completions");
    var r : u32 = 0;
    while (r < PC_COUNT) {
        if (r < PC_NVIDIA_COUNT) { assert pc_provider(r) == 9; } else { assert pc_provider(r) == 4; }
        r = r + 1;
    }
    assert PC_GLM53 == PC_NVIDIA_COUNT - 1;
    // only GLM-5.3 carries the dated warning, short enough for its row and its detail line
    assert pc_note(PC_GLM53).len > 0 and pc_note(PC_GLM53).len <= 52;
    // the short form is the end date whole, short enough to sit beside the exact id in a picker row
    const pcn_short : str = pc_note_short(PC_GLM53);
    assert pcn_short.len > 10 and pcn_short.len <= 16;
    assert pc_t_same(pcn_short[pcn_short.len - 10 .. pcn_short.len], "2026-10-28");
    // the full warning keeps both dates, unchanged
    const pcn_full : str = pc_note(PC_GLM53);
    assert pc_t_same(pcn_full[11 .. 21], "2026-10-27") and pc_t_same(pcn_full[pcn_full.len - 11 .. pcn_full.len - 1], "2026-10-28");
    r = 0;
    while (r < PC_COUNT) {
        if (r != PC_GLM53) { assert pc_note(r).len == 0 and pc_note_short(r).len == 0; }
        r = r + 1;
    }
}
test a_persisted_pin_byte_keeps_its_meaning_after_glm_5_3_is_added {
    // the bytes written before this change (row + 1 over the old ten rows) still name the same models
    assert pc_t_same(pc_model(pc_row_of(1)), "nvidia/nemotron-3.5-super-vl-120b-a12b");
    assert pc_t_same(pc_model(pc_row_of(4)), "z-ai/glm-5.3-flash");
    assert pc_t_same(pc_model(pc_row_of(7)), "poolside/laguna-xs-2.1");
    assert pc_t_same(pc_model(pc_row_of(8)), "glm-4.7-flash");
    assert pc_t_same(pc_model(pc_row_of(9)), "glm-4.5-flash");
    assert pc_t_same(pc_model(pc_row_of(10)), "glm-4.6v-flash");
    // an old Z.ai pin stays Z.ai, the bound byte never reads as a catalog row, GLM-5.3 has a byte of its own
    assert pc_provider(pc_row_of(8)) == 4 and pc_provider(pc_row_of(10)) == 4;
    assert pc_row_of(PC_BOUND) == PC_NONE and pc_row_of(0) == PC_NONE and pc_row_of(13) == PC_NONE;
    assert pc_row_of(PC_GLM53_BYTE) == PC_GLM53 and pc_byte(PC_GLM53) == PC_GLM53_BYTE;
    // every row round-trips through its byte, no two rows share one, none is 0 or PC_BOUND
    var r : u32 = 0;
    while (r < PC_COUNT) {
        assert pc_row_of(pc_byte(r)) == r;
        assert pc_byte(r) != 0 and pc_byte(r) != PC_BOUND;
        var q : u32 = r + 1;
        while (q < PC_COUNT) {
            assert pc_byte(q) != pc_byte(r);
            q = q + 1;
        }
        r = r + 1;
    }
    assert pc_byte(PC_COUNT) == 0;
    // a restored pins word: an old Z.ai pin, a bound chat, a GLM-5.3 pin and an old NVIDIA pin, compacted
    var p : u64 = pc_set_raw(0, 0, 8);
    p = pc_set_raw(p, 1, PC_BOUND);
    p = pc_set(p, 2, PC_GLM53);
    p = pc_set_raw(p, 3, 4);
    assert pc_raw(p, 2) == PC_GLM53_BYTE;
    assert pc_t_same(pc_model(pc_get(p, 0)), "glm-4.7-flash");
    assert pc_get(p, 1) == PC_NONE and pc_raw(p, 1) == PC_BOUND;
    assert pc_get(p, 2) == PC_GLM53;
    assert pc_t_same(pc_model(pc_get(p, 3)), "z-ai/glm-5.3-flash");
    const q2 : u64 = pc_drop(p, 0);
    assert pc_raw(q2, 0) == PC_BOUND and pc_get(q2, 1) == PC_GLM53 and pc_get(q2, 2) == 3;
    const ss : u64 = add_session(add_session(add_session(add_session(0, 3, 0), 3, 1), 3, 0), 3, 1);
    const d : u64 = pc_drop_space(p, ss, 1);
    assert pc_get(d, 0) == 8 and pc_get(d, 1) == PC_GLM53 and pc_raw(d, 2) == 0;
}
fn pc_t_same(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}
